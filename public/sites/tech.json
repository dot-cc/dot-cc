"\u003c!doctype html\u003e\n\u003chtml lang=\"en\" dir=\"ltr\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"utf-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"\u003e\n\u003ctitle\u003edot. tech studio | AI, business systems and data in Saudi Arabia\u003c/title\u003e\n\u003cmeta name=\"description\" content=\"dot. tech studio puts AI to work, builds business systems, moves and fixes data, and rescues stalled projects for companies in Saudi Arabia.\"\u003e\n\u003cstyle\u003e\n@font-face{font-family:\"Utility Sans\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:300;font-style:normal;font-display:swap}\n@font-face{font-family:\"Utility Sans\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:400;font-style:normal;font-display:swap}\n@font-face{font-family:\"Utility Sans\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:600;font-style:normal;font-display:swap}\n@font-face{font-family:\"Utility Sans\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:700;font-style:normal;font-display:swap}\n@font-face{font-family:\"Janna LT\";src:url(data:font/woff2;base64,) format(\"woff2\");font-weight:400;font-style:normal;font-display:swap}\n:root{\n  --mint:#00F4C9; --on-mint:#121D21;\n  --bg:#EEF3F1; --bg-2:#E1EAE7; --surface:#FFFFFF; --text:#121D21; --muted:#4B5F5B;\n  --line:rgba(18,29,33,.14); --line-strong:rgba(18,29,33,.28);\n  --accent-text:#00735F; --glow-a:rgba(0,244,201,.34); --glow-b:rgba(24,60,60,.14);\n  --nav-bg:rgba(238,243,241,.86); --error:#B3261E;\n  --font:\"Utility Sans\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n  --pad:clamp(20px,5vw,72px);\n  color-scheme:light;\n  box-sizing:border-box;\n  padding-top:env(safe-area-inset-top,0px);\n  padding-bottom:env(safe-area-inset-bottom,0px);\n}\nhtml[lang=\"ar\"]{--font:\"Utility Sans\",\"Janna LT\",Tahoma,\"Segoe UI\",sans-serif}\n@media (prefers-color-scheme:dark){\n  :root:not([data-theme=\"light\"]){\n    --bg:#121D21; --bg-2:#0F2A29; --surface:#162629; --text:#E4F1EE; --muted:#94ACA7;\n    --line:rgba(228,241,238,.12); --line-strong:rgba(228,241,238,.26);\n    --accent-text:#00F4C9; --glow-a:rgba(0,244,201,.22); --glow-b:rgba(38,108,98,.42);\n    --nav-bg:rgba(18,29,33,.84); --error:#FF8F80;\n    color-scheme:dark;\n  }\n}\n:root[data-theme=\"dark\"]{\n  --bg:#121D21; --bg-2:#0F2A29; --surface:#162629; --text:#E4F1EE; --muted:#94ACA7;\n  --line:rgba(228,241,238,.12); --line-strong:rgba(228,241,238,.26);\n  --accent-text:#00F4C9; --glow-a:rgba(0,244,201,.22); --glow-b:rgba(38,108,98,.42);\n  --nav-bg:rgba(18,29,33,.84); --error:#FF8F80;\n  color-scheme:dark;\n}\n*,*::before,*::after{box-sizing:inherit}\nhtml{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 84px);-webkit-text-size-adjust:100%}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-weight:300;font-size:17px;line-height:1.6;overflow-x:hidden}\nhtml[lang=\"ar\"] body{line-height:1.85;font-size:17.5px}\nimg,svg{max-width:100%}\na{color:var(--accent-text);text-underline-offset:.2em}\n:focus-visible{outline:2px solid var(--mint);outline-offset:3px;border-radius:4px}\n.skip{position:absolute;inset-inline-start:-999px;top:0;background:var(--mint);color:var(--on-mint);padding:.6em 1em;z-index:60}\n.skip:focus{inset-inline-start:12px;top:calc(env(safe-area-inset-top,0px) + 12px)}\n.display{font-weight:700;letter-spacing:-.025em;line-height:.98;text-wrap:balance}\nhtml[lang=\"ar\"] .display{letter-spacing:0;line-height:1.3}\nh2.display{font-size:clamp(2.1rem,5vw,3.8rem);margin:0 0 .45em;max-width:16ch}\nh3{font-weight:600;line-height:1.25;margin:0 0 .35em;font-size:1.2rem}\nhtml[lang=\"ar\"] h3{font-weight:700;line-height:1.5}\np{margin:0 0 1em;max-width:62ch}\n.lead{font-size:1.2rem;line-height:1.55;text-wrap:pretty}\nhtml[lang=\"ar\"] .lead{line-height:1.8}\n.muted{color:var(--muted)}\n.container{max-width:1240px;margin:0 auto;padding:0 var(--pad)}\nsection{padding:clamp(80px,11vw,140px) 0}\n.code-tag{direction:ltr;unicode-bidi:isolate}\n\n.btn{display:inline-flex;align-items:center;gap:.6em;font:inherit;font-weight:600;font-size:1rem;text-decoration:none;border-radius:999px;padding:.8em 1.4em;border:1.5px solid transparent;cursor:pointer;transition:background .2s,border-color .2s,color .2s}\n.btn-primary{background:var(--mint);color:var(--on-mint)}\n.btn-primary:hover{background:color-mix(in srgb,var(--mint) 86%,#fff)}\n.btn-ghost{border-color:var(--line-strong);color:var(--text);background:transparent}\n.btn-ghost:hover{border-color:var(--mint)}\n\n/* nav */\n.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:var(--nav-bg);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}\n.nav .container{display:flex;align-items:center;gap:24px;height:72px}\n.brand{display:flex;align-items:center;gap:10px;color:var(--text);text-decoration:none;flex:none;direction:ltr}\n.brand .m{width:40px;height:40px}\n.brand .w{width:118px;height:14px}\n.links{display:flex;gap:26px;margin:0;margin-inline-start:auto;list-style:none;padding:0}\n.links a{color:var(--muted);text-decoration:none;font-size:.96rem}\n.links a:hover,.links a[aria-current=\"true\"]{color:var(--text)}\n.nav .btn{padding:.6em 1.15em;font-size:.93rem}\n.langbtn{font:400 .93rem/1 \"Utility Sans\",\"Janna LT\",sans-serif;color:var(--text);background:transparent;border:1.5px solid var(--line-strong);border-radius:999px;padding:.55em 1em;cursor:pointer;flex:none}\n.langbtn:hover{border-color:var(--mint)}\n.menu-btn{display:none;background:none;border:1.5px solid var(--line-strong);border-radius:999px;color:var(--text);font:inherit;font-size:.9rem;padding:.45em 1em;cursor:pointer}\n\n/* hero */\n.news{display:inline-flex;align-items:center;gap:10px;margin-bottom:22px;padding:8px 14px 8px 10px;border:1px solid rgba(0,244,203,.45);border-radius:999px;color:inherit;text-decoration:none;font-size:14px;font-weight:600;background:rgba(0,244,203,.08);transition:background .2s,border-color .2s}.news:hover{background:rgba(0,244,203,.16);border-color:#00F4CB}.news i{width:8px;height:8px;border-radius:50%;background:#00F4CB;box-shadow:0 0 10px #00F4CB}.news b{color:#00F4CB}[dir=rtl] .news b{transform:scaleX(-1)}\n.hero{position:relative;overflow:hidden;isolation:isolate;padding:clamp(56px,8vw,112px) 0 clamp(72px,9vw,120px)}\n.hero::before{content:\"\";position:absolute;inset-inline-end:-12%;top:-8%;width:min(1100px,90vw);aspect-ratio:1;background:radial-gradient(closest-side,var(--glow-a),transparent 70%);z-index:-1}\n.hero::after{content:\"\";position:absolute;inset-inline-start:-20%;bottom:-40%;width:900px;aspect-ratio:1;background:radial-gradient(closest-side,var(--glow-b),transparent 70%);z-index:-1}\n.hero .container{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(32px,5vw,72px);align-items:center}\n.hero h1{font-size:clamp(2.5rem,5.6vw,4.9rem);margin:0 0 .4em;max-width:14ch}\nhtml[lang=\"ar\"] .hero h1{font-size:clamp(2.3rem,5vw,4.3rem)}\n.hero .lead{max-width:46ch}\n.hero .ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}\n.orb{position:relative;width:100%;max-width:520px;aspect-ratio:1;margin-inline-start:auto}\n.orb .ring{position:absolute;inset:0;width:100%;height:100%;overflow:visible}\n.orb .ring text{direction:ltr;font-family:\"Utility Sans\",\"Janna LT\",sans-serif;font-weight:600;font-size:24px;letter-spacing:.02em;fill:var(--text)}\nhtml[lang=\"ar\"] .orb .ring text{letter-spacing:0;font-size:25px}\n.orb .ring .sep{fill:var(--mint)}\n.orb .mark{position:absolute;inset:16%;width:68%;height:68%}\n@media (prefers-reduced-motion:no-preference){\n  .orb .ring{animation:spin 70s linear infinite}\n  .orb:hover .ring{animation-play-state:paused}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  .orb .mark{animation:pop 1.1s cubic-bezier(.2,.8,.2,1) both}\n  @keyframes pop{from{transform:scale(.8);opacity:0}to{transform:none;opacity:1}}\n}\n\n/* regulators strip */\n.strip{padding:44px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.strip p{margin:0 0 18px;font-size:.92rem;color:var(--muted);text-align:center}\n\n/* services */\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:36px 0 0;padding:0;border-bottom:1px solid var(--line)}\n.tab{font:inherit;font-size:.96rem;font-weight:400;background:none;border:0;border-bottom:2.5px solid transparent;color:var(--muted);padding:12px 4px 14px;margin-inline-end:22px;cursor:pointer;display:flex;align-items:center;gap:10px}\n.tab .l{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--line-strong);font:700 .8rem/1 \"Utility Sans\",sans-serif}\n.tab[aria-selected=\"true\"]{color:var(--text);border-bottom-color:var(--mint)}\n.tab[aria-selected=\"true\"] .l{background:var(--mint);border-color:var(--mint);color:var(--on-mint)}\n.panel{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(28px,5vw,72px);padding-top:44px}\n.panel[hidden]{display:none}\n.panel .big{width:clamp(120px,16vw,200px);aspect-ratio:1;border-radius:50%;background:var(--mint);color:var(--on-mint);display:grid;place-items:center;font:700 clamp(3rem,7vw,5.2rem)/1 \"Utility Sans\",sans-serif;margin-bottom:28px}\n.panel h3.fam{font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:700}\n.svc-list{list-style:none;padding:0;margin:0}\n.svc-list li{padding:22px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:44px minmax(0,1fr);gap:14px}\n.svc-list li:last-child{border-bottom:1px solid var(--line)}\n.svc-list .code{font-weight:600;color:var(--accent-text);padding-top:2px}\n.svc-list h4{font-weight:600;font-size:1.1rem;margin:0 0 4px}\n.svc-list p{margin:0;font-size:.97rem;color:var(--muted)}\n.svc-list p.rcv{margin-top:8px;color:var(--text);font-size:.93rem}\n.svc-list p.rcv::before{content:\"\";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--mint);margin-inline-end:8px;vertical-align:1px}\n\n/* fit */\n.fit{background:var(--bg-2)}\n.fit-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(28px,5vw,64px);align-items:start;margin-top:32px}\n.chips{display:flex;flex-wrap:wrap;gap:10px}\n.chip{font:inherit;font-size:.96rem;font-weight:400;color:var(--text);background:var(--bg);border:1.5px solid var(--line-strong);border-radius:999px;padding:.55em 1.05em;cursor:pointer;text-align:start;transition:background .15s,border-color .15s,color .15s}\n.chip:hover{border-color:var(--mint)}\n.chip[aria-pressed=\"true\"]{background:var(--mint);border-color:var(--mint);color:var(--on-mint)}\n.card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:30px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 96px)}\n.card .empty{margin:0;color:var(--muted)}\n.card .dots{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 20px}\n.card .dots span{width:14px;height:14px;border-radius:50%;border:1.5px solid var(--line-strong)}\n.card .dots span.on{background:color-mix(in srgb,var(--mint) 40%,transparent);border-color:var(--mint)}\n.card .dots span.start{background:var(--mint);border-color:var(--mint)}\n.card .dots span.fam-gap{margin-inline-start:10px}\n.card .k{font-size:.9rem;color:var(--muted);margin:0 0 4px}\n.card h3{font-size:1.5rem}\n.code-pill{display:inline-block;font:600 .8em/1 \"Utility Sans\",sans-serif;background:var(--mint);color:var(--on-mint);border-radius:999px;padding:.3em .6em;margin-inline-end:.5em;vertical-align:.12em}\n.card ul{list-style:none;padding:0;margin:18px 0 0;border-top:1px solid var(--line)}\n.card li{padding:10px 0;border-bottom:1px solid var(--line);font-size:.96rem;display:grid;grid-template-columns:38px 1fr;gap:8px}\n.card li b{color:var(--accent-text);font-weight:600}\n.card .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}\n.card .actions .btn{font-size:.92rem;padding:.6em 1.1em}\n.toast{font-size:.9rem;color:var(--accent-text);margin:12px 0 0;min-height:1.3em}\n\n/* process */\n.steps{list-style:none;counter-reset:s;padding:0;margin:48px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));position:relative}\n.steps::before{content:\"\";position:absolute;inset-inline-start:28px;inset-inline-end:calc(25% - 28px);top:28px;height:1.5px;background:var(--line-strong)}\n.steps li{counter-increment:s;padding-inline-end:24px}\n.steps li::before{content:counter(s);position:relative;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--mint);background:var(--bg);font:700 1.3rem/1 \"Utility Sans\",sans-serif;margin-bottom:22px}\n.steps li:first-child::before{background:var(--mint);color:var(--on-mint)}\n.steps p{font-size:.97rem;color:var(--muted)}\n.promises{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 44px;margin-top:64px}\n.promises div{border-top:1px solid var(--line);padding:18px 0}\n.promises b{display:block;font-weight:600;margin-bottom:4px}\n.promises p{font-size:.95rem;color:var(--muted);margin:0}\n\n/* record */\n.record{background:var(--bg-2)}\n.nums{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:44px;border-top:1px solid var(--line-strong)}\n.num{padding:28px 0 32px;padding-inline-end:28px;border-bottom:1px solid var(--line)}\n.num:not(:nth-child(3n+1)){padding-inline-start:28px;border-inline-start:1px solid var(--line)}\n.num .was{color:var(--muted);text-decoration:line-through;text-decoration-thickness:1px;font-size:.96rem;margin:0 0 6px}\n.num .now{font:700 clamp(2rem,3.6vw,2.9rem)/1.1 var(--font);margin:0 0 12px}\n.num .now span{background:var(--mint);color:var(--on-mint);padding:0 .14em}\n.num .what{font-size:.95rem;margin:0}\n.more{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:36px}\n.more p{margin:0;font-size:.92rem;color:var(--muted);max-width:60ch}\n\n/* industries */\n.ind-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,72px);align-items:start}\n.inds{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:10px}\n.inds li{border:1.5px solid var(--line-strong);border-radius:999px;padding:.45em 1em;font-size:.96rem}\n\n/* contact */\n.contact-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(32px,5vw,72px);align-items:center}\n.contact-dot{width:100%;max-width:540px;aspect-ratio:1/1;min-height:0;border-radius:50%;background:var(--mint);color:var(--on-mint);display:grid;place-items:center;text-align:center;margin:0 auto;container-type:inline-size;overflow:hidden}\n.contact-dot \u003e div{width:72%}\n.contact-dot h2{color:var(--on-mint);font-size:10cqi;margin:0 auto 5cqi;max-width:none}\n.contact-dot p{color:var(--on-mint);margin:0 auto;font-size:3.7cqi;line-height:1.5;max-width:none}\nhtml[lang=\"ar\"] .contact-dot h2{font-size:9.4cqi}\nhtml[lang=\"ar\"] .contact-dot p{font-size:3.6cqi;line-height:1.7}\n.contact-dot a.mail{display:inline-block;margin-top:5cqi;font-size:3.9cqi;color:var(--on-mint);font-weight:600;text-decoration:none;border-bottom:1.5px solid currentColor;padding-bottom:2px;direction:ltr}\n.form{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:clamp(22px,3vw,36px);display:grid;gap:18px}\n.form h3{font-size:1.35rem;margin:0}\n.form .row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}\n.field{display:grid;gap:6px;align-content:start}\n.field label,.field .lbl{font-size:.93rem;font-weight:400}\n.field .opt{color:var(--muted);font-weight:300}\n.field input,.field select,.field textarea{font:inherit;font-size:1rem;font-weight:300;color:var(--text);background:var(--bg);border:1.5px solid var(--line-strong);border-radius:12px;padding:.7em .85em;width:100%;min-width:0}\n.field input[type=\"email\"],.field input[type=\"tel\"]{direction:ltr;text-align:start}\nhtml[dir=\"rtl\"] .field input[type=\"email\"],html[dir=\"rtl\"] .field input[type=\"tel\"]{text-align:right}\n.field textarea{min-height:140px;resize:vertical;line-height:1.5}\n.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--mint);box-shadow:0 0 0 3px color-mix(in srgb,var(--mint) 28%,transparent)}\n.field .err{font-size:.86rem;color:var(--error);margin:0}\n.field.invalid input,.field.invalid textarea{border-color:var(--error)}\n.tags{display:flex;flex-wrap:wrap;gap:6px}\n.tags span{font-size:.86rem;border-radius:999px;padding:.3em .8em;background:color-mix(in srgb,var(--mint) 22%,transparent);border:1px solid var(--mint)}\n.tags .none{background:none;border:0;padding:0;color:var(--muted);font-size:.92rem}\n.form .send-row{display:flex;align-items:center;gap:14px 18px;flex-wrap:wrap}\n.form .fine{font-size:.86rem;color:var(--muted);margin:0;max-width:42ch}\n.sent{border-top:1px solid var(--line);padding-top:18px}\n.sent[hidden]{display:none}\n.sent p{margin:0 0 12px;font-size:.96rem}\n.sent .actions{display:flex;gap:10px;flex-wrap:wrap}\n.sent .btn{font-size:.92rem;padding:.6em 1.1em}\n.hp{position:absolute;inset-inline-start:-9999px;width:1px;height:1px;overflow:hidden}\n\nfooter{border-top:1px solid var(--line);padding:36px 0 44px}\nfooter .container{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;font-size:.9rem;color:var(--muted)}\nfooter .brand .m{width:34px;height:34px}\n\n/* responsive */\n@media (max-width:1060px){\n  .hero .container{grid-template-columns:1fr}\n  .orb{max-width:420px;margin:12px auto 0}\n  .fit-grid,.ind-grid,.contact-grid{grid-template-columns:1fr}\n  .contact-dot{max-width:460px}\n  .card{position:static}\n  .steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 0}\n  .steps::before{display:none}\n  .nums{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .num:not(:nth-child(3n+1)){padding-inline-start:0;border-inline-start:0}\n  .num:nth-child(2n){padding-inline-start:28px;border-inline-start:1px solid var(--line)}\n  .promises{grid-template-columns:1fr 1fr}\n  .strip .container{grid-template-columns:1fr}\n}\n@media (max-width:900px){\n  .links,.nav .btn{display:none}\n  .menu-btn{display:inline-flex}\n  .langbtn{margin-inline-start:auto}\n  .nav.open .links{display:flex;position:absolute;left:0;right:0;top:100%;flex-direction:column;gap:0;background:var(--bg);border-bottom:1px solid var(--line);padding:8px var(--pad) 18px;margin:0}\n  .nav.open .links a{display:block;padding:12px 0;border-bottom:1px solid var(--line);font-size:1.05rem;color:var(--text)}\n  .panel{grid-template-columns:1fr;gap:12px}\n  .panel .big{width:96px;font-size:2.6rem;margin-bottom:18px}\n}\n@media (max-width:620px){\n  body{font-size:16px}\n  html[lang=\"ar\"] body{font-size:16.5px}\n  .orb{max-width:300px}\n  .contact-dot \u003e div{width:74%}\n  .contact-dot h2{font-size:9.6cqi;margin-bottom:4cqi}\n  .contact-dot p{font-size:4.1cqi}\n  html[lang=\"ar\"] .contact-dot p{font-size:3.9cqi;line-height:1.6}\n  .contact-dot a.mail{font-size:4.4cqi;margin-top:4cqi}\n  .form .row{grid-template-columns:1fr}\n  .brand .w{width:96px;height:12px}\n  .tabs{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}\n  .tabs::-webkit-scrollbar{display:none}\n  .tab{white-space:nowrap;margin-inline-end:14px}\n  .steps,.promises,.nums{grid-template-columns:1fr}\n  .num:nth-child(2n){padding-inline-start:0;border-inline-start:0}\n  .card{padding:22px}\n  .logo-row{grid-template-columns:repeat(3,minmax(0,1fr))}\n}\n\n/* logo slider */\n.logo-slider{position:relative;overflow:hidden;background:#0E1719;border-radius:20px;padding:26px 0;isolation:isolate;direction:ltr}\n.logo-slider::before,.logo-slider::after{content:\"\";position:absolute;top:0;bottom:0;width:min(120px,12vw);z-index:2;pointer-events:none}\n.logo-slider::before{left:0;background:linear-gradient(to right,#0E1719,transparent)}\n.logo-slider::after{right:0;background:linear-gradient(to left,#0E1719,transparent)}\n.logo-track{display:flex;align-items:center;gap:clamp(40px,6vw,76px);width:max-content;direction:ltr;animation:logoscroll 32s linear infinite}\nhtml[dir=\"rtl\"] .logo-track{animation-direction:reverse}\n.logo-item{display:flex;align-items:center;flex:none}\n.logo-track img{height:34px;width:auto;max-width:150px;object-fit:contain;filter:brightness(0) invert(1);opacity:.92;display:block}\n@keyframes logoscroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.logo-slider:hover .logo-track,.logo-slider:focus-within .logo-track{animation-play-state:paused}\n@media (prefers-reduced-motion:reduce){\n  .logo-track{animation:none;flex-wrap:wrap;width:100%;justify-content:center}\n  .logo-slider::before,.logo-slider::after{display:none}\n  .logo-track .dup{display:none!important}\n}\n@media (max-width:640px){.logo-track img{height:26px;max-width:110px}.logo-slider{padding:20px 0}.logo-track{gap:34px}}\n\n.brand .wm{display:block;width:104px;height:28px;background:url(data:image/png;base64,) no-repeat left center/contain}footer .brand .wm{width:92px;height:25px}@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]) .brand .wm{background-image:url(data:image/png;base64,)}}:root[data-theme=\"dark\"] .brand .wm{background-image:url(data:image/png;base64,)}@media (max-width:620px){.brand .wm{width:90px;height:24px}}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003ca class=\"skip\" href=\"#main\" data-i18n=\"skip\"\u003eSkip to content\u003c/a\u003e\n\n\u003cheader class=\"nav\" id=\"nav\"\u003e\n  \u003cdiv class=\"container\"\u003e\n    \u003ca class=\"brand\" href=\"#top\" data-i18n-attr=\"aria-label:brandLabel\" aria-label=\"dot. tech studio, home\"\u003e\n      \u003cspan class=\"wm\" aria-hidden=\"true\"\u003e\u003c/span\u003e\n    \u003c/a\u003e\n    \u003cul class=\"links\" id=\"links\"\u003e\n      \u003cli\u003e\u003ca href=\"#services\" data-i18n=\"nav.services\"\u003eServices\u003c/a\u003e\u003c/li\u003e\n      \u003cli\u003e\u003ca href=\"#fit\" data-i18n=\"nav.fit\"\u003eWhere to start\u003c/a\u003e\u003c/li\u003e\n      \u003cli\u003e\u003ca href=\"#process\" data-i18n=\"nav.process\"\u003eHow we work\u003c/a\u003e\u003c/li\u003e\n      \u003cli\u003e\u003ca href=\"#record\" data-i18n=\"nav.record\"\u003eRecord\u003c/a\u003e\u003c/li\u003e\n      \u003cli\u003e\u003ca href=\"#contact\" data-i18n=\"nav.contact\"\u003eContact\u003c/a\u003e\u003c/li\u003e\n    \u003c/ul\u003e\n    \u003ca class=\"btn btn-primary\" href=\"#contact\" data-i18n=\"nav.cta\"\u003eStart a diagnosis\u003c/a\u003e\n    \u003cbutton class=\"langbtn\" type=\"button\" id=\"langBtn\" lang=\"ar\"\u003e\u0639\u0631\u0628\u064a\u003c/button\u003e\n    \u003cbutton class=\"menu-btn\" type=\"button\" aria-expanded=\"false\" aria-controls=\"links\" id=\"menuBtn\" data-i18n=\"nav.menu\"\u003eMenu\u003c/button\u003e\n  \u003c/div\u003e\n\u003c/header\u003e\n\n\u003cmain id=\"main\"\u003e\n  \u003csection class=\"hero\" id=\"top\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003cdiv\u003e\n        \u003ca class=\"news\" href=\"/ai-enablement/\"\u003e\u003ci aria-hidden=\"true\"\u003e\u003c/i\u003e\u003cspan data-i18n=\"hero.new\"\u003eNew: AI enablement. Four hours, one to one, on your own work\u003c/span\u003e\u003cb aria-hidden=\"true\"\u003e\u0026rarr;\u003c/b\u003e\u003c/a\u003e\n\u003ch1 class=\"display\" data-i18n=\"hero.h\"\u003eAI and automation, built for when the vendor has failed and the deadline is real.\u003c/h1\u003e\n        \u003cp class=\"lead\" data-i18n=\"hero.lead\"\u003edot. tech studio puts AI to work, builds business systems, moves and fixes data, and rescues stalled projects, for companies in Saudi Arabia.\u003c/p\u003e\n        \u003cp class=\"lead-sub\" data-i18n=\"hero.lead2\"\u003eBased in Riyadh, we design AI-powered business systems and automation for insurance, payments, healthcare and manufacturing companies across Saudi Arabia \u0026mdash; consulting on how the business runs, not just the software.\u003c/p\u003e\n        \u003cdiv class=\"ctas\"\u003e\n          \u003ca class=\"btn btn-primary\" href=\"#fit\" data-i18n=\"hero.c1\"\u003eFind where to start\u003c/a\u003e\n          \u003ca class=\"btn btn-ghost\" href=\"#record\" data-i18n=\"hero.c2\"\u003eSee the record\u003c/a\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"orb\" aria-hidden=\"true\"\u003e\n        \u003csvg class=\"ring\" viewBox=\"0 0 520 520\"\u003e\n          \u003cdefs\u003e\n            \u003cpath id=\"circ\" d=\"M260,260 m-236,0 a236,236 0 1,1 472,0 a236,236 0 1,1 -472,0\"/\u003e\n          \u003c/defs\u003e\n          \u003ctext id=\"ringText\"\u003e\u003ctextPath href=\"#circ\" textLength=\"1470\" lengthAdjust=\"spacing\" id=\"ringPath\"\u003e\u003c/textPath\u003e\u003c/text\u003e\n        \u003c/svg\u003e\n        \u003cimg class=\"mark\" src=\"data:image/png;base64,\" alt=\"\"\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003cdiv class=\"strip\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003cp data-i18n=\"strip\"\u003eRegulators and platforms we have worked with\u003c/p\u003e\n      \u003cdiv class=\"logo-slider\" id=\"logoSlider\"\u003e\u003cdiv class=\"logo-track\" id=\"logoRow\"\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003csection id=\"services\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003ch2 class=\"display\" data-i18n=\"svc.h\"\u003eFive families, fifteen services.\u003c/h2\u003e\n      \u003cp class=\"lead muted\" style=\"margin:0\" data-i18n=\"svc.lead\"\u003ePick a family to see what we build inside it.\u003c/p\u003e\n      \u003cdiv class=\"tabs\" role=\"tablist\" id=\"tabs\" data-i18n-attr=\"aria-label:svc.tabsLabel\" aria-label=\"Service families\"\u003e\u003c/div\u003e\n      \u003cdiv id=\"panels\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection class=\"fit\" id=\"fit\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003ch2 class=\"display\" data-i18n=\"fit.h\"\u003eWhere does it hurt?\u003c/h2\u003e\n      \u003cp class=\"lead\" data-i18n=\"fit.lead\"\u003eChoose what sounds like your company. We will show where we would start, and you can send it to us as a message.\u003c/p\u003e\n      \u003cdiv class=\"fit-grid\"\u003e\n        \u003cdiv class=\"chips\" id=\"chips\" role=\"group\" data-i18n-attr=\"aria-label:fit.chipsLabel\" aria-label=\"Situations\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"card\" id=\"card\" aria-live=\"polite\"\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection id=\"process\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003ch2 class=\"display\" data-i18n=\"pr.h\"\u003eSmall paid steps you can check.\u003c/h2\u003e\n      \u003cp class=\"lead\" data-i18n=\"pr.lead\"\u003eWe fit the build to your workflow and your data, one module at a time.\u003c/p\u003e\n      \u003col class=\"steps\"\u003e\n        \u003cli\u003e\u003ch3 data-i18n=\"pr.s1h\"\u003eDiagnosis month\u003c/h3\u003e\u003cp data-i18n=\"pr.s1\"\u003eA paid month reading your systems, data, vendors and daily workflow. It ends in a written 90\u0026#8209;day plan the owner signs.\u003c/p\u003e\u003c/li\u003e\n        \u003cli\u003e\u003ch3 data-i18n=\"pr.s2h\"\u003eFirst module\u003c/h3\u003e\u003cp data-i18n=\"pr.s2\"\u003eThe part that costs you most is built first, usually costing and quoting. Working within weeks, on your own data.\u003c/p\u003e\u003c/li\u003e\n        \u003cli\u003e\u003ch3 data-i18n=\"pr.s3h\"\u003eChecked delivery\u003c/h3\u003e\u003cp data-i18n=\"pr.s3\"\u003eEvery deliverable has a written check that settles whether it is done. Fee steps follow delivered milestones.\u003c/p\u003e\u003c/li\u003e\n        \u003cli\u003e\u003ch3 data-i18n=\"pr.s4h\"\u003eRun and grow\u003c/h3\u003e\u003cp data-i18n=\"pr.s4\"\u003eMonthly modules and stewardship, with hosting, backups and the tool budget reported to you.\u003c/p\u003e\u003c/li\u003e\n      \u003c/ol\u003e\n      \u003cdiv class=\"promises\"\u003e\n        \u003cdiv\u003e\u003cb data-i18n=\"pr.p1h\"\u003eHosted in Saudi Arabia\u003c/b\u003e\u003cp data-i18n=\"pr.p1\"\u003eSaudi cloud regions by default, one tenant per client.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv\u003e\u003cb data-i18n=\"pr.p2h\"\u003eYour data stays yours\u003c/b\u003e\u003cp data-i18n=\"pr.p2\"\u003eExport to Excel at any time. Nightly backups.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv\u003e\u003cb data-i18n=\"pr.p3h\"\u003eEvery number has a source\u003c/b\u003e\u003cp data-i18n=\"pr.p3\"\u003eReports carry a written record of where each figure comes from.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection class=\"record\" id=\"record\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003ch2 class=\"display\" data-i18n=\"rec.h\"\u003eThe record, in numbers.\u003c/h2\u003e\n      \u003cp class=\"lead\" data-i18n=\"rec.lead\"\u003eThe same work, before and after. Speed, money found and deadlines met across Saudi insurance, payments, manufacturing and healthcare.\u003c/p\u003e\n      \u003cdiv class=\"nums\"\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n1w\"\u003e42 seconds\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n1n\"\u003e0.07 s\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n1\"\u003eInsurance quotation time. The insurer moved from rank 32 of 34 to rank 1 on the SAMA price aggregator.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n2w\"\u003e18 hours\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n2n\"\u003e16 s\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n2\"\u003ePayroll report for more than 10,000 employees, matched to the halalah.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n3w\"\u003e2 hours\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n3n\"\u003e7 s\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n3\"\u003eCustomer statement report. The rebuilt code has run unchanged since 2012.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n4w\"\u003eA one-month vendor proposal\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n4n\"\u003e26 s\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n4\"\u003eTo resolve a 300 million SAR mismatch between invoices and receipts.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n5w\"\u003eAn 8 million US dollar quote\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n5n\"\u003e1 engineer\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n5\"\u003eThree legacy insurance databases consolidated into one schema, with full data integrity.\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"num\"\u003e\u003cp class=\"was\" data-i18n=\"n6w\"\u003e3 to 6 months each\u003c/p\u003e\u003cp class=\"now\"\u003e\u003cspan data-i18n=\"n6n\"\u003e1 week\u003c/span\u003e\u003c/p\u003e\u003cp class=\"what\" data-i18n=\"n6\"\u003ePer integration, for four enterprise integrations the vendor could not deliver.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"more\"\u003e\n        \u003cp data-i18n=\"rec.disc\"\u003eFrom our technology lead's work inside Saudi companies before dot. tech studio. No client is named without written agreement.\u003c/p\u003e\n        \u003ca class=\"btn btn-ghost\" id=\"profileLink\" href=\"#\" data-i18n=\"rec.more\"\u003eRead all seventeen cases\u003c/a\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection id=\"industries\"\u003e\n    \u003cdiv class=\"container ind-grid\"\u003e\n      \u003cdiv\u003e\n        \u003ch2 class=\"display\" data-i18n=\"ind.h\"\u003eBuilt for regulated work.\u003c/h2\u003e\n        \u003cp class=\"lead muted\" data-i18n=\"ind.lead\"\u003eIndustries where a wrong number has a cost and a missed date has a consequence.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cul class=\"inds\" data-i18n=\"ind.list\"\u003e\n        \u003cli\u003eInsurance\u003c/li\u003e\u003cli\u003ePayments and financial technology\u003c/li\u003e\u003cli\u003eManufacturing and industrial IoT\u003c/li\u003e\u003cli\u003eFood safety and food technology\u003c/li\u003e\u003cli\u003eHospitality supply\u003c/li\u003e\u003cli\u003eEvents\u003c/li\u003e\u003cli\u003eLogistics\u003c/li\u003e\u003cli\u003ePublic sector\u003c/li\u003e\u003cli\u003eEnterprise retail\u003c/li\u003e\u003cli\u003eE-commerce\u003c/li\u003e\n      \u003c/ul\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection id=\"contact\"\u003e\n    \u003cdiv class=\"container contact-grid\"\u003e\n      \u003cdiv class=\"contact-dot\"\u003e\n        \u003cdiv\u003e\n          \u003ch2 class=\"display\" data-i18n=\"ct.h\"\u003eStart with one month.\u003c/h2\u003e\n          \u003cp data-i18n=\"ct.p\"\u003eA paid diagnosis month that ends in a written 90\u0026#8209;day plan you sign. Tell us where it hurts and we will reply to set up a first conversation.\u003c/p\u003e\n          \u003ca class=\"mail\" href=\"mailto:info@dot-cs.com\"\u003einfo@dot-cs.com\u003c/a\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cform class=\"form\" id=\"contactForm\" novalidate\u003e\u003cinput type=\"hidden\" id=\"f-test\" value=\"\"\u003e\n        \u003ch3 data-i18n=\"fm.h\"\u003eSend us a message\u003c/h3\u003e\n        \u003cdiv class=\"row\"\u003e\n          \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-name\" data-i18n=\"fm.name\"\u003eYour name\u003c/label\u003e\u003cinput id=\"f-name\" name=\"name\" autocomplete=\"name\" required\u003e\u003cp class=\"err\" id=\"e-name\"\u003e\u003c/p\u003e\u003c/div\u003e\n          \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-company\" data-i18n=\"fm.company\"\u003eCompany\u003c/label\u003e\u003cinput id=\"f-company\" name=\"company\" autocomplete=\"organization\" required\u003e\u003cp class=\"err\" id=\"e-company\"\u003e\u003c/p\u003e\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"row\"\u003e\n          \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-email\" data-i18n=\"fm.email\"\u003eWork email\u003c/label\u003e\u003cinput id=\"f-email\" name=\"email\" type=\"email\" inputmode=\"email\" autocomplete=\"email\" required\u003e\u003cp class=\"err\" id=\"e-email\"\u003e\u003c/p\u003e\u003c/div\u003e\n          \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-phone\" data-i18n=\"fm.phone\"\u003ePhone \u003cspan class=\"opt\"\u003e(optional)\u003c/span\u003e\u003c/label\u003e\u003cinput id=\"f-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\"\u003e\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-size\" data-i18n=\"fm.size\"\u003eCompany size \u003cspan class=\"opt\"\u003e(optional)\u003c/span\u003e\u003c/label\u003e\n          \u003cselect id=\"f-size\" name=\"size\" data-i18n=\"fm.sizeOpts\"\u003e\u003coption value=\"\"\u003eChoose one\u003c/option\u003e\u003coption value=\"lt10\"\u003eFewer than 10 people\u003c/option\u003e\u003coption value=\"10-50\"\u003e10 to 50 people\u003c/option\u003e\u003coption value=\"51-100\"\u003e51 to 100 people\u003c/option\u003e\u003coption value=\"gt100\"\u003eMore than 100 people\u003c/option\u003e\u003c/select\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"field\"\u003e\u003cspan class=\"lbl\" data-i18n=\"fm.svc\"\u003eServices you are interested in\u003c/span\u003e\u003cdiv class=\"tags\" id=\"f-tags\"\u003e\u003c/div\u003e\u003c/div\u003e\n        \u003cdiv class=\"field\"\u003e\u003clabel for=\"f-msg\" data-i18n=\"fm.msg\"\u003eWhat is going on?\u003c/label\u003e\u003ctextarea id=\"f-msg\" name=\"message\" required data-i18n-attr=\"placeholder:fm.msgPh\" placeholder=\"The system, the problem, and any date you are working to.\"\u003e\u003c/textarea\u003e\u003cp class=\"err\" id=\"e-msg\"\u003e\u003c/p\u003e\u003c/div\u003e\n        \u003cdiv class=\"hp\" aria-hidden=\"true\"\u003e\u003clabel for=\"f-web\"\u003eWebsite\u003c/label\u003e\u003cinput id=\"f-web\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"send-row\"\u003e\n          \u003cbutton class=\"btn btn-primary\" type=\"submit\" data-i18n=\"fm.send\"\u003eSend message\u003c/button\u003e\n          \u003cp class=\"fine\" data-i18n=\"fm.fine\"\u003eSent straight from this page \u2014 no email app needed.\u003c/p\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"sent\" id=\"sent\" hidden role=\"status\"\u003e\n          \u003cp id=\"sentText\"\u003e\u003c/p\u003e\n          \u003cdiv class=\"actions\"\u003e\u003ca class=\"btn btn-primary\" id=\"mailAgain\" href=\"mailto:info@dot-cs.com\" target=\"_blank\" rel=\"noopener\" data-i18n=\"fm.open\"\u003eOpen in email app\u003c/a\u003e\u003cbutton class=\"btn btn-ghost\" type=\"button\" id=\"copyForm\" data-i18n=\"fm.copy\"\u003eCopy the message\u003c/button\u003e\u003c/div\u003e\n          \u003cp class=\"toast\" id=\"formToast\"\u003e\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/form\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\u003c/main\u003e\n\n\u003cfooter\u003e\n  \u003cdiv class=\"container\"\u003e\n    \u003ca class=\"brand\" href=\"#top\" data-i18n-attr=\"aria-label:brandTop\" aria-label=\"dot. tech studio, back to top\"\u003e\n      \u003cspan class=\"wm\" aria-hidden=\"true\"\u003e\u003c/span\u003e\n    \u003c/a\u003e\n    \u003cspan data-i18n=\"ft.city\"\u003eRiyadh, Saudi Arabia\u003c/span\u003e\n    \u003cspan\u003e\u00a9 2026 dot. tech studio\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/footer\u003e\n\n\u003cscript\u003e\nconst DATA = {en: {\"FAMILIES\": [{\"id\": \"A\", \"name\": \"AI and automation\", \"line\": \"Agents and assistants that take the routine off your team, and data from the factory floor.\"}, {\"id\": \"B\", \"name\": \"Build and run business systems\", \"line\": \"Systems shaped around how your company already works, hosted in Saudi Arabia, sold per module.\"}, {\"id\": \"C\", \"name\": \"Data\", \"line\": \"Move it, merge it, reconcile it, and make it fast.\"}, {\"id\": \"D\", \"name\": \"Rescue and compliance\", \"line\": \"Projects a vendor could not finish, and dates a regulator set.\"}, {\"id\": \"E\", \"name\": \"Leadership\", \"line\": \"Senior ownership of your technology without a full-time hire.\"}], \"SERVICES\": [{\"code\": \"A1\", \"fam\": \"A\", \"title\": \"AI operations\", \"short\": \"Agents that chase, summarise, file and draft.\", \"what\": \"Agents that chase, summarise, file and draft. Built on workflow automation and large language model (LLM) APIs, with a monthly tool budget managed and reported to you.\", \"who\": \"Teams losing hours to follow-ups, inbox sorting and document intake.\", \"receive\": [\"Named workflows: a morning brief, a chase list, an inbox triage, a document intake\", \"A written procedure, run logs and a budget line for each\"], \"proof\": [\"In daily use in our own operations.\"]}, {\"code\": \"A2\", \"fam\": \"A\", \"title\": \"AI assistants for teams\", \"short\": \"An assistant that holds the threads and briefs the owner each morning.\", \"what\": \"We set up and run an AI assistant that holds a team's threads, project statuses, decisions and procedures, and briefs the owner each morning.\", \"who\": \"Founders, executives and small teams with too many threads.\", \"receive\": [\"A private, working assistant\", \"A morning brief\", \"Project status files\", \"A short written procedure the team follows\"], \"proof\": []}, {\"code\": \"A3\", \"fam\": \"A\", \"title\": \"Industrial data and the Internet of Things (IoT)\", \"short\": \"Sensors on machines, data into the enterprise system.\", \"what\": \"Sensors on machines, data into the enterprise system, and the production schedule reordered around the real bottleneck.\", \"who\": \"Manufacturers who plan production without knowing where time and material are really lost.\", \"receive\": [], \"proof\": [\"Heavy production machinery across six factories instrumented and integrated with Oracle E-Business Suite, tracking every pole by order, stage, machine, scrap and time. Welding found as the true bottleneck. Inventory prediction added so purchasing never stalled the line.\"]}, {\"code\": \"B1\", \"fam\": \"B\", \"title\": \"Business systems, built and hosted\", \"short\": \"One hosted system around your real workflow, delivered module by module.\", \"what\": \"A system built around the way your team really works, delivered as monthly modules: costing and quoting first, then operations, finance and human resources. Hosted in a Saudi cloud region, one tenant per client, with data export at any time.\", \"who\": \"Companies of 10 to 100 people that run on spreadsheets, chat groups and five subscriptions nobody owns.\", \"receive\": [\"A working first module within weeks\", \"A monthly subscription per module\", \"Your data exportable to Excel at any time\", \"Nightly backups\"], \"proof\": [\"A hosted quotation and order system for a hospitality trading company in Riyadh, 2026.\"]}, {\"code\": \"B2\", \"fam\": \"B\", \"title\": \"Costing and quoting engines\", \"short\": \"Know the real cost of a job before you price it.\", \"what\": \"Know the real cost of a job before you price it. The database calculates the quotation, and drift alerts tell you when the actual cost moves away from the quoted cost.\", \"who\": \"Events, hospitality supply, manufacturing, and any project business that loses money between the quotation and the delivery.\", \"receive\": [\"A quotation builder\", \"Cost drift tracking\", \"Customer copies in PDF, Excel and print, on your own letterhead\"], \"proof\": [\"An insurance rating engine where quotation time went from 42 seconds to 0.07 seconds.\", \"The hospitality quotation system under B1.\"]}, {\"code\": \"B3\", \"fam\": \"B\", \"title\": \"Dashboards and reporting\", \"short\": \"The page the owner reads every morning, with nothing typed by hand.\", \"what\": \"The page the owner reads every morning. Numbers pulled from your own systems, nothing typed by hand.\", \"who\": \"Owners and managers who get their numbers late, or from three people who disagree.\", \"receive\": [\"Dashboards and scheduled reports on Oracle Business Intelligence, Qlik Sense or a custom web page\", \"The source of every number written down\"], \"proof\": [\"A factory dashboard across six factories.\", \"A customer statement report cut from two hours to seven seconds.\", \"A payroll report for more than 10,000 employees cut from 18 hours to 16 seconds.\"]}, {\"code\": \"B4\", \"fam\": \"B\", \"title\": \"Integrations and e-invoicing\", \"short\": \"Make the systems you already have talk to each other.\", \"what\": \"Make the systems you already have talk to each other: accounting, human resources, payments, point of sale, e-commerce, document management, and Phase 2 e-invoicing with the Zakat, Tax and Customs Authority (ZATCA).\", \"who\": \"Any company with two or more systems and a person re-typing between them.\", \"receive\": [\"Integrations built on application programming interfaces (APIs), webhooks or Apache Kafka event streams\", \"Monitoring and documentation\", \"A reconciliation report\"], \"proof\": [\"Four enterprise integrations delivered in one week each, after the vendor had failed for months.\", \"An insurance core-system to Oracle E-Business Suite integration rebuilt in 2012 and running unchanged in production since.\", \"Najm and Yaqeen integration for motor claims.\"]}, {\"code\": \"C1\", \"fam\": \"C\", \"title\": \"Data migration with zero downtime\", \"short\": \"Leave a legacy system without stopping the business.\", \"what\": \"Move off a legacy system onto a new one without stopping the business, and without paying the old vendor's extraction fees.\", \"who\": \"Companies replacing a core system, or held back by a vendor that charges to hand back their own data.\", \"receive\": [\"Mapping documents\", \"Migration scripts\", \"Reconciliation to the last halalah\", \"A cut-over plan and a rollback plan\"], \"proof\": [\"A legacy insurance system migrated by reading its database directly, with extraction complete in under three weeks.\", \"A core-system rollback at a takaful insurer.\"]}, {\"code\": \"C2\", \"fam\": \"C\", \"title\": \"Database consolidation and cleanup\", \"short\": \"Several databases or branches, merged into one clean schema.\", \"what\": \"Merge several databases or branches into one clean schema. Merge duplicate customers. Fix master data whose codes differ from branch to branch.\", \"who\": \"Companies that grew by adding branches, systems or acquisitions, and now hold the same customer three times.\", \"receive\": [], \"proof\": [\"Three legacy insurance databases consolidated into one schema by a single engineer in about a year, with dependencies up to seven levels deep. The outside vendor had judged it impossible and quoted 8 million US dollars to freeze the data and start fresh.\"]}, {\"code\": \"C3\", \"fam\": \"C\", \"title\": \"Reconciliation and financial audit of systems\", \"short\": \"Find where the money went.\", \"what\": \"Find where the money went. Match invoices to receipts, contracts to payments, and claims to policies.\", \"who\": \"Finance teams whose systems and ledgers disagree, and owners who suspect leakage.\", \"receive\": [], \"proof\": [\"A 300 million Saudi riyal (SAR) mismatch between invoices and receipts resolved in 26 seconds with Oracle API routines, replacing a proposed one-month, four-person vendor engagement.\", \"A hospital audit under General Organization for Social Insurance (GOSI) work-injury contracts that surfaced an estimated 250 million SAR in unbilled and mishandled amounts.\"]}, {\"code\": \"C4\", \"fam\": \"C\", \"title\": \"Database performance and rescue\", \"short\": \"Make slow systems fast without replacing them.\", \"what\": \"Make slow systems fast without replacing them.\", \"who\": \"Teams waiting minutes or hours on screens, uploads and reports that should take seconds.\", \"receive\": [], \"proof\": [\"Policy upload cut from 25 minutes per batch to under 10 seconds.\", \"A rating engine cut from 42 seconds to 0.07 seconds, moving the insurer from rank 32 of 34 to rank 1 on the Saudi Central Bank (SAMA) price aggregator, where the fastest response ranks first.\", \"A payroll report cut from 18 hours to 16 seconds.\"]}, {\"code\": \"D1\", \"fam\": \"D\", \"title\": \"Failing project recovery and vendor replacement\", \"short\": \"Take over a project the vendor cannot finish.\", \"what\": \"Take over a project the vendor cannot finish. Read the black box, find the real blocker, deliver.\", \"who\": \"Companies that have paid a large vendor and have nothing live.\", \"receive\": [], \"proof\": [\"An 8 million dollar consolidation quote replaced by one engineer, with full data integrity.\", \"Four integrations delivered after the vendor had spent three to six months on each without result.\", \"A failing budgeting go-live rescued in two weeks, with no integration licence and an incomplete handover.\"]}, {\"code\": \"D2\", \"fam\": \"D\", \"title\": \"Regulator-deadline delivery\", \"short\": \"The data a regulator wants, on the regulator's date.\", \"what\": \"Deliver the data or the evidence a regulator wants, on the regulator's date.\", \"who\": \"Regulated companies facing a fixed date and a vendor that cannot meet it.\", \"receive\": [], \"proof\": [\"Ten years of historical claims across all branches uploaded to the SAMA deadline over one three-day weekend, after the appointed vendor could not do it.\", \"More than 750,000 motor policies uploaded to Najm under a single-day deadline, run in parallel across 25 machines over a weekend.\"]}, {\"code\": \"D3\", \"fam\": \"D\", \"title\": \"Licensing and compliance evidence packages\", \"short\": \"The documents an audit needs, written to pass.\", \"what\": \"The architecture, security and data-flow documents an audit needs, written to pass.\", \"who\": \"Companies applying for a licence or preparing for a technical audit.\", \"receive\": [], \"proof\": [\"The infrastructure, security and data-flow architecture and evidence package for a payments platform, used to pass the SAMA technical audit and secure its payments licence and investment.\"]}, {\"code\": \"D4\", \"fam\": \"D\", \"title\": \"Fraud and control rules\", \"short\": \"Rules inside the system that flag what a person should check.\", \"what\": \"Logic rules inside the system that flag the cases a person should look at.\", \"who\": \"Insurers, payment companies and any business paying out claims or refunds.\", \"receive\": [], \"proof\": [\"A motor fraud ruleset flagging claims by timing within the policy, shared family names, address proximity, related parties, high-value vehicles and repeat damage to the same part. It caught real fraud for the review team.\"]}, {\"code\": \"E1\", \"fam\": \"E\", \"title\": \"Fractional technology head\", \"short\": \"One senior person who owns your whole technology stack, part time.\", \"what\": \"One senior person who owns your whole technology stack part time: systems, vendors, data, security and budget. The duties of a Chief Technology Officer (CTO) or IT director, without the full-time salary.\", \"who\": \"Companies of 10 to 50 people that cannot justify a full-time CTO and are being sold to by every vendor.\", \"receive\": [\"A paid diagnosis month ending in a written 90\u2011day plan the owner signs\", \"Monthly stewardship with milestones\", \"The tool budget owned and reported\", \"Decision rights written down\"], \"proof\": [\"This is the shape of a current engagement with an events company in Riyadh.\"]}, {\"code\": \"E2\", \"fam\": \"E\", \"title\": \"Vendor selection and claim verification\", \"short\": \"Check what a vendor claims before you sign.\", \"what\": \"Check what a vendor claims before you sign. Every claim is tested against your own data.\", \"who\": \"Owners about to sign a large system, licence or implementation contract.\", \"receive\": [], \"proof\": [\"Nineteen years on the buying side of Oracle, Hyperion, Laserfiche, Kafka, insurance core-system and cloud vendors.\"]}, {\"code\": \"E3\", \"fam\": \"E\", \"title\": \"Project and programme management\", \"short\": \"The technical stream of a wider change programme, run properly.\", \"what\": \"Project Management Professional (PMP) certified. Agile and Waterfall. Used to running the technical stream inside a wider business change programme.\", \"who\": \"Companies running a business change that depends on systems work.\", \"receive\": [], \"proof\": []}], \"SITUATIONS\": [{\"id\": \"sheets\", \"label\": \"We run on spreadsheets and chat groups\", \"codes\": [\"B1\", \"B3\", \"A2\"]}, {\"id\": \"quote\", \"label\": \"We lose money between the quote and the delivery\", \"codes\": [\"B2\", \"B1\", \"C3\"]}, {\"id\": \"late\", \"label\": \"Our numbers come late, or they disagree\", \"codes\": [\"B3\", \"B4\", \"C3\"]}, {\"id\": \"retype\", \"label\": \"Someone re-types data between systems\", \"codes\": [\"B4\", \"A1\", \"C2\"]}, {\"id\": \"legacy\", \"label\": \"We are leaving an old system\", \"codes\": [\"C1\", \"C2\", \"E2\"]}, {\"id\": \"vendor\", \"label\": \"We paid a vendor and nothing is live\", \"codes\": [\"D1\", \"E2\", \"E1\"]}, {\"id\": \"regulator\", \"label\": \"A regulator deadline is coming\", \"codes\": [\"D2\", \"D3\", \"C3\"]}, {\"id\": \"slow\", \"label\": \"Our system is slow\", \"codes\": [\"C4\", \"C2\"]}, {\"id\": \"owner\", \"label\": \"Nobody owns our technology\", \"codes\": [\"E1\", \"E2\", \"E3\"]}, {\"id\": \"threads\", \"label\": \"Too many threads for too few people\", \"codes\": [\"A2\", \"A1\"]}, {\"id\": \"leak\", \"label\": \"Money is leaking and we cannot see where\", \"codes\": [\"C3\", \"D4\"]}, {\"id\": \"factory\", \"label\": \"We cannot see what the factory floor is doing\", \"codes\": [\"A3\", \"B3\"]}], \"SPEED\": [{\"label\": \"Insurance rating engine, per quotation\", \"before\": 42, \"after\": 0.07, \"b\": \"42 seconds\", \"a\": \"0.07 seconds\"}, {\"label\": \"Customer statement report\", \"before\": 7200, \"after\": 7, \"b\": \"2 hours\", \"a\": \"7 seconds\"}, {\"label\": \"Payroll report, more than 10,000 employees\", \"before\": 64800, \"after\": 16, \"b\": \"18 hours\", \"a\": \"16 seconds\"}, {\"label\": \"Mass policy upload, per batch\", \"before\": 1500, \"after\": 10, \"b\": \"25 minutes\", \"a\": \"under 10 seconds\"}, {\"label\": \"Motor claim processing\", \"before\": 1200, \"after\": 120, \"b\": \"20 minutes\", \"a\": \"under 2 minutes\"}, {\"label\": \"300 million SAR reconciliation\", \"before\": 2592000, \"after\": 26, \"b\": \"a proposed one-month, four-person engagement\", \"a\": \"26 seconds\"}], \"CASES\": [{\"t\": \"Three insurance databases, one schema\", \"ind\": \"Insurance\", \"fam\": [\"C\", \"D\"], \"codes\": \"C2 D1\", \"body\": \"Consolidated three separate legacy insurance databases into one schema, working solo over about a year. Mapped master data that carried different codes per branch, with dependencies up to seven levels deep, and merged duplicate customers into single accounts and statements. Delivered with full data integrity.\", \"fig\": \"The outside vendor had judged it impossible and quoted 8 million US dollars to freeze the data and start fresh.\"}, {\"t\": \"Ten years of claims in one weekend\", \"ind\": \"Insurance\", \"fam\": [\"D\"], \"codes\": \"D2\", \"body\": \"A regulator-mandated upload of ten years of historical claims across all branches, rescued over a single three-day weekend after the appointed vendor could not do it. Degraded legacy records were cleaned and rebuilt, and policies matched to national identities.\", \"fig\": \"The SAMA deadline was met, removing the company's shutdown risk.\"}, {\"t\": \"Integration and reporting rebuild\", \"ind\": \"Takaful insurance\", \"fam\": [\"B\"], \"codes\": \"B4 B3\", \"body\": \"Reverse-engineered a faulty hourly integration between the core insurance system and Oracle E-Business Suite, then rebuilt the process and the customer statement and ageing reports. Transactions now reflect instantly with no errors.\", \"fig\": \"Statement report from two hours to seven seconds. The code has run in production unchanged since 2012.\"}, {\"t\": \"300 million SAR reconciled\", \"ind\": \"Takaful insurance\", \"fam\": [\"C\"], \"codes\": \"C3\", \"body\": \"Resolved a mismatch between invoices and receipts by building and running Oracle API routines.\", \"fig\": \"300 million SAR resolved in 26 seconds, replacing a proposed one-month, four-person vendor engagement.\"}, {\"t\": \"Budgeting go-live rescue\", \"ind\": \"Takaful insurance\", \"fam\": [\"D\"], \"codes\": \"D1\", \"body\": \"Took over a failing Hyperion budgeting go-live with no integration licence and an incomplete handover. Learned the manual data process and corrected every mismatched number to the halalah.\", \"fig\": \"A successful executive presentation within a two-week deadline.\"}, {\"t\": \"Four integrations the vendor could not deliver\", \"ind\": \"Takaful insurance\", \"fam\": [\"B\", \"D\"], \"codes\": \"B4 D1\", \"body\": \"Delivered four enterprise system integrations the vendor had failed to complete, working solo.\", \"fig\": \"Each delivered within a one-week window, after each had been allocated three to six months.\"}, {\"t\": \"Legacy migration without vendor access\", \"ind\": \"Insurance\", \"fam\": [\"C\"], \"codes\": \"C1\", \"body\": \"Migrated a legacy insurance system to a new core system with zero downtime by reverse-engineering the database directly, bypassing the vendor's pending support and extraction fees.\", \"fig\": \"Extraction to the new system's templates completed in under three weeks.\"}, {\"t\": \"Motor claims automation\", \"ind\": \"Insurance\", \"fam\": [\"B\"], \"codes\": \"B4\", \"body\": \"A motor claims system integrating Najm and Yaqeen for automatic data capture, and Laserfiche document scanning with optical character recognition (OCR). Service-level timers, fraud flags and a multi-level approval workflow by claim value.\", \"fig\": \"A 20-minute manual process cut to under two minutes.\"}, {\"t\": \"Mass-upload performance fix\", \"ind\": \"Insurance\", \"fam\": [\"C\"], \"codes\": \"C4\", \"body\": \"Found why mass policy uploads crawled: the core system scanned the full policy table to generate each new number. Built dynamic Oracle sequences per transaction type.\", \"fig\": \"From 25 minutes per batch to under 10 seconds, enabling a large production increase in medical policies.\"}, {\"t\": \"Self-service claim status line\", \"ind\": \"Insurance\", \"fam\": [\"B\"], \"codes\": \"B4\", \"body\": \"An automated call-centre line, 2014, where a customer enters a national identity number and hears claim status, missing documents, pending approvals and the expected amount.\", \"fig\": \"Reduced call-centre load.\"}, {\"t\": \"Rating engine optimisation\", \"ind\": \"Insurance\", \"fam\": [\"B\", \"C\"], \"codes\": \"C4 B2\", \"body\": \"Reverse-engineered and optimised a vendor-built insurance rating engine. On the SAMA price aggregator, the fastest response ranks highest.\", \"fig\": \"Quotation time from 42 seconds to 0.07 seconds. Rank 32 of 34 to rank 1, capturing a dominant share of new sales.\"}, {\"t\": \"Motor fraud ruleset\", \"ind\": \"Insurance\", \"fam\": [\"D\"], \"codes\": \"D4\", \"body\": \"A logic-based fraud process flagging claims by timing within the policy, shared family names, address proximity, related parties, high-value vehicles and repeat damage to the same part.\", \"fig\": \"Caught real fraud for the dedicated review team.\"}, {\"t\": \"Factory operations dashboard\", \"ind\": \"Manufacturing\", \"fam\": [\"A\", \"B\"], \"codes\": \"A3 B3\", \"body\": \"Heavy production machinery for lighting poles and towers fitted with sensors and integrated with Oracle E-Business Suite, tracking every pole by order, stage, machine, scrap and time across six factories. The schedule was reordered to cut multi-hour changeovers.\", \"fig\": \"Welding found as the true bottleneck. Inventory prediction added so purchasing never stalled the line.\"}, {\"t\": \"Payroll report rebuild\", \"ind\": \"Manufacturing\", \"fam\": [\"B\", \"C\"], \"codes\": \"B3 C4\", \"body\": \"Rebuilt the payroll report for more than 10,000 employees, matched to historical figures to the halalah, and added Oracle BI Publisher bursting to email payslips instead of printing and hand-delivering them.\", \"fig\": \"From 18 hours to 16 seconds.\"}, {\"t\": \"750,000 policies in one day\", \"ind\": \"Insurance\", \"fam\": [\"D\"], \"codes\": \"D2\", \"body\": \"Set up the upload interface to Najm and ran the load in parallel across 25 machines over a weekend.\", \"fig\": \"More than 750,000 motor policies uploaded under a single-day deadline.\"}, {\"t\": \"Independent hospital financial audit\", \"ind\": \"Healthcare\", \"fam\": [\"C\"], \"codes\": \"C3\", \"body\": \"A financial audit of a hospital treating work and industrial injuries under GOSI cooperation. Contracts and payments revised, and billing and controlled-substance handling irregularities surfaced.\", \"fig\": \"An estimated 250 million SAR in unbilled and improperly handled amounts recovered.\"}, {\"t\": \"Payments licensing architecture\", \"ind\": \"Payments\", \"fam\": [\"D\"], \"codes\": \"D3\", \"body\": \"Authored the infrastructure, security and data-flow architecture and the evidence package for a payments platform.\", \"fig\": \"Used to pass the SAMA technical audit and secure the financial services licence and investment.\"}], \"REGS\": [{\"id\": \"sama\", \"abbr\": \"SAMA\", \"name\": \"Saudi Central Bank\", \"work\": \"Insurance regulation, the price aggregator, payments licensing\"}, {\"id\": \"zatca\", \"abbr\": \"ZATCA\", \"name\": \"Zakat, Tax and Customs Authority\", \"work\": \"Phase 2 e-invoicing\"}, {\"id\": \"nphies\", \"abbr\": \"NPHIES\", \"name\": \"National Platform for Health Insurance Exchange Services\", \"work\": \"Health insurance platform integration\"}, {\"id\": \"sfda\", \"abbr\": \"SFDA\", \"name\": \"Saudi Food and Drug Authority\", \"work\": \"Food safety, with HACCP and ISO 22000\"}, {\"id\": \"gosi\", \"abbr\": \"GOSI\", \"name\": \"General Organization for Social Insurance\", \"work\": \"Work-injury contracts and audit\"}, {\"id\": \"najm\", \"abbr\": \"Najm\", \"name\": \"Najm for Insurance Services\", \"work\": \"Claims data capture and mass policy upload\"}, {\"id\": \"taqdeer\", \"abbr\": \"Taqdeer\", \"name\": \"Taqdeer\", \"work\": \"Vehicle damage estimation\"}, {\"id\": \"sdaia\", \"abbr\": \"PDPL\", \"name\": \"Personal Data Protection Law, SDAIA\", \"work\": \"Personal data protection\"}]}, ar: {\"FAMILIES\": [{\"id\": \"A\", \"name\": \"\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0627\u0644\u0623\u062a\u0645\u062a\u0629\", \"line\": \"\u0648\u0643\u0644\u0627\u0621 \u0648\u0645\u0633\u0627\u0639\u062f\u0648\u0646 \u064a\u062a\u0648\u0644\u0651\u0648\u0646 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0631\u0648\u062a\u064a\u0646\u064a \u0639\u0646 \u0641\u0631\u064a\u0642\u0643\u060c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0635\u0644\u0643 \u0645\u0646 \u0623\u0631\u0636 \u0627\u0644\u0645\u0635\u0646\u0639.\"}, {\"id\": \"B\", \"name\": \"\u0628\u0646\u0627\u0621 \u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u062a\u0634\u063a\u064a\u0644\u0647\u0627\", \"line\": \"\u0623\u0646\u0638\u0645\u0629 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0637\u0631\u064a\u0642\u0629 \u0639\u0645\u0644 \u0634\u0631\u0643\u062a\u0643 \u0627\u0644\u0641\u0639\u0644\u064a\u0629\u060c \u0645\u0633\u062a\u0636\u0627\u0641\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0648\u062a\u064f\u0642\u062f\u064e\u0651\u0645 \u0648\u062d\u062f\u0629\u064b \u062a\u0644\u0648 \u0627\u0644\u0623\u062e\u0631\u0649.\"}, {\"id\": \"C\", \"name\": \"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\", \"line\": \"\u0646\u0646\u0642\u0644\u0647\u0627 \u0648\u0646\u062f\u0645\u062c\u0647\u0627 \u0648\u0646\u0637\u0627\u0628\u0642\u0647\u0627 \u0648\u0646\u062c\u0639\u0644\u0647\u0627 \u0623\u0633\u0631\u0639.\"}, {\"id\": \"D\", \"name\": \"\u0627\u0644\u0625\u0646\u0642\u0627\u0630 \u0648\u0627\u0644\u0627\u0645\u062a\u062b\u0627\u0644\", \"line\": \"\u0645\u0634\u0627\u0631\u064a\u0639 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0639\u0646 \u0625\u0646\u0647\u0627\u0626\u0647\u0627\u060c \u0648\u0645\u0648\u0627\u0639\u064a\u062f \u062d\u062f\u0651\u062f\u062a\u0647\u0627 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629.\"}, {\"id\": \"E\", \"name\": \"\u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629\", \"line\": \"\u0642\u064a\u0627\u062f\u0629 \u062a\u0642\u0646\u064a\u0629 \u0645\u062a\u0645\u0631\u0651\u0633\u0629 \u0644\u0645\u0646\u0638\u0648\u0645\u062a\u0643 \u062f\u0648\u0646 \u0627\u0644\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u062a\u0639\u064a\u064a\u0646 \u0628\u062f\u0648\u0627\u0645 \u0643\u0627\u0645\u0644.\"}], \"SERVICES\": [{\"code\": \"A1\", \"fam\": \"A\", \"title\": \"\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\", \"short\": \"\u0648\u0643\u0644\u0627\u0621 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u0648\u064a\u0644\u062e\u0651\u0635\u0648\u0646 \u0648\u064a\u0624\u0631\u0634\u0641\u0648\u0646 \u0648\u064a\u0635\u064a\u063a\u0648\u0646.\", \"what\": \"\u0648\u0643\u0644\u0627\u0621 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u0648\u064a\u0644\u062e\u0651\u0635\u0648\u0646 \u0648\u064a\u0624\u0631\u0634\u0641\u0648\u0646 \u0648\u064a\u0635\u064a\u063a\u0648\u0646 \u0627\u0644\u0645\u0633\u0648\u062f\u0627\u062a. \u0645\u0628\u0646\u064a\u0651\u0648\u0646 \u0639\u0644\u0649 \u0623\u062a\u0645\u062a\u0629 \u0633\u064a\u0631 \u0627\u0644\u0639\u0645\u0644 \u0648\u0648\u0627\u062c\u0647\u0627\u062a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0644\u063a\u0648\u064a\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 (LLM)\u060c \u0645\u0639 \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0623\u062f\u0648\u0627\u062a \u0634\u0647\u0631\u064a\u0629 \u0646\u062f\u064a\u0631\u0647\u0627 \u0648\u0646\u0631\u0641\u0639 \u0644\u0643 \u062a\u0642\u0627\u0631\u064a\u0631\u0647\u0627.\", \"who\": \"\u0641\u0631\u0642 \u062a\u0647\u062f\u0631 \u0633\u0627\u0639\u0627\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0627\u062a \u0648\u0641\u0631\u0632 \u0627\u0644\u0628\u0631\u064a\u062f \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a.\", \"receive\": [\"\u0645\u0633\u0627\u0631\u0627\u062a \u0639\u0645\u0644 \u0645\u062d\u062f\u0651\u062f\u0629: \u0645\u0648\u062c\u0632 \u0635\u0628\u0627\u062d\u064a\u060c \u0648\u0642\u0627\u0626\u0645\u0629 \u0645\u062a\u0627\u0628\u0639\u0629\u060c \u0648\u0641\u0631\u0632 \u0644\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0648\u0627\u0631\u062f\u060c \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0644\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a\", \"\u0625\u062c\u0631\u0627\u0621 \u0645\u0643\u062a\u0648\u0628 \u0648\u0633\u062c\u0644\u0627\u062a \u062a\u0634\u063a\u064a\u0644 \u0648\u0628\u0646\u062f \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0644\u0643\u0644\u064d\u0651 \u0645\u0646\u0647\u0627\"], \"proof\": [\"\u0642\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u064a\u0648\u0645\u064a \u0641\u064a \u0639\u0645\u0644\u064a\u0627\u062a\u0646\u0627 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629.\"]}, {\"code\": \"A2\", \"fam\": \"A\", \"title\": \"\u0645\u0633\u0627\u0639\u062f\u0648 \u0630\u0643\u0627\u0621 \u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0644\u0641\u0631\u0642\", \"short\": \"\u0645\u0633\u0627\u0639\u062f \u064a\u062d\u0641\u0638 \u062e\u064a\u0648\u0637 \u0627\u0644\u0639\u0645\u0644 \u0648\u064a\u064f\u0637\u0644\u0639 \u0627\u0644\u0645\u0627\u0644\u0643 \u0643\u0644 \u0635\u0628\u0627\u062d.\", \"what\": \"\u0646\u064f\u0639\u062f\u0651 \u0648\u0646\u0634\u063a\u0651\u0644 \u0645\u0633\u0627\u0639\u062f \u0630\u0643\u0627\u0621 \u0627\u0635\u0637\u0646\u0627\u0639\u064a \u064a\u062d\u0641\u0638 \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0641\u0631\u064a\u0642 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a\u060c \u0648\u064a\u0642\u062f\u0651\u0645 \u0644\u0644\u0645\u0627\u0644\u0643 \u0645\u0648\u062c\u0632\u064b\u0627 \u0643\u0644 \u0635\u0628\u0627\u062d.\", \"who\": \"\u0627\u0644\u0645\u0624\u0633\u0633\u0648\u0646 \u0648\u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0648\u0646 \u0648\u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0627\u0644\u0645\u062b\u0642\u0644\u0629 \u0628\u062e\u064a\u0648\u0637 \u0639\u0645\u0644 \u0643\u062b\u064a\u0631\u0629.\", \"receive\": [\"\u0645\u0633\u0627\u0639\u062f \u062e\u0627\u0635 \u064a\u0639\u0645\u0644 \u0641\u0639\u0644\u064a\u064b\u0627\", \"\u0645\u0648\u062c\u0632 \u0635\u0628\u0627\u062d\u064a\", \"\u0645\u0644\u0641\u0627\u062a \u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639\", \"\u0625\u062c\u0631\u0627\u0621 \u0645\u0643\u062a\u0648\u0628 \u0642\u0635\u064a\u0631 \u064a\u062a\u0628\u0639\u0647 \u0627\u0644\u0641\u0631\u064a\u0642\"], \"proof\": []}, {\"code\": \"A3\", \"fam\": \"A\", \"title\": \"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0635\u0646\u0627\u0639\u064a\u0629 \u0648\u0625\u0646\u062a\u0631\u0646\u062a \u0627\u0644\u0623\u0634\u064a\u0627\u0621 (IoT)\", \"short\": \"\u062d\u0633\u0627\u0633\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0622\u0644\u0627\u062a\u060c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062f\u062e\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0645\u0628\u0627\u0634\u0631\u0629.\", \"what\": \"\u062d\u0633\u0627\u0633\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0622\u0644\u0627\u062a\u060c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062a\u062f\u0641\u0642 \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0624\u0633\u0633\u0629\u060c \u0648\u062c\u062f\u0648\u0644 \u0625\u0646\u062a\u0627\u062c \u064a\u064f\u0639\u0627\u062f \u062a\u0631\u062a\u064a\u0628\u0647 \u062d\u0648\u0644 \u0639\u0646\u0642 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a.\", \"who\": \"\u0645\u0635\u0646\u0651\u0639\u0648\u0646 \u064a\u062e\u0637\u0651\u0637\u0648\u0646 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u062f\u0648\u0646 \u0623\u0646 \u064a\u0639\u0631\u0641\u0648\u0627 \u0623\u064a\u0646 \u064a\u0636\u064a\u0639 \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u062f \u0641\u0639\u0644\u064b\u0627.\", \"receive\": [], \"proof\": [\"\u062a\u062c\u0647\u064a\u0632 \u0622\u0644\u0627\u062a \u0625\u0646\u062a\u0627\u062c \u062b\u0642\u064a\u0644\u0629 \u0641\u064a \u0633\u062a\u0629 \u0645\u0635\u0627\u0646\u0639 \u0628\u0627\u0644\u062d\u0633\u0627\u0633\u0627\u062a \u0648\u0631\u0628\u0637\u0647\u0627 \u0628\u0640 Oracle E-Business Suite\u060c \u0644\u062a\u062a\u0628\u0651\u0639 \u0643\u0644 \u0639\u0645\u0648\u062f \u062d\u0633\u0628 \u0623\u0645\u0631 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0648\u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0648\u0627\u0644\u0622\u0644\u0629 \u0648\u0627\u0644\u0647\u062f\u0631 \u0648\u0627\u0644\u0648\u0642\u062a. \u062a\u0628\u064a\u0651\u0646 \u0623\u0646 \u0627\u0644\u0644\u062d\u0627\u0645 \u0647\u0648 \u0639\u0646\u0642 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u060c \u0648\u0623\u064f\u0636\u064a\u0641 \u0627\u0644\u062a\u0646\u0628\u0624 \u0628\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u062d\u062a\u0649 \u0644\u0627 \u062a\u062a\u0633\u0628\u0628 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0641\u064a \u062a\u0648\u0642\u0641 \u062e\u0637 \u0627\u0644\u0625\u0646\u062a\u0627\u062c.\"]}, {\"code\": \"B1\", \"fam\": \"B\", \"title\": \"\u0623\u0646\u0638\u0645\u0629 \u0623\u0639\u0645\u0627\u0644 \u0646\u0628\u0646\u064a\u0647\u0627 \u0648\u0646\u0633\u062a\u0636\u064a\u0641\u0647\u0627\", \"short\": \"\u0646\u0638\u0627\u0645 \u0648\u0627\u062d\u062f \u0645\u0633\u062a\u0636\u0627\u0641 \u062d\u0648\u0644 \u0633\u064a\u0631 \u0639\u0645\u0644\u0643 \u0627\u0644\u0641\u0639\u0644\u064a\u060c \u064a\u064f\u0633\u0644\u064e\u0651\u0645 \u0648\u062d\u062f\u0629\u064b \u062a\u0644\u0648 \u0627\u0644\u0623\u062e\u0631\u0649.\", \"what\": \"\u0646\u0638\u0627\u0645 \u0645\u0628\u0646\u064a \u0639\u0644\u0649 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u064a\u0639\u0645\u0644 \u0628\u0647\u0627 \u0641\u0631\u064a\u0642\u0643 \u0641\u0639\u0644\u064b\u0627\u060c \u064a\u064f\u0633\u0644\u064e\u0651\u0645 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0648\u062d\u062f\u0627\u062a \u0634\u0647\u0631\u064a\u0629: \u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0623\u0648\u0644\u064b\u0627\u060c \u062b\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0648\u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629. \u0645\u0633\u062a\u0636\u0627\u0641 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0633\u062d\u0627\u0628\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0628\u0645\u0633\u062a\u0623\u062c\u0631 \u0645\u0633\u062a\u0642\u0644 \u0644\u0643\u0644 \u0639\u0645\u064a\u0644\u060c \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0623\u064a \u0648\u0642\u062a.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u0645\u0646 10 \u0625\u0644\u0649 100 \u0645\u0648\u0638\u0641 \u062a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0648\u062e\u0645\u0633\u0629 \u0627\u0634\u062a\u0631\u0627\u0643\u0627\u062a \u0644\u0627 \u064a\u062a\u0648\u0644\u0651\u0627\u0647\u0627 \u0623\u062d\u062f.\", \"receive\": [\"\u0648\u062d\u062f\u0629 \u0623\u0648\u0644\u0649 \u0639\u0627\u0645\u0644\u0629 \u062e\u0644\u0627\u0644 \u0623\u0633\u0627\u0628\u064a\u0639\", \"\u0627\u0634\u062a\u0631\u0627\u0643 \u0634\u0647\u0631\u064a \u0644\u0643\u0644 \u0648\u062d\u062f\u0629\", \"\u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0635\u062f\u064a\u0631 \u0625\u0644\u0649 Excel \u0641\u064a \u0623\u064a \u0648\u0642\u062a\", \"\u0646\u0633\u062e \u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0643\u0644 \u0644\u064a\u0644\u0629\"], \"proof\": [\"\u0646\u0638\u0627\u0645 \u0645\u0633\u062a\u0636\u0627\u0641 \u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0644\u0634\u0631\u0643\u0629 \u062a\u062c\u0627\u0631\u0629 \u0636\u064a\u0627\u0641\u0629 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636\u060c 2026.\"]}, {\"code\": \"B2\", \"fam\": \"B\", \"title\": \"\u0645\u062d\u0631\u0651\u0643\u0627\u062a \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0648\u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\", \"short\": \"\u0627\u0639\u0631\u0641 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u0644\u0639\u0645\u0644 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0633\u0639\u0651\u0631\u0647.\", \"what\": \"\u0627\u0639\u0631\u0641 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u0644\u0639\u0645\u0644 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0633\u0639\u0651\u0631\u0647. \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062d\u0633\u0628 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631\u060c \u0648\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0644\u0627\u0646\u062d\u0631\u0627\u0641 \u062a\u062e\u0628\u0631\u0643 \u0645\u062a\u0649 \u062a\u0628\u062a\u0639\u062f \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0639\u0646 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0633\u0639\u0651\u0631\u0629.\", \"who\": \"\u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0648\u062a\u0648\u0631\u064a\u062f \u0627\u0644\u0636\u064a\u0627\u0641\u0629 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0639\u060c \u0648\u0623\u064a \u0639\u0645\u0644 \u0642\u0627\u0626\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u064a\u062e\u0633\u0631 \u0627\u0644\u0645\u0627\u0644 \u0628\u064a\u0646 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u062a\u0633\u0644\u064a\u0645.\", \"receive\": [\"\u0623\u062f\u0627\u0629 \u0644\u0628\u0646\u0627\u0621 \u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631\", \"\u062a\u062a\u0628\u0651\u0639 \u0627\u0646\u062d\u0631\u0627\u0641 \u0627\u0644\u062a\u0643\u0644\u0641\u0629\", \"\u0646\u0633\u062e \u0644\u0644\u0639\u0645\u064a\u0644 \u0628\u0635\u064a\u063a\u0629 PDF \u0648Excel \u0648\u0644\u0644\u0637\u0628\u0627\u0639\u0629\u060c \u0639\u0644\u0649 \u062a\u0631\u0648\u064a\u0633\u062a\u0643 \u0627\u0644\u062e\u0627\u0635\u0629\"], \"proof\": [\"\u0645\u062d\u0631\u0651\u0643 \u062a\u0633\u0639\u064a\u0631 \u062a\u0623\u0645\u064a\u0646 \u0627\u0646\u062e\u0641\u0636 \u0641\u064a\u0647 \u0632\u0645\u0646 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 \u0645\u0646 42 \u062b\u0627\u0646\u064a\u0629 \u0625\u0644\u0649 0.07 \u062b\u0627\u0646\u064a\u0629.\", \"\u0646\u0638\u0627\u0645 \u0639\u0631\u0648\u0636 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0636\u064a\u0627\u0641\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a B1.\"]}, {\"code\": \"B3\", \"fam\": \"B\", \"title\": \"\u0644\u0648\u062d\u0627\u062a \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\", \"short\": \"\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u064a\u0642\u0631\u0624\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u0643 \u0643\u0644 \u0635\u0628\u0627\u062d\u060c \u062f\u0648\u0646 \u0623\u064a \u0625\u062f\u062e\u0627\u0644 \u064a\u062f\u0648\u064a.\", \"what\": \"\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u064a\u0642\u0631\u0624\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u0643 \u0643\u0644 \u0635\u0628\u0627\u062d. \u0623\u0631\u0642\u0627\u0645 \u0645\u0633\u062d\u0648\u0628\u0629 \u0645\u0646 \u0623\u0646\u0638\u0645\u062a\u0643 \u0645\u0628\u0627\u0634\u0631\u0629\u060c \u062f\u0648\u0646 \u0623\u064a \u0625\u062f\u062e\u0627\u0644 \u064a\u062f\u0648\u064a.\", \"who\": \"\u0645\u0644\u0651\u0627\u0643 \u0648\u0645\u062f\u064a\u0631\u0648\u0646 \u062a\u0635\u0644\u0647\u0645 \u0623\u0631\u0642\u0627\u0645\u0647\u0645 \u0645\u062a\u0623\u062e\u0631\u0629\u060c \u0623\u0648 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u0634\u062e\u0627\u0635 \u0644\u0627 \u064a\u062a\u0641\u0642\u0648\u0646.\", \"receive\": [\"\u0644\u0648\u062d\u0627\u062a \u0645\u0624\u0634\u0631\u0627\u062a \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0645\u062c\u062f\u0648\u0644\u0629 \u0639\u0644\u0649 Oracle Business Intelligence \u0623\u0648 Qlik Sense \u0623\u0648 \u0635\u0641\u062d\u0629 \u0648\u064a\u0628 \u0645\u062e\u0635\u0651\u0635\u0629\", \"\u0645\u0635\u062f\u0631 \u0643\u0644 \u0631\u0642\u0645 \u0645\u0648\u062b\u0651\u0642 \u0643\u062a\u0627\u0628\u064a\u064b\u0627\"], \"proof\": [\"\u0644\u0648\u062d\u0629 \u0645\u0624\u0634\u0631\u0627\u062a \u062a\u063a\u0637\u064a \u0633\u062a\u0629 \u0645\u0635\u0627\u0646\u0639.\", \"\u062a\u0642\u0631\u064a\u0631 \u0643\u0634\u0641 \u062d\u0633\u0627\u0628 \u0639\u0645\u0644\u0627\u0621 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 \u0633\u0627\u0639\u062a\u064a\u0646 \u0625\u0644\u0649 \u0633\u0628\u0639 \u062b\u0648\u0627\u0646\u064d.\", \"\u062a\u0642\u0631\u064a\u0631 \u0631\u0648\u0627\u062a\u0628 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 10,000 \u0645\u0648\u0638\u0641 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 18 \u0633\u0627\u0639\u0629 \u0625\u0644\u0649 16 \u062b\u0627\u0646\u064a\u0629.\"]}, {\"code\": \"B4\", \"fam\": \"B\", \"title\": \"\u0627\u0644\u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0648\u0627\u0644\u0641\u0648\u062a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\", \"short\": \"\u0627\u062c\u0639\u0644 \u0623\u0646\u0638\u0645\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u062a\u062a\u062d\u062f\u062b \u0645\u0639 \u0628\u0639\u0636\u0647\u0627.\", \"what\": \"\u0646\u062c\u0639\u0644 \u0623\u0646\u0638\u0645\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u062a\u062a\u062d\u062f\u062b \u0645\u0639 \u0628\u0639\u0636\u0647\u0627: \u0627\u0644\u0645\u062d\u0627\u0633\u0628\u0629 \u0648\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0646\u0642\u0627\u0637 \u0627\u0644\u0628\u064a\u0639 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a\u060c \u0648\u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u0627\u0644\u0641\u0648\u062a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0645\u0639 \u0647\u064a\u0626\u0629 \u0627\u0644\u0632\u0643\u0627\u0629 \u0648\u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0648\u0627\u0644\u062c\u0645\u0627\u0631\u0643 (ZATCA).\", \"who\": \"\u0623\u064a \u0634\u0631\u0643\u0629 \u0644\u062f\u064a\u0647\u0627 \u0646\u0638\u0627\u0645\u0627\u0646 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0648\u0645\u0648\u0638\u0641 \u064a\u0639\u064a\u062f \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u064a\u0646\u0647\u0645\u0627.\", \"receive\": [\"\u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0648\u0627\u062c\u0647\u0627\u062a \u0628\u0631\u0645\u062c\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a (APIs) \u0623\u0648 Webhooks \u0623\u0648 \u062a\u062f\u0641\u0642\u0627\u062a \u0623\u062d\u062f\u0627\u062b Apache Kafka\", \"\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u062a\u0648\u062b\u064a\u0642\", \"\u062a\u0642\u0631\u064a\u0631 \u0645\u0637\u0627\u0628\u0642\u0629\"], \"proof\": [\"\u0623\u0631\u0628\u0639\u0629 \u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0645\u0624\u0633\u0633\u064a\u0629 \u0633\u064f\u0644\u0651\u0645 \u0643\u0644\u064c\u0651 \u0645\u0646\u0647\u0627 \u0641\u064a \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f\u060c \u0628\u0639\u062f \u0623\u0646 \u0623\u062e\u0641\u0642 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0641\u064a\u0647\u0627 \u0644\u0623\u0634\u0647\u0631.\", \"\u062a\u0643\u0627\u0645\u0644 \u0628\u064a\u0646 \u0646\u0638\u0627\u0645 \u062a\u0623\u0645\u064a\u0646 \u0623\u0633\u0627\u0633\u064a \u0648Oracle E-Business Suite \u0623\u064f\u0639\u064a\u062f \u0628\u0646\u0627\u0624\u0647 \u0639\u0627\u0645 2012 \u0648\u064a\u0639\u0645\u0644 \u062f\u0648\u0646 \u062a\u0639\u062f\u064a\u0644 \u0641\u064a \u0628\u064a\u0626\u0629 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0645\u0646\u0630 \u0630\u0644\u0643 \u0627\u0644\u062d\u064a\u0646.\", \"\u062a\u0643\u0627\u0645\u0644 \u0645\u0639 \u0646\u062c\u0645 \u0648\u064a\u0642\u064a\u0646 \u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a.\"]}, {\"code\": \"C1\", \"fam\": \"C\", \"title\": \"\u062a\u0631\u062d\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062f\u0648\u0646 \u062a\u0648\u0642\u0641\", \"short\": \"\u0627\u0646\u062a\u0642\u0644 \u0645\u0646 \u0646\u0638\u0627\u0645 \u0642\u062f\u064a\u0645 \u062f\u0648\u0646 \u0623\u0646 \u062a\u062a\u0648\u0642\u0641 \u0623\u0639\u0645\u0627\u0644\u0643.\", \"what\": \"\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0646 \u0646\u0638\u0627\u0645 \u0642\u062f\u064a\u0645 \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u062c\u062f\u064a\u062f \u062f\u0648\u0646 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0639\u0645\u0644\u060c \u0648\u062f\u0648\u0646 \u062f\u0641\u0639 \u0631\u0633\u0648\u0645 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0644\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u0633\u0627\u0628\u0642.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u062a\u0633\u062a\u0628\u062f\u0644 \u0646\u0638\u0627\u0645\u0647\u0627 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u060c \u0623\u0648 \u064a\u0639\u064a\u0642\u0647\u0627 \u0645\u0648\u0631\u0651\u062f \u064a\u0637\u0644\u0628 \u0645\u0642\u0627\u0628\u0644\u064b\u0627 \u0644\u0625\u0639\u0627\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0647\u0627 \u0625\u0644\u064a\u0647\u0627.\", \"receive\": [\"\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u0631\u0628\u0637\", \"\u0646\u0635\u0648\u0635 \u0627\u0644\u062a\u0631\u062d\u064a\u0644 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629\", \"\u0645\u0637\u0627\u0628\u0642\u0629 \u062d\u062a\u0649 \u0622\u062e\u0631 \u0647\u0644\u0644\u0629\", \"\u062e\u0637\u0629 \u0627\u0646\u062a\u0642\u0627\u0644 \u0648\u062e\u0637\u0629 \u062a\u0631\u0627\u062c\u0639\"], \"proof\": [\"\u062a\u0631\u062d\u064a\u0644 \u0646\u0638\u0627\u0645 \u062a\u0623\u0645\u064a\u0646 \u0642\u062f\u064a\u0645 \u0628\u0642\u0631\u0627\u0621\u0629 \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0645\u0628\u0627\u0634\u0631\u0629\u060c \u0648\u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u0633\u0627\u0628\u064a\u0639.\", \"\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0646\u0638\u0627\u0645 \u0623\u0633\u0627\u0633\u064a \u0644\u062f\u0649 \u0634\u0631\u0643\u0629 \u062a\u0623\u0645\u064a\u0646 \u062a\u0643\u0627\u0641\u0644\u064a.\"]}, {\"code\": \"C2\", \"fam\": \"C\", \"title\": \"\u062a\u0648\u062d\u064a\u062f \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u0646\u0638\u064a\u0641\u0647\u0627\", \"short\": \"\u0639\u062f\u0629 \u0642\u0648\u0627\u0639\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0648 \u0641\u0631\u0648\u0639\u060c \u0645\u062f\u0645\u0648\u062c\u0629 \u0641\u064a \u0645\u062e\u0637\u0637 \u0648\u0627\u062d\u062f \u0646\u0638\u064a\u0641.\", \"what\": \"\u062f\u0645\u062c \u0639\u062f\u0629 \u0642\u0648\u0627\u0639\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0648 \u0641\u0631\u0648\u0639 \u0641\u064a \u0645\u062e\u0637\u0637 \u0648\u0627\u062d\u062f \u0646\u0638\u064a\u0641. \u062f\u0645\u062c \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0645\u0643\u0631\u0651\u0631\u064a\u0646. \u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062e\u062a\u0644\u0641 \u0631\u0645\u0648\u0632\u0647\u0627 \u0645\u0646 \u0641\u0631\u0639 \u0644\u0622\u062e\u0631.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u0646\u0645\u062a \u0628\u0625\u0636\u0627\u0641\u0629 \u0641\u0631\u0648\u0639 \u0623\u0648 \u0623\u0646\u0638\u0645\u0629 \u0623\u0648 \u0627\u0633\u062a\u062d\u0648\u0627\u0630\u0627\u062a\u060c \u0648\u0623\u0635\u0628\u062d \u0644\u062f\u064a\u0647\u0627 \u0627\u0644\u0639\u0645\u064a\u0644 \u0646\u0641\u0633\u0647 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a.\", \"receive\": [], \"proof\": [\"\u062a\u0648\u062d\u064a\u062f \u062b\u0644\u0627\u062b \u0642\u0648\u0627\u0639\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0623\u0645\u064a\u0646 \u0642\u062f\u064a\u0645\u0629 \u0641\u064a \u0645\u062e\u0637\u0637 \u0648\u0627\u062d\u062f \u0639\u0644\u0649 \u064a\u062f \u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u062d\u062f \u062e\u0644\u0627\u0644 \u0639\u0627\u0645 \u062a\u0642\u0631\u064a\u0628\u064b\u0627\u060c \u0645\u0639 \u062a\u0628\u0639\u064a\u0627\u062a \u062a\u0635\u0644 \u0625\u0644\u0649 \u0633\u0628\u0639\u0629 \u0645\u0633\u062a\u0648\u064a\u0627\u062a. \u0643\u0627\u0646 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0642\u062f \u062d\u0643\u0645 \u0628\u0627\u0633\u062a\u062d\u0627\u0644\u0629 \u0630\u0644\u0643\u060c \u0648\u0642\u062f\u0651\u0645 \u0639\u0631\u0636\u064b\u0627 \u0628\u0642\u064a\u0645\u0629 8 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a \u0644\u062a\u062c\u0645\u064a\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0628\u062f\u0621 \u0645\u0646 \u062c\u062f\u064a\u062f.\"]}, {\"code\": \"C3\", \"fam\": \"C\", \"title\": \"\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0648\u0627\u0644\u062a\u062f\u0642\u064a\u0642 \u0627\u0644\u0645\u0627\u0644\u064a \u0644\u0644\u0623\u0646\u0638\u0645\u0629\", \"short\": \"\u0627\u0639\u0631\u0641 \u0623\u064a\u0646 \u0630\u0647\u0628 \u0627\u0644\u0645\u0627\u0644.\", \"what\": \"\u0646\u0643\u062a\u0634\u0641 \u0623\u064a\u0646 \u0630\u0647\u0628 \u0627\u0644\u0645\u0627\u0644. \u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0645\u0639 \u0627\u0644\u0645\u0642\u0628\u0648\u0636\u0627\u062a\u060c \u0648\u0627\u0644\u0639\u0642\u0648\u062f \u0645\u0639 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a\u060c \u0648\u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0645\u0639 \u0627\u0644\u0648\u062b\u0627\u0626\u0642.\", \"who\": \"\u0641\u0631\u0642 \u0645\u0627\u0644\u064a\u0629 \u062a\u062e\u062a\u0644\u0641 \u0623\u0646\u0638\u0645\u062a\u0647\u0627 \u0648\u062f\u0641\u0627\u062a\u0631\u0647\u0627\u060c \u0648\u0645\u0644\u0651\u0627\u0643 \u064a\u0634\u062a\u0628\u0647\u0648\u0646 \u0641\u064a \u062a\u0633\u0631\u0651\u0628 \u0645\u0627\u0644\u064a.\", \"receive\": [], \"proof\": [\"\u062d\u0644\u0651 \u0641\u0631\u0642 \u0628\u0642\u064a\u0645\u0629 300 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0633\u0639\u0648\u062f\u064a \u0628\u064a\u0646 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0648\u0627\u0644\u0645\u0642\u0628\u0648\u0636\u0627\u062a \u0641\u064a 26 \u062b\u0627\u0646\u064a\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0625\u062c\u0631\u0627\u0621\u0627\u062a Oracle API\u060c \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0645\u0647\u0645\u0629 \u0627\u0642\u062a\u0631\u062d\u0647\u0627 \u0645\u0648\u0631\u0651\u062f \u0644\u0645\u062f\u0629 \u0634\u0647\u0631 \u0628\u0623\u0631\u0628\u0639\u0629 \u0623\u0634\u062e\u0627\u0635.\", \"\u062a\u062f\u0642\u064a\u0642 \u0645\u0633\u062a\u0634\u0641\u0649 \u0636\u0645\u0646 \u0639\u0642\u0648\u062f \u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0645\u0639 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u062a\u0623\u0645\u064a\u0646\u0627\u062a \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 (GOSI) \u0643\u0634\u0641 \u0645\u0628\u0627\u0644\u063a \u063a\u064a\u0631 \u0645\u0641\u0648\u062a\u0631\u0629 \u0623\u0648 \u0623\u064f\u0633\u064a\u0621 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647\u0627 \u062a\u064f\u0642\u062f\u064e\u0651\u0631 \u0628\u0640 250 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644.\"]}, {\"code\": \"C4\", \"fam\": \"C\", \"title\": \"\u0623\u062f\u0627\u0621 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0625\u0646\u0642\u0627\u0630\u0647\u0627\", \"short\": \"\u0627\u062c\u0639\u0644 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0628\u0637\u064a\u0626\u0629 \u0633\u0631\u064a\u0639\u0629 \u062f\u0648\u0646 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627.\", \"what\": \"\u0646\u062c\u0639\u0644 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0628\u0637\u064a\u0626\u0629 \u0633\u0631\u064a\u0639\u0629 \u062f\u0648\u0646 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627.\", \"who\": \"\u0641\u0631\u0642 \u062a\u0646\u062a\u0638\u0631 \u062f\u0642\u0627\u0626\u0642 \u0623\u0648 \u0633\u0627\u0639\u0627\u062a \u0639\u0644\u0649 \u0634\u0627\u0634\u0627\u062a \u0648\u0639\u0645\u0644\u064a\u0627\u062a \u0631\u0641\u0639 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u064a\u064f\u0641\u062a\u0631\u0636 \u0623\u0646 \u062a\u0633\u062a\u063a\u0631\u0642 \u062b\u0648\u0627\u0646\u064a\u064e.\", \"receive\": [], \"proof\": [\"\u0631\u0641\u0639 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 25 \u062f\u0642\u064a\u0642\u0629 \u0644\u0644\u062f\u0641\u0639\u0629 \u0625\u0644\u0649 \u0623\u0642\u0644 \u0645\u0646 10 \u062b\u0648\u0627\u0646\u064d.\", \"\u0645\u062d\u0631\u0651\u0643 \u062a\u0633\u0639\u064a\u0631 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 42 \u062b\u0627\u0646\u064a\u0629 \u0625\u0644\u0649 0.07 \u062b\u0627\u0646\u064a\u0629\u060c \u0641\u0627\u0646\u062a\u0642\u0644\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 32 \u0645\u0646 34 \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0639\u0644\u0649 \u0645\u0646\u0635\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (SAMA)\u060c \u062d\u064a\u062b \u064a\u062a\u0635\u062f\u0651\u0631 \u0627\u0644\u0623\u0633\u0631\u0639 \u0627\u0633\u062a\u062c\u0627\u0628\u0629.\", \"\u062a\u0642\u0631\u064a\u0631 \u0631\u0648\u0627\u062a\u0628 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 18 \u0633\u0627\u0639\u0629 \u0625\u0644\u0649 16 \u062b\u0627\u0646\u064a\u0629.\"]}, {\"code\": \"D1\", \"fam\": \"D\", \"title\": \"\u0625\u0646\u0642\u0627\u0630 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u062a\u0639\u062b\u0631\u0629 \u0648\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0627\u0644\u0645\u0648\u0631\u0651\u062f\u064a\u0646\", \"short\": \"\u0646\u062a\u0633\u0644\u0651\u0645 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0639\u0646 \u0625\u0646\u0647\u0627\u0626\u0647.\", \"what\": \"\u0646\u062a\u0633\u0644\u0651\u0645 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0639\u0646 \u0625\u0646\u0647\u0627\u0626\u0647. \u0646\u0642\u0631\u0623 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0623\u0633\u0648\u062f\u060c \u0648\u0646\u062c\u062f \u0627\u0644\u0639\u0627\u0626\u0642 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u060c \u0648\u0646\u0633\u0644\u0651\u0645.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u062f\u0641\u0639\u062a \u0644\u0645\u0648\u0631\u0651\u062f \u0643\u0628\u064a\u0631 \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0644\u062f\u064a\u0647\u0627 \u0634\u064a\u0621 \u064a\u0639\u0645\u0644.\", \"receive\": [], \"proof\": [\"\u0639\u0631\u0636 \u062a\u0648\u062d\u064a\u062f \u0628\u0642\u064a\u0645\u0629 8 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631 \u0627\u0633\u062a\u064f\u0628\u062f\u0644 \u0628\u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u062d\u062f\u060c \u0645\u0639 \u0633\u0644\u0627\u0645\u0629 \u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a.\", \"\u0623\u0631\u0628\u0639\u0629 \u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0633\u064f\u0644\u0651\u0645\u062a \u0628\u0639\u062f \u0623\u0646 \u0623\u0645\u0636\u0649 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0625\u0644\u0649 \u0633\u062a\u0629 \u0623\u0634\u0647\u0631 \u0639\u0644\u0649 \u0643\u0644\u064d\u0651 \u0645\u0646\u0647\u0627 \u062f\u0648\u0646 \u0646\u062a\u064a\u062c\u0629.\", \"\u0625\u0646\u0642\u0627\u0630 \u0625\u0637\u0644\u0627\u0642 \u0645\u062a\u0639\u062b\u0631 \u0644\u0646\u0638\u0627\u0645 \u0645\u0648\u0627\u0632\u0646\u0627\u062a \u062e\u0644\u0627\u0644 \u0623\u0633\u0628\u0648\u0639\u064a\u0646\u060c \u062f\u0648\u0646 \u062a\u0631\u062e\u064a\u0635 \u062a\u0643\u0627\u0645\u0644 \u0648\u0645\u0639 \u062a\u0633\u0644\u064a\u0645 \u0646\u0627\u0642\u0635.\"]}, {\"code\": \"D2\", \"fam\": \"D\", \"title\": \"\u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0641\u064a \u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629\", \"short\": \"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0637\u0644\u0628\u0647\u0627 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629\u060c \u0641\u064a \u0645\u0648\u0639\u062f\u0647\u0627.\", \"what\": \"\u0646\u0633\u0644\u0651\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0648 \u0627\u0644\u0623\u062f\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u0637\u0644\u0628\u0647\u0627 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629\u060c \u0641\u064a \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0630\u064a \u062a\u062d\u062f\u0651\u062f\u0647.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u062e\u0627\u0636\u0639\u0629 \u0644\u0644\u062a\u0646\u0638\u064a\u0645 \u0623\u0645\u0627\u0645\u0647\u0627 \u0645\u0648\u0639\u062f \u062b\u0627\u0628\u062a \u0648\u0645\u0648\u0631\u0651\u062f \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0647.\", \"receive\": [], \"proof\": [\"\u0631\u0641\u0639 \u0639\u0634\u0631 \u0633\u0646\u0648\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0641\u0631\u0648\u0639 \u0641\u064a \u0645\u0648\u0639\u062f \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u062e\u0644\u0627\u0644 \u0639\u0637\u0644\u0629 \u0646\u0647\u0627\u064a\u0629 \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u064a\u0627\u0645\u060c \u0628\u0639\u062f \u0623\u0646 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u0645\u0643\u0644\u0651\u0641.\", \"\u0631\u0641\u0639 \u0623\u0643\u062b\u0631 \u0645\u0646 750,000 \u0648\u062b\u064a\u0642\u0629 \u062a\u0623\u0645\u064a\u0646 \u0645\u0631\u0643\u0628\u0627\u062a \u0625\u0644\u0649 \u0646\u062c\u0645 \u0641\u064a \u0645\u0647\u0644\u0629 \u064a\u0648\u0645 \u0648\u0627\u062d\u062f\u060c \u0628\u0627\u0644\u062a\u0648\u0627\u0632\u064a \u0639\u0644\u0649 25 \u062c\u0647\u0627\u0632\u064b\u0627 \u062e\u0644\u0627\u0644 \u0639\u0637\u0644\u0629 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0623\u0633\u0628\u0648\u0639.\"]}, {\"code\": \"D3\", \"fam\": \"D\", \"title\": \"\u062d\u0632\u0645 \u0623\u062f\u0644\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0648\u0627\u0644\u0627\u0645\u062a\u062b\u0627\u0644\", \"short\": \"\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062d\u062a\u0627\u062c\u0647\u0627 \u0627\u0644\u062a\u062f\u0642\u064a\u0642\u060c \u0645\u0643\u062a\u0648\u0628\u0629 \u0644\u062a\u062c\u062a\u0627\u0632\u0647.\", \"what\": \"\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0628\u0646\u064a\u0629 \u0648\u0627\u0644\u0623\u0645\u0646 \u0648\u062a\u062f\u0641\u0642 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062d\u062a\u0627\u062c\u0647\u0627 \u0627\u0644\u062a\u062f\u0642\u064a\u0642\u060c \u0645\u0643\u062a\u0648\u0628\u0629 \u0644\u062a\u062c\u062a\u0627\u0632\u0647.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u062a\u062a\u0642\u062f\u0651\u0645 \u0628\u0637\u0644\u0628 \u062a\u0631\u062e\u064a\u0635 \u0623\u0648 \u062a\u0633\u062a\u0639\u062f \u0644\u062a\u062f\u0642\u064a\u0642 \u062a\u0642\u0646\u064a.\", \"receive\": [], \"proof\": [\"\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0648\u0627\u0644\u0623\u0645\u0646 \u0648\u062a\u062f\u0641\u0642 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0648\u062d\u0632\u0645\u0629 \u0627\u0644\u0623\u062f\u0644\u0629 \u0644\u0645\u0646\u0635\u0629 \u0645\u062f\u0641\u0648\u0639\u0627\u062a\u060c \u0627\u0633\u062a\u064f\u062e\u062f\u0645\u062a \u0644\u0627\u062c\u062a\u064a\u0627\u0632 \u0627\u0644\u062a\u062f\u0642\u064a\u0642 \u0627\u0644\u062a\u0642\u0646\u064a \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0648\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631.\"]}, {\"code\": \"D4\", \"fam\": \"D\", \"title\": \"\u0642\u0648\u0627\u0639\u062f \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0644 \u0648\u0627\u0644\u0631\u0642\u0627\u0628\u0629\", \"short\": \"\u0642\u0648\u0627\u0639\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u0646\u0638\u0627\u0645 \u062a\u0646\u0628\u0651\u0647 \u0625\u0644\u0649 \u0645\u0627 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0631\u0627\u062c\u0639\u0647 \u0634\u062e\u0635.\", \"what\": \"\u0642\u0648\u0627\u0639\u062f \u0645\u0646\u0637\u0642\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0646\u0638\u0627\u0645 \u062a\u0646\u0628\u0651\u0647 \u0625\u0644\u0649 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u064a\u0646\u0638\u0631 \u0641\u064a\u0647\u0627 \u0634\u062e\u0635.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a\u060c \u0648\u0623\u064a \u0639\u0645\u0644 \u064a\u0635\u0631\u0641 \u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0623\u0648 \u0645\u0628\u0627\u0644\u063a \u0645\u0633\u062a\u0631\u062f\u0629.\", \"receive\": [], \"proof\": [\"\u0645\u062c\u0645\u0648\u0639\u0629 \u0642\u0648\u0627\u0639\u062f \u0644\u0627\u062d\u062a\u064a\u0627\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u062a\u0631\u0635\u062f \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u062d\u0633\u0628 \u062a\u0648\u0642\u064a\u062a\u0647\u0627 \u0636\u0645\u0646 \u0645\u062f\u0629 \u0627\u0644\u0648\u062b\u064a\u0642\u0629\u060c \u0648\u062a\u0634\u0627\u0628\u0647 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a\u060c \u0648\u062a\u0642\u0627\u0631\u0628 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\u060c \u0648\u0627\u0644\u0623\u0637\u0631\u0627\u0641 \u0630\u0627\u062a \u0627\u0644\u0639\u0644\u0627\u0642\u0629\u060c \u0648\u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0642\u064a\u0645\u0629\u060c \u0648\u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0636\u0631\u0631 \u0641\u064a \u0627\u0644\u0642\u0637\u0639\u0629 \u0646\u0641\u0633\u0647\u0627. \u0643\u0634\u0641\u062a \u062d\u0627\u0644\u0627\u062a \u0627\u062d\u062a\u064a\u0627\u0644 \u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629.\"]}, {\"code\": \"E1\", \"fam\": \"E\", \"title\": \"\u0642\u0627\u0626\u062f \u062a\u0642\u0646\u064a \u0628\u062f\u0648\u0627\u0645 \u062c\u0632\u0626\u064a\", \"short\": \"\u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0645\u062a\u0645\u0631\u0651\u0633 \u064a\u062a\u0648\u0644\u0651\u0649 \u0645\u0646\u0638\u0648\u0645\u062a\u0643 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u062f\u0648\u0627\u0645 \u062c\u0632\u0626\u064a.\", \"what\": \"\u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0645\u062a\u0645\u0631\u0651\u0633 \u064a\u062a\u0648\u0644\u0651\u0649 \u0645\u0646\u0638\u0648\u0645\u062a\u0643 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u062f\u0648\u0627\u0645 \u062c\u0632\u0626\u064a: \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0648\u0627\u0644\u0645\u0648\u0631\u0651\u062f\u064a\u0646 \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0623\u0645\u0646 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629. \u0645\u0647\u0627\u0645 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a \u0644\u0644\u062a\u0642\u0646\u064a\u0629 (CTO) \u0623\u0648 \u0645\u062f\u064a\u0631 \u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u062f\u0648\u0646 \u0631\u0627\u062a\u0628 \u0628\u062f\u0648\u0627\u0645 \u0643\u0627\u0645\u0644.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u0645\u0646 10 \u0625\u0644\u0649 50 \u0645\u0648\u0638\u0641\u064b\u0627 \u0644\u0627 \u062a\u0628\u0631\u0651\u0631 \u062a\u0639\u064a\u064a\u0646 \u0631\u0626\u064a\u0633 \u062a\u0642\u0646\u064a\u0629 \u0628\u062f\u0648\u0627\u0645 \u0643\u0627\u0645\u0644\u060c \u0648\u064a\u0639\u0631\u0636 \u0639\u0644\u064a\u0647\u0627 \u0643\u0644 \u0645\u0648\u0631\u0651\u062f \u062e\u062f\u0645\u0627\u062a\u0647.\", \"receive\": [\"\u0634\u0647\u0631 \u062a\u0634\u062e\u064a\u0635 \u0645\u062f\u0641\u0648\u0639 \u064a\u0646\u062a\u0647\u064a \u0628\u062e\u0637\u0629 \u0645\u0643\u062a\u0648\u0628\u0629 \u0644\u0640 90 \u064a\u0648\u0645\u064b\u0627 \u064a\u0648\u0642\u0651\u0639\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u0643\", \"\u0625\u0634\u0631\u0627\u0641 \u0634\u0647\u0631\u064a \u0628\u0645\u0631\u0627\u062d\u0644 \u0645\u062d\u062f\u0651\u062f\u0629\", \"\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u062a\u062d\u062a \u0645\u0633\u0624\u0648\u0644\u064a\u062a\u0646\u0627 \u0645\u0639 \u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u0646\u0647\u0627\", \"\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0627\u0631 \u0645\u0648\u062b\u0651\u0642\u0629 \u0643\u062a\u0627\u0628\u064a\u064b\u0627\"], \"proof\": [\"\u0647\u0630\u0627 \u0634\u0643\u0644 \u0627\u0631\u062a\u0628\u0627\u0637 \u0642\u0627\u0626\u0645 \u062d\u0627\u0644\u064a\u064b\u0627 \u0645\u0639 \u0634\u0631\u0643\u0629 \u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636.\"]}, {\"code\": \"E2\", \"fam\": \"E\", \"title\": \"\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0648\u0631\u0651\u062f\u064a\u0646 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062f\u0639\u0627\u0621\u0627\u062a\u0647\u0645\", \"short\": \"\u062a\u062d\u0642\u0651\u0642 \u0645\u0645\u0627 \u064a\u062f\u0651\u0639\u064a\u0647 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0642\u0628\u0644 \u0623\u0646 \u062a\u0648\u0642\u0651\u0639.\", \"what\": \"\u0646\u062a\u062d\u0642\u0642 \u0645\u0645\u0627 \u064a\u062f\u0651\u0639\u064a\u0647 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0642\u0628\u0644 \u0623\u0646 \u062a\u0648\u0642\u0651\u0639. \u0643\u0644 \u0627\u062f\u0639\u0627\u0621 \u064a\u064f\u062e\u062a\u0628\u0631 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0623\u0646\u062a.\", \"who\": \"\u0645\u0644\u0651\u0627\u0643 \u0639\u0644\u0649 \u0648\u0634\u0643 \u062a\u0648\u0642\u064a\u0639 \u0639\u0642\u062f \u0643\u0628\u064a\u0631 \u0644\u0646\u0638\u0627\u0645 \u0623\u0648 \u062a\u0631\u062e\u064a\u0635 \u0623\u0648 \u062a\u0646\u0641\u064a\u0630.\", \"receive\": [], \"proof\": [\"\u062a\u0633\u0639\u0629 \u0639\u0634\u0631 \u0639\u0627\u0645\u064b\u0627 \u0641\u064a \u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u064a \u0623\u0645\u0627\u0645 \u0645\u0648\u0631\u0651\u062f\u064a Oracle \u0648Hyperion \u0648Laserfiche \u0648Kafka \u0648\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0633\u062d\u0627\u0628\u064a\u0629.\"]}, {\"code\": \"E3\", \"fam\": \"E\", \"title\": \"\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u0627\u0644\u0628\u0631\u0627\u0645\u062c\", \"short\": \"\u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u062a\u0642\u0646\u064a \u0636\u0645\u0646 \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u063a\u064a\u064a\u0631 \u0623\u0648\u0633\u0639\u060c \u064a\u064f\u062f\u0627\u0631 \u0643\u0645\u0627 \u064a\u062c\u0628.\", \"what\": \"\u062d\u0627\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u0634\u0647\u0627\u062f\u0629 \u0645\u062d\u062a\u0631\u0641 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 (PMP). \u0645\u0646\u0647\u062c\u064a\u062a\u0627 Agile \u0648Waterfall. \u062e\u0628\u0631\u0629 \u0641\u064a \u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u062a\u0642\u0646\u064a \u0636\u0645\u0646 \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u062d\u0648\u0651\u0644 \u0623\u0639\u0645\u0627\u0644 \u0623\u0648\u0633\u0639.\", \"who\": \"\u0634\u0631\u0643\u0627\u062a \u062a\u0646\u0641\u0651\u0630 \u062a\u063a\u064a\u064a\u0631\u064b\u0627 \u0641\u064a \u0623\u0639\u0645\u0627\u0644\u0647\u0627 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0639\u0645\u0644 \u062a\u0642\u0646\u064a.\", \"receive\": [], \"proof\": []}], \"SITUATIONS\": [{\"id\": \"sheets\", \"label\": \"\u0646\u0639\u0645\u0644 \u0639\u0644\u0649 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629\", \"codes\": [\"B1\", \"B3\", \"A2\"]}, {\"id\": \"quote\", \"label\": \"\u0646\u062e\u0633\u0631 \u0627\u0644\u0645\u0627\u0644 \u0628\u064a\u0646 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u062a\u0633\u0644\u064a\u0645\", \"codes\": [\"B2\", \"B1\", \"C3\"]}, {\"id\": \"late\", \"label\": \"\u0623\u0631\u0642\u0627\u0645\u0646\u0627 \u062a\u0635\u0644 \u0645\u062a\u0623\u062e\u0631\u0629\u060c \u0623\u0648 \u0644\u0627 \u062a\u062a\u0641\u0642\", \"codes\": [\"B3\", \"B4\", \"C3\"]}, {\"id\": \"retype\", \"label\": \"\u0647\u0646\u0627\u0643 \u0645\u0646 \u064a\u0639\u064a\u062f \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0623\u0646\u0638\u0645\u0629\", \"codes\": [\"B4\", \"A1\", \"C2\"]}, {\"id\": \"legacy\", \"label\": \"\u0646\u062d\u0646 \u0628\u0635\u062f\u062f \u0645\u063a\u0627\u062f\u0631\u0629 \u0646\u0638\u0627\u0645 \u0642\u062f\u064a\u0645\", \"codes\": [\"C1\", \"C2\", \"E2\"]}, {\"id\": \"vendor\", \"label\": \"\