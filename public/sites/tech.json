062e\u0644\u0627\u0644 \u0639\u0627\u0645 \u062a\u0642\u0631\u064a\u0628\u064b\u0627. \u0631\u0628\u0637 \u0628\u064a\u0627\u0646\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629 \u062a\u062d\u0645\u0644 \u0631\u0645\u0648\u0632\u064b\u0627 \u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0643\u0644 \u0641\u0631\u0639 \u0645\u0639 \u062a\u0628\u0639\u064a\u0627\u062a \u062a\u0635\u0644 \u0625\u0644\u0649 \u0633\u0628\u0639\u0629 \u0645\u0633\u062a\u0648\u064a\u0627\u062a\u060c \u0648\u062f\u0645\u062c \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0645\u0643\u0631\u0651\u0631\u064a\u0646 \u0641\u064a \u062d\u0633\u0627\u0628\u0627\u062a \u0648\u0643\u0634\u0648\u0641 \u0645\u0648\u062d\u0651\u062f\u0629. \u0633\u064f\u0644\u0651\u0645 \u0628\u0633\u0644\u0627\u0645\u0629 \u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a.\", \"fig\": \"\u0643\u0627\u0646 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0642\u062f \u062d\u0643\u0645 \u0628\u0627\u0633\u062a\u062d\u0627\u0644\u062a\u0647\u060c \u0648\u0642\u062f\u0651\u0645 \u0639\u0631\u0636\u064b\u0627 \u0628\u0642\u064a\u0645\u0629 8 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a \u0644\u062a\u062c\u0645\u064a\u062f \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0628\u062f\u0621 \u0645\u0646 \u062c\u062f\u064a\u062f.\"}, {\"t\": \"\u0639\u0634\u0631 \u0633\u0646\u0648\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0641\u064a \u0639\u0637\u0644\u0629 \u0646\u0647\u0627\u064a\u0629 \u0623\u0633\u0628\u0648\u0639\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"D\"], \"codes\": \"D2\", \"body\": \"\u0631\u0641\u0639 \u0625\u0644\u0632\u0627\u0645\u064a \u0645\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629 \u0644\u0639\u0634\u0631 \u0633\u0646\u0648\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0641\u0631\u0648\u0639\u060c \u0623\u064f\u0646\u0642\u0630 \u062e\u0644\u0627\u0644 \u0639\u0637\u0644\u0629 \u0646\u0647\u0627\u064a\u0629 \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u064a\u0627\u0645 \u0628\u0639\u062f \u0623\u0646 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u0645\u0643\u0644\u0651\u0641. \u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0627\u0644\u0645\u062a\u0636\u0631\u0651\u0631\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u0628\u0646\u0627\u0626\u0647\u0627\u060c \u0648\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0645\u0639 \u0627\u0644\u0647\u0648\u064a\u0627\u062a \u0627\u0644\u0648\u0637\u0646\u064a\u0629.\", \"fig\": \"\u062a\u0645 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0645\u0648\u0639\u062f \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u0648\u0632\u0627\u0644 \u062e\u0637\u0631 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0634\u0631\u0643\u0629.\"}, {\"t\": \"\u0625\u0639\u0627\u062f\u0629 \u0628\u0646\u0627\u0621 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u062a\u0643\u0627\u0641\u0644\u064a\", \"fam\": [\"B\"], \"codes\": \"B4 B3\", \"body\": \"\u062a\u062d\u0644\u064a\u0644 \u0639\u0643\u0633\u064a \u0644\u062a\u0643\u0627\u0645\u0644 \u064a\u0639\u0645\u0644 \u0643\u0644 \u0633\u0627\u0639\u0629 \u0648\u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0623\u0639\u0637\u0627\u0644 \u0628\u064a\u0646 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0648Oracle E-Business Suite\u060c \u062b\u0645 \u0625\u0639\u0627\u062f\u0629 \u0628\u0646\u0627\u0621 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0643\u0634\u0641 \u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0648\u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u062f\u064a\u0648\u0646. \u0623\u0635\u0628\u062d\u062a \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u062a\u0638\u0647\u0631 \u0641\u0648\u0631\u064b\u0627 \u0648\u062f\u0648\u0646 \u0623\u062e\u0637\u0627\u0621.\", \"fig\": \"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0643\u0634\u0641 \u0627\u0646\u062e\u0641\u0636 \u0645\u0646 \u0633\u0627\u0639\u062a\u064a\u0646 \u0625\u0644\u0649 \u0633\u0628\u0639 \u062b\u0648\u0627\u0646\u064d. \u0648\u0627\u0644\u0634\u064a\u0641\u0631\u0629 \u062a\u0639\u0645\u0644 \u0641\u064a \u0628\u064a\u0626\u0629 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u062f\u0648\u0646 \u062a\u0639\u062f\u064a\u0644 \u0645\u0646\u0630 2012.\"}, {\"t\": \"\u0645\u0637\u0627\u0628\u0642\u0629 300 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u062a\u0643\u0627\u0641\u0644\u064a\", \"fam\": [\"C\"], \"codes\": \"C3\", \"body\": \"\u062d\u0644\u0651 \u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0648\u0627\u0644\u0645\u0642\u0628\u0648\u0636\u0627\u062a \u0628\u0628\u0646\u0627\u0621 \u0625\u062c\u0631\u0627\u0621\u0627\u062a Oracle API \u0648\u062a\u0634\u063a\u064a\u0644\u0647\u0627.\", \"fig\": \"\u062d\u064f\u0644\u0651 \u0641\u0631\u0642 300 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a 26 \u062b\u0627\u0646\u064a\u0629\u060c \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0645\u0647\u0645\u0629 \u0627\u0642\u062a\u0631\u062d\u0647\u0627 \u0645\u0648\u0631\u0651\u062f \u0644\u0645\u062f\u0629 \u0634\u0647\u0631 \u0628\u0623\u0631\u0628\u0639\u0629 \u0623\u0634\u062e\u0627\u0635.\"}, {\"t\": \"\u0625\u0646\u0642\u0627\u0630 \u0625\u0637\u0644\u0627\u0642 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0648\u0627\u0632\u0646\u0627\u062a\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u062a\u0643\u0627\u0641\u0644\u064a\", \"fam\": [\"D\"], \"codes\": \"D1\", \"body\": \"\u062a\u0633\u0644\u0651\u0645 \u0625\u0637\u0644\u0627\u0642 \u0645\u062a\u0639\u062b\u0651\u0631 \u0644\u0646\u0638\u0627\u0645 \u0645\u0648\u0627\u0632\u0646\u0627\u062a Hyperion \u062f\u0648\u0646 \u062a\u0631\u062e\u064a\u0635 \u062a\u0643\u0627\u0645\u0644 \u0648\u0645\u0639 \u062a\u0633\u0644\u064a\u0645 \u0646\u0627\u0642\u0635. \u062a\u0639\u0644\u0651\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u064a\u062f\u0648\u064a\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u0635\u062d\u064a\u062d \u0643\u0644 \u0631\u0642\u0645 \u063a\u064a\u0631 \u0645\u0637\u0627\u0628\u0642 \u062d\u062a\u0649 \u0627\u0644\u0647\u0644\u0644\u0629.\", \"fig\": \"\u0639\u0631\u0636 \u0646\u0627\u062c\u062d \u0623\u0645\u0627\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0629 \u0636\u0645\u0646 \u0645\u0647\u0644\u0629 \u0623\u0633\u0628\u0648\u0639\u064a\u0646.\"}, {\"t\": \"\u0623\u0631\u0628\u0639\u0629 \u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0639\u062c\u0632 \u0639\u0646\u0647\u0627 \u0627\u0644\u0645\u0648\u0631\u0651\u062f\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u062a\u0643\u0627\u0641\u0644\u064a\", \"fam\": [\"B\", \"D\"], \"codes\": \"B4 D1\", \"body\": \"\u062a\u0633\u0644\u064a\u0645 \u0623\u0631\u0628\u0639\u0629 \u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0644\u0623\u0646\u0638\u0645\u0629 \u0645\u0624\u0633\u0633\u064a\u0629 \u0639\u062c\u0632 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0639\u0646 \u0625\u0643\u0645\u0627\u0644\u0647\u0627\u060c \u0628\u062c\u0647\u062f \u0641\u0631\u062f\u064a.\", \"fig\": \"\u0633\u064f\u0644\u0651\u0645 \u0643\u0644\u064c\u0651 \u0645\u0646\u0647\u0627 \u062e\u0644\u0627\u0644 \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f\u060c \u0628\u0639\u062f \u0623\u0646 \u062e\u064f\u0635\u0651\u0635 \u0644\u0643\u0644\u064d\u0651 \u0645\u0646\u0647\u0627 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0625\u0644\u0649 \u0633\u062a\u0629 \u0623\u0634\u0647\u0631.\"}, {\"t\": \"\u062a\u0631\u062d\u064a\u0644 \u0646\u0638\u0627\u0645 \u0642\u062f\u064a\u0645 \u062f\u0648\u0646 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0631\u0651\u062f\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"C\"], \"codes\": \"C1\", \"body\": \"\u062a\u0631\u062d\u064a\u0644 \u0646\u0638\u0627\u0645 \u062a\u0623\u0645\u064a\u0646 \u0642\u062f\u064a\u0645 \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u0623\u0633\u0627\u0633\u064a \u062c\u062f\u064a\u062f \u062f\u0648\u0646 \u0623\u064a \u062a\u0648\u0642\u0641\u060c \u0628\u062a\u062d\u0644\u064a\u0644 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629\u060c \u0648\u062a\u062c\u0627\u0648\u0632 \u062f\u0639\u0645 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u0645\u0639\u0644\u0651\u0642 \u0648\u0631\u0633\u0648\u0645 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c.\", \"fig\": \"\u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0625\u0644\u0649 \u0642\u0648\u0627\u0644\u0628 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062c\u062f\u064a\u062f \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u0633\u0627\u0628\u064a\u0639.\"}, {\"t\": \"\u0623\u062a\u0645\u062a\u0629 \u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"B\"], \"codes\": \"B4\", \"body\": \"\u0646\u0638\u0627\u0645 \u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0645\u062a\u0643\u0627\u0645\u0644 \u0645\u0639 \u0646\u062c\u0645 \u0648\u064a\u0642\u064a\u0646 \u0644\u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627\u060c \u0648\u0645\u0639 \u0645\u0633\u062d \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0639\u0628\u0631 Laserfiche \u0648\u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0627\u0644\u0636\u0648\u0626\u064a \u0639\u0644\u0649 \u0627\u0644\u062d\u0631\u0648\u0641 (OCR). \u0645\u0624\u0642\u0651\u062a\u0627\u062a \u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0648\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u062d\u062a\u064a\u0627\u0644\u060c \u0648\u0633\u064a\u0631 \u0645\u0648\u0627\u0641\u0642\u0627\u062a \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u062d\u0633\u0628 \u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0629.\", \"fig\": \"\u0639\u0645\u0644\u064a\u0629 \u064a\u062f\u0648\u064a\u0629 \u0645\u062f\u062a\u0647\u0627 20 \u062f\u0642\u064a\u0642\u0629 \u0623\u0635\u0628\u062d\u062a \u0623\u0642\u0644 \u0645\u0646 \u062f\u0642\u064a\u0642\u062a\u064a\u0646.\"}, {\"t\": \"\u0625\u0635\u0644\u0627\u062d \u0623\u062f\u0627\u0621 \u0627\u0644\u0631\u0641\u0639 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"C\"], \"codes\": \"C4\", \"body\": \"\u062a\u062d\u062f\u064a\u062f \u0633\u0628\u0628 \u0628\u0637\u0621 \u0627\u0644\u0631\u0641\u0639 \u0627\u0644\u062c\u0645\u0627\u0639\u064a \u0644\u0644\u0648\u062b\u0627\u0626\u0642: \u0643\u0627\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u064a\u0641\u062d\u0635 \u062c\u062f\u0648\u0644 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0643\u0627\u0645\u0644\u064b\u0627 \u0644\u062a\u0648\u0644\u064a\u062f \u0643\u0644 \u0631\u0642\u0645 \u062c\u062f\u064a\u062f. \u0628\u064f\u0646\u064a\u062a \u062a\u0633\u0644\u0633\u0644\u0627\u062a Oracle \u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0644\u0643\u0644 \u0646\u0648\u0639 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a.\", \"fig\": \"\u0645\u0646 25 \u062f\u0642\u064a\u0642\u0629 \u0644\u0644\u062f\u0641\u0639\u0629 \u0625\u0644\u0649 \u0623\u0642\u0644 \u0645\u0646 10 \u062b\u0648\u0627\u0646\u064d\u060c \u0645\u0627 \u0623\u062a\u0627\u062d \u0632\u064a\u0627\u062f\u0629 \u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u0625\u0646\u062a\u0627\u062c \u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0637\u0628\u064a.\"}, {\"t\": \"\u062e\u0637 \u0622\u0644\u064a \u0644\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u0639\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0629\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"B\"], \"codes\": \"B4\", \"body\": \"\u062e\u0637 \u0622\u0644\u064a \u0641\u064a \u0645\u0631\u0643\u0632 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0627\u0645 2014\u060c \u064a\u064f\u062f\u062e\u0644 \u0641\u064a\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0641\u064a\u0633\u0645\u0639 \u062d\u0627\u0644\u0629 \u0645\u0637\u0627\u0644\u0628\u062a\u0647 \u0648\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0646\u0627\u0642\u0635\u0629 \u0648\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0651\u0642\u0629 \u0648\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0648\u0642\u0639.\", \"fig\": \"\u062e\u0641\u0651\u0641 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0631\u0643\u0632 \u0627\u0644\u0627\u062a\u0635\u0627\u0644.\"}, {\"t\": \"\u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0651\u0643 \u0627\u0644\u062a\u0633\u0639\u064a\u0631\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"B\", \"C\"], \"codes\": \"C4 B2\", \"body\": \"\u062a\u062d\u0644\u064a\u0644 \u0639\u0643\u0633\u064a \u0644\u0645\u062d\u0631\u0651\u0643 \u062a\u0633\u0639\u064a\u0631 \u062a\u0623\u0645\u064a\u0646 \u0628\u0646\u0627\u0647 \u0645\u0648\u0631\u0651\u062f\u060c \u062b\u0645 \u062a\u062d\u0633\u064a\u0646\u0647. \u0639\u0644\u0649 \u0645\u0646\u0635\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u064a\u062a\u0635\u062f\u0651\u0631 \u0627\u0644\u0623\u0633\u0631\u0639 \u0627\u0633\u062a\u062c\u0627\u0628\u0629.\", \"fig\": \"\u0632\u0645\u0646 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 \u0645\u0646 42 \u062b\u0627\u0646\u064a\u0629 \u0625\u0644\u0649 0.07 \u062b\u0627\u0646\u064a\u0629. \u0648\u0645\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 32 \u0645\u0646 34 \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u0645\u0639 \u062d\u0635\u0629 \u0645\u0647\u064a\u0645\u0646\u0629 \u0645\u0646 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629.\"}, {\"t\": \"\u0642\u0648\u0627\u0639\u062f \u0627\u062d\u062a\u064a\u0627\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a\", \"ind\": \"\u0627\u0644\u062a\u0623\u0645\u064a\u0646\", \"fam\": [\"D\"], \"codes\": \"D4\", \"body\": \"\u0622\u0644\u064a\u0629 \u0645\u0646\u0637\u0642\u064a\u0629 \u0644\u0631\u0635\u062f \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0644 \u062a\u062d\u062f\u0651\u062f \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u062d\u0633\u0628 \u062a\u0648\u0642\u064a\u062a\u0647\u0627 \u0636\u0645\u0646 \u0645\u062f\u0629 \u0627\u0644\u0648\u062b\u064a\u0642\u0629\u060c \u0648\u062a\u0634\u0627\u0628\u0647 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a\u060c \u0648\u062a\u0642\u0627\u0631\u0628 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\u060c \u0648\u0627\u0644\u0623\u0637\u0631\u0627\u0641 \u0630\u0627\u062a \u0627\u0644\u0639\u0644\u0627\u0642\u0629\u060c \u0648\u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0642\u064a\u0645\u0629\u060c \u0648\u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0636\u0631\u0631 \u0641\u064a \u0627\u0644\u0642\u0637\u0639\u0629 \u0646\u0641\u0633\u0647\u0627.\", \"fig\": \"\u0643\u0634\u0641\u062a \u062d\u0627\u0644\u0627\u062a \u0627\u062d\u062a\u064a\u0627\u0644 \u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u062e\u062a\u0635.\"}, {\"t\": \"\u0644\u0648\u062d\u0629 \u0645\u0624\u0634\u0631\u0627\u062a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0635\u0646\u0639\", \"ind\": \"\u0627\u0644\u062a\u0635\u0646\u064a\u0639\", \"fam\": [\"A\", \"B\"], \"codes\": \"A3 B3\", \"body\": \"\u062a\u062c\u0647\u064a\u0632 \u0622\u0644\u0627\u062a \u0625\u0646\u062a\u0627\u062c \u062b\u0642\u064a\u0644\u0629 \u0644\u0623\u0639\u0645\u062f\u0629 \u0627\u0644\u0625\u0646\u0627\u0631\u0629 \u0648\u0627\u0644\u0623\u0628\u0631\u0627\u062c \u0628\u0627\u0644\u062d\u0633\u0627\u0633\u0627\u062a \u0648\u0631\u0628\u0637\u0647\u0627 \u0628\u0640 Oracle E-Business Suite\u060c \u0644\u062a\u062a\u0628\u0651\u0639 \u0643\u0644 \u0639\u0645\u0648\u062f \u062d\u0633\u0628 \u0623\u0645\u0631 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0648\u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0648\u0627\u0644\u0622\u0644\u0629 \u0648\u0627\u0644\u0647\u062f\u0631 \u0648\u0627\u0644\u0648\u0642\u062a \u0639\u0628\u0631 \u0633\u062a\u0629 \u0645\u0635\u0627\u0646\u0639. \u0623\u064f\u0639\u064a\u062f \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u062c\u062f\u0648\u0644 \u0644\u062a\u0642\u0644\u064a\u0635 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u062a\u0633\u062a\u063a\u0631\u0642 \u0633\u0627\u0639\u0627\u062a.\", \"fig\": \"\u062a\u0628\u064a\u0651\u0646 \u0623\u0646 \u0627\u0644\u0644\u062d\u0627\u0645 \u0647\u0648 \u0639\u0646\u0642 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0648\u0623\u064f\u0636\u064a\u0641 \u0627\u0644\u062a\u0646\u0628\u0624 \u0628\u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u062d\u062a\u0649 \u0644\u0627 \u062a\u062a\u0633\u0628\u0628 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0641\u064a \u062a\u0648\u0642\u0641 \u062e\u0637 \u0627\u0644\u0625\u0646\u062a\u0627\u062c.\"}, {\"t\": \"\u0625\u0639\u0627\u062f\u0629 \u0628\u0646\u0627\u0621 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0631\u0648\u0627\u062a\u0628\", \"ind\": \"\u0627\u0644\u062a\u0635\u0646\u064a\u0639\", \"fam\": [\"B\", \"C\"], \"codes\": \"B3 C4\", \"body\": \"\u0625\u0639\u0627\u062f\u0629 \u0628\u0646\u0627\u0621 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0631\u0648\u0627\u062a\u0628 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 10,000 \u0645\u0648\u0638\u0641\u060c \u0648\u0645\u0637\u0627\u0628\u0642\u062a\u0647 \u0645\u0639 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u062d\u062a\u0649 \u0627\u0644\u0647\u0644\u0644\u0629\u060c \u0648\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0622\u0644\u064a \u0639\u0628\u0631 Oracle BI Publisher \u0644\u0625\u0631\u0633\u0627\u0644 \u0642\u0633\u0627\u0626\u0645 \u0627\u0644\u0631\u0648\u0627\u062a\u0628 \u0628\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0637\u0628\u0627\u0639\u062a\u0647\u0627 \u0648\u062a\u0633\u06