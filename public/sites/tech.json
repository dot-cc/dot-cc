{r.name}\"\u003e${LOGOS[r.id] ? `\u003cimg src=\"${LOGOS[r.id]}\" alt=\"${r.name}\"\u003e` : `\u003cspan class=\"abbr\" style=\"color:#fff;font:700 1.05rem \u0026#39;Utility Sans\u0026#39;,sans-serif\" role=\"img\" aria-label=\"${r.name}\"\u003e${r.abbr}\u003c/span\u003e`}\u003c/span\u003e`;\n    const items = D.REGS.map(one).join(\"\");\n    const dup = D.REGS.map(one).join(\"\");\n    $(\"#logoRow\").innerHTML = items + `\u003cspan class=\"dup\" aria-hidden=\"true\" style=\"display:contents\"\u003e${dup}\u003c/span\u003e`;\n  }\n\n  function renderTabs(){\n    $(\"#tabs\").innerHTML = D.FAMILIES.map(f =\u003e `\u003cbutton type=\"button\" class=\"tab\" role=\"tab\" id=\"tab-${f.id}\" aria-controls=\"panel-${f.id}\" aria-selected=\"${f.id === activeTab}\" tabindex=\"${f.id === activeTab ? 0 : -1}\"\u003e\u003cspan class=\"l\" aria-hidden=\"true\"\u003e${f.id}\u003c/span\u003e${f.name}\u003c/button\u003e`).join(\"\");\n    $(\"#panels\").innerHTML = D.FAMILIES.map(f =\u003e `\u003cdiv class=\"panel\" id=\"panel-${f.id}\" role=\"tabpanel\" aria-labelledby=\"tab-${f.id}\"${f.id === activeTab ? \"\" : \" hidden\"}\u003e\n      \u003cdiv\u003e\u003cdiv class=\"big\" aria-hidden=\"true\"\u003e${f.id}\u003c/div\u003e\u003ch3 class=\"fam\"\u003e${f.name}\u003c/h3\u003e\u003cp class=\"muted\"\u003e${f.line}\u003c/p\u003e\u003c/div\u003e\n      \u003cul class=\"svc-list\"\u003e${D.SERVICES.filter(s =\u003e s.fam === f.id).map(s =\u003e `\u003cli\u003e\u003cspan class=\"code\"\u003e${s.code}\u003c/span\u003e\u003cdiv\u003e\u003ch4\u003e${s.title}\u003c/h4\u003e\u003cp\u003e${s.what}\u003c/p\u003e${s.receive.length ? `\u003cp class=\"rcv\"\u003e${T.recv}${s.receive.join(lang === \"ar\" ? \"\u060c \" : \", \")}.\u003c/p\u003e` : (s.who ? `\u003cp class=\"rcv\"\u003e${T.forL}${s.who}\u003c/p\u003e` : \"\")}\u003c/div\u003e\u003c/li\u003e`).join(\"\")}\u003c/ul\u003e\u003c/div\u003e`).join(\"\");\n  }\n  function selectTab(id, focus){\n    activeTab = id;\n    document.querySelectorAll(\"#tabs .tab\").forEach(t =\u003e { const on = t.id === \"tab-\" + id; t.setAttribute(\"aria-selected\", String(on)); t.tabIndex = on ? 0 : -1; if (on \u0026\u0026 focus) t.focus(); });\n    document.querySelectorAll(\"#panels .panel\").forEach(p =\u003e p.hidden = p.id !== \"panel-\" + id);\n  }\n  $(\"#tabs\").addEventListener(\"click\", e =\u003e { const t = e.target.closest(\".tab\"); if (t) selectTab(t.id.slice(4)); });\n  $(\"#tabs\").addEventListener(\"keydown\", e =\u003e {\n    if (e.key !== \"ArrowRight\" \u0026\u0026 e.key !== \"ArrowLeft\") return;\n    const ids = D.FAMILIES.map(f =\u003e f.id); let i = ids.indexOf(activeTab);\n    const fwd = (e.key === \"ArrowRight\") !== (lang === \"ar\");\n    i = (i + (fwd ? 1 : ids.length - 1)) % ids.length; selectTab(ids[i], true); e.preventDefault();\n  });\n\n  /* fit */\n  function renderChips(){ $(\"#chips\").innerHTML = D.SITUATIONS.map(s =\u003e `\u003cbutton type=\"button\" class=\"chip\" data-id=\"${s.id}\" aria-pressed=\"${picked.includes(s.id)}\"\u003e${s.label}\u003c/button\u003e`).join(\"\"); }\n  $(\"#chips\").addEventListener(\"click\", e =\u003e {\n    const b = e.target.closest(\".chip\"); if (!b) return;\n    const i = picked.indexOf(b.dataset.id);\n    if (i === -1) picked.push(b.dataset.id); else picked.splice(i, 1);\n    b.setAttribute(\"aria-pressed\", String(i === -1));\n    renderCard();\n  });\n  let lastMessage = \"\";\n  function renderCard(){\n    const score = {}, order = [];\n    picked.forEach(id =\u003e D.SITUATIONS.find(x =\u003e x.id === id).codes.forEach((c, i) =\u003e { score[c] = (score[c] || 0) + (3 - i); if (!order.includes(c)) order.push(c); }));\n    const ranked = order.slice().sort((a, b) =\u003e (score[b] - score[a]) || (order.indexOf(a) - order.indexOf(b)));\n    pickedRanked = ranked;\n    updateTags();\n    const card = $(\"#card\");\n    const dots = D.SERVICES.map((s, i) =\u003e `\u003cspan class=\"${ranked[0] === s.code ? \"start\" : ranked.includes(s.code) ? \"on\" : \"\"}${i \u0026\u0026 D.SERVICES[i-1].fam !== s.fam ? \" fam-gap\" : \"\"}\" title=\"${s.code}\"\u003e\u003c/span\u003e`).join(\"\");\n    if (!ranked.length){ card.innerHTML = `\u003cdiv class=\"dots\" aria-hidden=\"true\"\u003e${dots}\u003c/div\u003e\u003cp class=\"empty\"\u003e${T.empty}\u003c/p\u003e`; return; }\n    const first = byCode[ranked[0]];\n    const labels = picked.map(id =\u003e D.SITUATIONS.find(x =\u003e x.id === id).label);\n    lastMessage = T.pickerMsg(labels, ranked.map(c =\u003e \"- \" + c + \" \" + byCode[c].title));\n    card.innerHTML = `\u003cdiv class=\"dots\" aria-hidden=\"true\"\u003e${dots}\u003c/div\u003e\n      \u003cp class=\"k\"\u003e${T.start}\u003c/p\u003e\n      \u003ch3\u003e\u003cspan class=\"code-pill\"\u003e${first.code}\u003c/span\u003e${first.title}\u003c/h3\u003e\n      \u003cp style=\"margin:0\"\u003e${first.short}\u003c/p\u003e\n      ${ranked.length \u003e 1 ? `\u003cul\u003e${ranked.slice(1).map(c =\u003e `\u003cli\u003e\u003cb class=\"code-tag\"\u003e${c}\u003c/b\u003e\u003cspan\u003e${byCode[c].title}\u003c/span\u003e\u003c/li\u003e`).join(\"\")}\u003c/ul\u003e` : \"\"}\n      \u003cdiv class=\"actions\"\u003e\u003cbutton class=\"btn btn-primary\" type=\"button\" id=\"useMsg\"\u003e${T.use}\u003c/button\u003e\u003cbutton class=\"btn btn-ghost\" type=\"button\" id=\"copyMsg\"\u003e${T.copyMsg}\u003c/button\u003e\u003c/div\u003e\n      \u003cp class=\"toast\" id=\"toast\" role=\"status\"\u003e\u003c/p\u003e`;\n  }\n  function copyText(text, toastEl){\n    const done = () =\u003e toastEl.textContent = T.copied;\n    const fallback = () =\u003e {\n      const ta = document.createElement(\"textarea\"); ta.value = text; ta.setAttribute(\"readonly\",\"\"); ta.style.position = \"fixed\"; ta.style.opacity = \"0\"; document.body.appendChild(ta); ta.select();\n      let ok = false; try { ok = document.execCommand(\"copy\"); } catch (e) {}\n      ta.remove(); toastEl.textContent = ok ? T.copied : T.blocked;\n    };\n    if (navigator.clipboard \u0026\u0026 navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback); else fallback();\n  }\n  $(\"#card\").addEventListener(\"click\", e =\u003e {\n    if (e.target.id === \"copyMsg\") copyText(lastMessage, $(\"#toast\"));\n    if (e.target.id === \"useMsg\"){\n      const labels = picked.map(id =\u003e D.SITUATIONS.find(x =\u003e x.id === id).label);\n      const msgEl = $(\"#f-msg\");\n      const draft = labels.length ? T.draft + \"\\n\" + labels.map(l =\u003e \"- \" + l).join(\"\\n\") + \"\\n\\n\" : \"\";\n      if (!msgEl.value.trim() || msgEl.value === autoMsg){ msgEl.value = draft; autoMsg = draft; }\n      $(\"#contact\").scrollIntoView({behavior: matchMedia(\"(prefers-reduced-motion: reduce)\").matches ? \"auto\" : \"smooth\"});\n      setTimeout(() =\u003e $(\"#f-name\").focus({preventScroll:true}), 500);\n    }\n  });\n  function updateTags(){\n    $(\"#f-tags\").innerHTML = pickedRanked.length ? pickedRanked.map(c =\u003e `\u003cspan\u003e\u003cb class=\"code-tag\"\u003e${c}\u003c/b\u003e ${byCode[c].title}\u003c/span\u003e`).join(\"\") : `\u003cspan class=\"none\"\u003e${T.none}\u003c/span\u003e`;\n  }\n\n  /* contact form */\n  const form = $(\"#contactForm\"), sent = $(\"#sent\");\n  let lastMail = \"\", lastPlain = \"\";\n  function setErr(id, msg){ const e = $(\"#e-\" + id); e.textContent = msg; e.closest(\".field\").classList.toggle(\"invalid\", !!msg); }\n  form.addEventListener(\"submit\", async e =\u003e {\n    e.preventDefault();\n    if ($(\"#f-web\").value) return;\n    const v = id =\u003e $(\"#f-\" + id).value.trim();\n    let bad = null;\n    const checks = [[\"name\", v(\"name\") ? \"\" : T.errName],\n      [\"email\", !v(\"email\") ? T.errEmail : (/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v(\"email\")) ? \"\" : T.errEmailBad)],\n      [\"msg\", $(\"#f-msg\").value.trim() ? \"\" : T.errMsg]];\n    checks.forEach(([id, msg]) =\u003e { setErr(id, msg); if (msg \u0026\u0026 !bad) bad = id; });\n    if (bad){ $(\"#f-\" + bad).focus(); return; }\n    const sizeSel = $(\"#f-size\"), sizeTxt = sizeSel.value ? sizeSel.options[sizeSel.selectedIndex].text : \"\";\n    const services = pickedRanked.map(c =\u003e c + \" \" + byCode[c].title);\n    const subject = T.subject(v(\"company\"));\n    const head = [T.lName + v(\"name\"), T.lCompany + v(\"company\"), T.lEmail + v(\"email\"), v(\"phone\") ? T.lPhone + v(\"phone\") : \"\", sizeTxt ? T.sizeLabel + sizeTxt : \"\"].filter(Boolean).join(\"\\n\");\n    const svc = services.length ? T.lSvc + \"\\n\" + services.map(x =\u003e \"- \" + x).join(\"\\n\") : \"\";\n    const body = [head, svc, $(\"#f-msg\").value.trim()].filter(Boolean).join(\"\\n\\n\");\n    lastPlain = T.to + TO + \"\\n\" + T.subj + subject + \"\\n\\n\" + body;\n    lastMail = \"mailto:\" + TO + \"?subject=\" + encodeURIComponent(subject) + \"\u0026body=\" + encodeURIComponent(body);\n    $(\"#mailAgain\").href = lastMail;\n    $(\"#formToast\").textContent = \"\";\n    if (FORM_ENDPOINT){\n      try {\n        const p = new URLSearchParams({\"form-name\":\"contact\",source:\"tech studio\",name:v(\"name\"),company:v(\"company\"),email:v(\"email\"),phone:v(\"phone\"),size:sizeTxt,services:services.join(\", \"),message:$(\"#f-msg\").value.trim(),subject:subject,test:v(\"test\")}); const res = await fetch(FORM_ENDPOINT,{method:\"POST\",headers:{\"Content-Type\":\"application/x-www-form-urlencoded\"},body:p.toString()}); if (res.ok){ try{parent.postMessage({dot:\"lead\",site:\"tech-studio\"},\"*\")}catch(e){} $(\"#sentText\").textContent = T.thanks; sent.hidden = false; form.reset(); return; }\n      } catch (err) {}\n    }\n    const a = document.createElement(\"a\"); a.href = lastMail; a.style.display = \"none\"; document.body.appendChild(a); a.click(); a.remove();\n    $(\"#sentText\").textContent = T.sent;\n    sent.hidden = false;\n    sent.scrollIntoView({block:\"nearest\"});\n  });\n  [\"name\",\"company\",\"email\",\"msg\"].forEach(id =\u003e $(\"#f-\" + id).addEventListener(\"input\", () =\u003e setErr(id, \"\")));\n  $(\"#copyForm\").addEventListener(\"click\", () =\u003e copyText(lastPlain, $(\"#formToast\")));\n  $(\"#f-size\").addEventListener(\"change\", e =\u003e sizeVal = e.target.value);\n\n  /* language */\n  function renderAll(l){\n    lang = l; D = DATA[l]; T = S[l];\n    byCode = Object.fromEntries(D.SERVICES.map(s =\u003e [s.code, s]));\n    renderRing(); renderLogos(); renderTabs(); renderChips(); renderCard();\n    [\"name\",\"company\",\"email\",\"msg\"].forEach(id =\u003e setErr(id, \"\"));\n    $(\"#f-size\").value = sizeVal;\n    if (!sent.hidden) $(\"#sentText\").textContent = T.sent;\n    const lb = $(\"#langBtn\"); lb.textContent = T.toggle; lb.lang = T.toggleLang;\n    menuBtn.textContent = nav.classList.contains(\"open\") ? T.close : T.menu;\n    const pl = $(\"#profileLink\"); if (pl \u0026\u0026 pl.getAttribute(\"href\") !== \"#\"){ const u = pl.getAttribute(\"href\").split(\"?\")[0]; pl.setAttribute(\"href\", u + \"?lang=\" + l); }\n  }\n  $(\"#langBtn\").addEventListener(\"click\", () =\u003e I18N.apply(lang === \"ar\" ? \"en\" : \"ar\", AR));\n\n  /* active nav link */\n  const links = [...document.querySelectorAll(\"#links a\")];\n  const io = new IntersectionObserver(es =\u003e es.forEach(en =\u003e { if (en.isIntersecting) links.forEach(a =\u003e a.setAttribute(\"aria-current\", String(a.getAttribute(\"href\") === \"#\" + en.target.id))); }), {rootMargin:\"-45% 0px -50% 0px\"});\n  links.forEach(a =\u003e { const s = document.querySelector(a.getAttribute(\"href\")); if (s) io.observe(s); });\n\n  I18N.on(renderAll);\n  I18N.collect();\n  I18N.apply(I18N.detect(), AR);\n})();\n\u003c/script\u003e\n\u003cscript\u003e(function(){var n=document.querySelector(\".news\");if(n\u0026\u0026window.parent!==window)n.addEventListener(\"click\",function(e){e.preventDefault();try{parent.postMessage({dot:\"page\",path:\"/ai-enablement/\"},\"*\")}catch(_){location.href=\"/ai-enablement/\"}});})();\u003c/script\u003e\n\u003cscript\u003e(function(){\n  var b=document.getElementById(\"profileLink\");\n  if(b)b.addEventListener(\"click\",function(e){e.preventDefault();try{parent.postMessage({dot:\"go\",site:\"tech-profile\",lang:document.documentElement.lang},\"*\")}catch(_){}});\n  window.addEventListener(\"message\",function(e){var d=e.data;if(e.source!==parent||!d||d.dot!==\"lang\")return;\n    if(d.lang\u0026\u0026document.documentElement.lang!==d.lang){var l=document.getElementById(\"langBtn\");if(l)l.click()}});\n})();\u003c/script\u003e\n\n\n\n\n\n\n\n\u003c!-- dot. universe start --\u003e\n\u003c!-- dot. tech studio universe: a mint galaxy, the dot as a planet, five service worlds, agent spacecraft, data streams --\u003e\n\u003cstyle id=\"uv-style\"\u003e\n#uv{position:fixed;inset:0;width:100%;height:100%;z-index:-1;display:block;opacity:0;transition:opacity .9s ease}\nhtml.uv-ok{background:#081014}\nhtml.uv-ok body{background:transparent}\nhtml.uv-ok .hero::before,html.uv-ok .hero::after{display:none}\nhtml.uv-ok .fit,html.uv-ok .record{background:rgba(10,30,30,.42)}\nhtml.uv-ok .orb .mark{visibility:hidden}\nhtml.uv-ok .contact-dot{background:transparent}\n#uvTags{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}\n#uvLines{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}\n.uvt{position:absolute;left:0;top:0;font:500 12px/1.3 \"Utility Sans\",system-ui,sans-serif;color:#E4F1EE;white-space:nowrap;opacity:0;transition:opacity .5s,color .3s;will-change:transform}\n.uvt b{display:inline-block;min-width:22px;padding:1px 6px;margin-inline-end:7px;border:1px solid rgba(0,244,201,.45);border-radius:999px;font-weight:600;color:#00F4C9;text-align:center}\n.uvt.hot{color:#00F4C9}.uvt.hot b{background:#00F4C9;color:#121D21;border-color:#00F4C9}\n.uv-hud{position:fixed;right:18px;bottom:16px;z-index:59;text-align:right;font:400 12px/1.5 \"Utility Sans\",system-ui,sans-serif;color:#94ACA7;pointer-events:none;direction:ltr}\n.uv-hud b{color:#00F4C9;font-weight:600}\n.uv-meter{display:flex;gap:4px;justify-content:flex-end;margin-top:6px}\n.uv-meter i{width:16px;height:3px;border-radius:2px;background:rgba(228,241,238,.18);transition:background .4s}\n.uv-meter i.on{background:#00F4C9}\n.uv-snd{all:unset;pointer-events:auto;cursor:pointer;display:inline-flex;align-items:center;gap:7px;margin-top:6px;font:400 12px/1 \"Utility Sans\",system-ui,sans-serif;color:#E4F1EE;min-height:24px}\n.uv-snd:focus-visible{outline:2px solid #00F4C9;outline-offset:3px}\n.uv-bars{display:inline-flex;gap:2px;align-items:flex-end;height:11px}\n.uv-bars i{width:2px;height:3px;background:#00F4C9}\n.uv-on .uv-bars i{animation:uveq 1s infinite ease-in-out}.uv-on .uv-bars i:nth-child(2){animation-delay:.2s}.uv-on .uv-bars i:nth-child(3){animation-delay:.4s}\n@keyframes uveq{0%,100%{height:3px}50%{height:11px}}\nhtml.modal-open .uv-hud{display:none}\n@media (max-width:760px){.uv-hud .m,#uvChap,#uvTags,#uvLines{display:none}.uv-hud{bottom:20px}}\n@media (prefers-reduced-motion:reduce){.uv-on .uv-bars i{animation:none}}\n\u003c/style\u003e\n\u003ccanvas id=\"uv\" aria-hidden=\"true\"\u003e\u003c/canvas\u003e\n\u003cdiv id=\"uvTags\" aria-hidden=\"true\"\u003e\u003c/div\u003e\n\u003csvg id=\"uvLines\" aria-hidden=\"true\"\u003e\u003c/svg\u003e\n\u003cdiv class=\"uv-hud\"\u003e\u003cdiv class=\"m\" aria-hidden=\"true\"\u003e24.7136\u00b0 N \u00b7 46.6753\u00b0 E\u003c/div\u003e\u003cdiv id=\"uvChap\" aria-hidden=\"true\"\u003e\u003cb\u003e01\u003c/b\u003e / 07\u003c/div\u003e\u003cdiv class=\"uv-meter\" id=\"uvMeter\" aria-hidden=\"true\"\u003e\u003c/div\u003e\u003cbutton class=\"uv-snd\" id=\"uvSnd\" type=\"button\" aria-pressed=\"false\"\u003e\u003cspan class=\"uv-bars\" aria-hidden=\"true\"\u003e\u003ci\u003e\u003c/i\u003e\u003ci\u003e\u003c/i\u003e\u003ci\u003e\u003c/i\u003e\u003c/span\u003e\u003cspan\u003eSound: \u003cspan id=\"uvSndT\"\u003eOff\u003c/span\u003e\u003c/span\u003e\u003c/button\u003e\u003c/div\u003e\n\u003cscript type=\"importmap\"\u003e{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"}}\u003c/script\u003e\n\u003cscript type=\"module\"\u003e\nimport * as THREE from 'three';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nconst RM = matchMedia('(prefers-reduced-motion: reduce)').matches;\nconst SMALL = innerWidth \u003c 760;\nconst canvas = document.getElementById('uv');\nlet renderer;\ntry { renderer = new THREE.WebGLRenderer({canvas, antialias:!SMALL, powerPreference:'high-performance'}); } catch(e) { canvas.remove(); throw e; }\nrenderer.setPixelRatio(Math.min(devicePixelRatio, SMALL?1.5:2)); renderer.setClearColor(0x081014,1);\nrenderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.1;\ndocument.documentElement.setAttribute('data-theme','dark');\ndocument.documentElement.classList.add('uv-ok'); requestAnimationFrame(()=\u003ecanvas.style.opacity=1);\nconst scene = new THREE.Scene(); scene.fog = new THREE.FogExp2(0x081014, .0062);\nconst camera = new THREE.PerspectiveCamera(46,1,.1,2000);\nconst MINT=0x00F4C9, PALE=0x8ffbe6, WHITE=0xEDF3F1, DEEP=0x0f6b62;\nscene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(renderer), .04).texture;\n{ const sun=new THREE.DirectionalLight(0xfff6ea,2.6); sun.position.set(-8,6,9); scene.add(sun);\n  const fill=new THREE.DirectionalLight(MINT,.7); fill.position.set(6,-3,-4); scene.add(fill);\n  scene.add(new THREE.AmbientLight(0x88a8a2,.18)); }\n\n/* soft round points, shared by the stars, the galaxy, the dust and the data streams */\nconst pointMat=(o={})=\u003enew THREE.ShaderMaterial({ transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, vertexColors:true,\n  uniforms:{uTime:{value:0},uPx:{value:renderer.getPixelRatio()},uSize:{value:o.size||1},uTw:{value:o.twinkle||0},uA:{value:1}},\n  vertexShader:`attribute float aSize; attribute float aSeed; uniform float uTime,uPx,uSize,uTw; varying vec3 vC; varying float vA;\n    void main(){ vC=color; vec4 mv=modelViewMatrix*vec4(position,1.); gl_Position=projectionMatrix*mv;\n      vA=1.-uTw*.5*(1.+sin(uTime*1.7+aSeed*40.)); gl_PointSize=aSize*uSize*uPx*(160./-mv.z); }`,\n  fragmentShader:`uniform float uA; varying vec3 vC; varying float vA; void main(){ float d=length(gl_PointCoord-.5); float a=smoothstep(.5,0.,d); a*=a; gl_FragColor=vec4(vC,a*vA*uA); }` });\nfunction cloud(N, fill, mat){ const p=new Float32Array(N*3),c=new Float32Array(N*3),s=new Float32Array(N),sd=new Float32Array(N),v=new THREE.Vector3(),col=new THREE.Color();\n  for(let i=0;i\u003cN;i++){ const sz=fill(v,col,i); v.toArray(p,i*3); col.toArray(c,i*3); s[i]=sz; sd[i]=Math.random(); }\n  const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.BufferAttribute(p,3)); g.setAttribute('color',new THREE.BufferAttribute(c,3));\n  g.setAttribute('aSize',new THREE.BufferAttribute(s,1)); g.setAttribute('aSeed',new THREE.BufferAttribute(sd,1)); return new THREE.Points(g,mat); }\n\n// 1. deep stars\nconst stars=cloud(SMALL?2500:6000,(v,c)=\u003e{ const r=260+Math.random()*500,th=Math.random()*Math.PI*2,ph=Math.acos(2*Math.random()-1);\n  v.set(r*Math.sin(ph)*Math.cos(th),r*Math.cos(ph),r*Math.sin(ph)*Math.sin(th)); c.setHSL(.47+Math.random()*.1,.25,.75+Math.random()*.25);\n  return Math.random()\u003c.04?9:2+Math.random()*4; }, pointMat({size:2.2,twinkle:.8})); scene.add(stars);\n\n// 2. the mint galaxy the dot lives in\nconst galaxy=new THREE.Group(); galaxy.position.set(0,-14,-70); galaxy.rotation.set(.42,0,.12); scene.add(galaxy);\n{ const R=95, inner=new THREE.Color(0xE8FFF9), mid=new THREE.Color(MINT), outer=new THREE.Color(DEEP);\n  galaxy.add(cloud(SMALL?16000:42000,(v,c,i)=\u003e{ const r=Math.pow(Math.random(),1.6)*R, a=(i%4)/4*Math.PI*2+r*.075;\n    const j=k=\u003eMath.pow(Math.random(),2.6)*(Math.random()\u003c.5?1:-1)*k;\n    v.set(Math.cos(a)*r+j(3+r*.22), j(1.2+r*.05), Math.sin(a)*r+j(3+r*.22)); const t=r/R;\n    if(t\u003c.35) c.copy(inner).lerp(mid,t/.35); else c.copy(mid).lerp(outer,(t-.35)/.65);\n    if(Math.random()\u003c.02) c.set(WHITE); c.multiplyScalar(.55+Math.random()*.45); return 1+Math.random()*2.4; }, pointMat({size:1.3,twinkle:.25}))); }\n\n/* planets: lit sphere, slow bands, a rim of light, a soft halo */\nconst planetMat=(hex,rim=1.2)=\u003enew THREE.ShaderMaterial({ uniforms:{uC:{value:new THREE.Color(hex)},uL:{value:new THREE.Vector3(-.5,.45,.75).normalize()},uRim:{value:rim},uTime:{value:0},uHot:{value:0},uFlat:{value:0}},\n  vertexShader:`varying vec3 vN,vV,vP; void main(){ vN=normalize(normalMatrix*normal); vec4 mv=modelViewMatrix*vec4(position,1.); vV=normalize(-mv.xyz); vP=position; gl_Position=projectionMatrix*mv; }`,\n  fragmentShader:`uniform vec3 uC,uL; uniform float uRim,uTime,uHot,uFlat; varying vec3 vN,vV,vP;\n    float h(vec3 p){return fract(sin(dot(p,vec3(12.9898,78.233,37.719)))*43758.5453);}\n    float n3(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(mix(h(i),h(i+vec3(1,0,0)),f.x),mix(h(i+vec3(0,1,0)),h(i+vec3(1,1,0)),f.x),f.y),mix(mix(h(i+vec3(0,0,1)),h(i+vec3(1,0,1)),f.x),mix(h(i+vec3(0,1,1)),h(i+vec3(1,1,1)),f.x),f.y),f.z);}\n    void main(){ float d=max(dot(vN,uL),0.); float b=n3(vP*1.6+vec3(0.,uTime*.05,0.))*.6+n3(vP*4.)*.4;\n      vec3 base=mix(uC*(.16+.84*d)*(.8+.3*b),uC*(.92+.08*b),uFlat); float rim=pow(1.-max(dot(vN,vV),0.),2.6)*(uRim+uHot*1.5);\n      gl_FragColor=vec4(base+uC*rim+uC*uHot*.18,1.); }` });\nconst haloMat=(hex,k=.9)=\u003enew THREE.ShaderMaterial({ transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.BackSide,\n  uniforms:{uC:{value:new THREE.Color(hex)},uK:{value:k}},\n  vertexShader:`varying vec3 vN,vV; void main(){ vN=normalize(normalMatrix*normal); vec4 mv=modelViewMatrix*vec4(position,1.); vV=normalize(-mv.xyz); gl_Position=projectionMatrix*mv; }`,\n  fragmentShader:`uniform vec3 uC; uniform float uK; varying vec3 vN,vV; void main(){ float i=pow(max(dot(vN,vV),0.)*1.02,3.2)*uK; gl_FragColor=vec4(uC*i,i); }` });\nconst planets=[];\nfunction planet(hex,r,pos,rim=1.3,halo=.8,parent=scene){ const g=new THREE.Group(); const m=new THREE.Mesh(new THREE.SphereGeometry(r,64,64),planetMat(hex,rim)); g.add(m);\n  const hm=new THREE.Mesh(new THREE.SphereGeometry(r*1.35,48,48),haloMat(hex,halo)); g.add(hm); g.position.copy(pos); parent.add(g); planets.push(m); g.userData={m,hm,r}; return g; }\n\n// 3. the dot: the tech studio's mint planet, with a dust ring\nconst R=3, dot=planet(MINT,R,new THREE.Vector3(),1.5,1.05);\nconst dust=new THREE.Group(); dust.rotation.set(Math.PI/2.1,0,.22); dot.add(dust);\ndust.add(cloud(SMALL?1400:3200,(v,c)=\u003e{ const a=Math.random()*Math.PI*2,r=4.4+Math.random()*1.6+Math.pow(Math.random(),4)*1.5; v.set(Math.cos(a)*r,Math.sin(a)*r,(Math.random()-.5)*.08);\n  c.set(MINT).lerp(new THREE.Color(0xffffff),Math.random()*.5).multiplyScalar(.5+Math.random()*.5); return .5+Math.random()*1.3; }, pointMat({size:.55,twinkle:.3})));\n\n// 4. the agents: three spacecraft that work for the dot, each with a beam of pulses\nfunction canvasTex(w,h,draw){ const c=document.createElement('canvas'); c.width=w; c.height=h; draw(c.getContext('2d'),w,h); const tx=new THREE.CanvasTexture(c); tx.colorSpace=THREE.SRGBColorSpace; tx.anisotropy=4; return tx; }\nconst foil=canvasTex(256,256,(g,w,h)=\u003e{ const gr=g.createLinearGradient(0,0,w,h); gr.addColorStop(0,'#b07a1c'); gr.addColorStop(.5,'#e8c060'); gr.addColorStop(1,'#9a6a18'); g.fillStyle=gr; g.fillRect(0,0,w,h);\n  for(let i=0;i\u003c520;i++){ const x=Math.random()*w,y=Math.random()*h,r=4+Math.random()*22; g.fillStyle=`rgba(${Math.random()\u003c.5?'255,240,190':'60,32,0'},${.08+Math.random()*.24})`; g.beginPath(); g.moveTo(x,y); for(let k=0;k\u003c4;k++) g.lineTo(x+(Math.random()-.5)*r*2,y+(Math.random()-.5)*r*2); g.closePath(); g.fill(); } });\nconst cells=canvasTex(512,160,(g,w,h)=\u003e{ g.fillStyle='#c9ced6'; g.fillRect(0,0,w,h); const cols=14,rows=4,gap=3,cw=(w-gap*(cols+1))/cols,ch=(h-gap*(rows+1))/rows;\n  for(let i=0;i\u003ccols;i++)for(let j=0;j\u003crows;j++){ const x=gap+i*(cw+gap),y=gap+j*(ch+gap),gr=g.createLinearGradient(x,y,x+cw,y+ch); gr.addColorStop(0,'#123b44'); gr.addColorStop(1,'#071a20'); g.fillStyle=gr; g.fillRect(x,y,cw,ch);\n    g.strokeStyle='rgba(120,230,210,.18)'; g.lineWidth=1; for(let k=1;k\u003c3;k++){ g.beginPath(); g.moveTo(x,y+ch*k/3); g.lineTo(x+cw,y+ch*k/3); g.stroke(); } } });\nconst M={ foil:new THREE.MeshStandardMaterial({map:foil,bumpMap:foil,bumpScale:2.2,metalness:1,roughness:.2,envMapIntensity:1.6}),\n  rad:new THREE.MeshStandardMaterial({color:0xd7dde4,metalness:.75,roughness:.22,envMapIntensity:1.3}), white:new THREE.MeshStandardMaterial({color:0xcfd5dc,metalness:.35,roughness:.4}),\n  steel:new THREE.MeshStandardMaterial({color:0x9aa3ad,metalness:.9,roughness:.3}), dark:new THREE.MeshStandardMaterial({color:0x22272e,metalness:.6,roughness:.5}),\n  cells:new THREE.MeshStandardMaterial({map:cells,metalness:.55,roughness:.28,envMapIntensity:1.4}), back:new THREE.MeshStandardMaterial({color:0x2a2f36,metalness:.4,roughness:.7}) };\nconst glowTex=canvasTex(64,64,(g)=\u003e{ const r=g.createRadialGradient(32,32,0,32,32,32); r.addColorStop(0,'rgba(0,244,201,1)'); r.addColorStop(1,'rgba(0,244,201,0)'); g.fillStyle=r; g.fillRect(0,0,64,64); });\nfunction spacecraft(k=1.05){ const s=new THREE.Group();\n  s.add(new THREE.Mesh(new THREE.BoxGeometry(.42*k,.5*k,.42*k),[M.rad,M.rad,M.foil,M.foil,M.foil,M.foil]));\n  for(const side of [-1,1]) for(let f=-2;f\u003c=2;f++){ const fin=new THREE.Mesh(new THREE.BoxGeometry(.006*k,.4*k,.03*k),M.steel); fin.position.set(side*.214*k,0,f*.07*k); s.add(fin); }\n  const top=new THREE.Mesh(new THREE.BoxGeometry(.44*k,.035*k,.44*k),M.white); top.position.y=.27*k; s.add(top); const bot=top.clone(); bot.position.y=-.27*k; s.add(bot);\n  const boom=new THREE.Mesh(new THREE.CylinderGeometry(.012*k,.012*k,2.5*k,8),M.steel); boom.rotation.z=Math.PI/2; s.add(boom);\n  for(const side of [-1,1]){ const wing=new THREE.Group(); wing.position.x=side*.78*k; s.add(wing);\n    const yoke=new THREE.Mesh(new THREE.BoxGeometry(.3*k,.02*k,.02*k),M.steel); yoke.position.x=side*.36*k; s.add(yoke);\n    for(let i=0;i\u003c2;i++){ const p=new THREE.Mesh(new THREE.BoxGeometry(.52*k,.012*k,.36*k),[M.back,M.back,M.cells,M.back,M.back,M.back]); p.position.x=side*(i*.55*k); wing.add(p); } }\n  const pts=[]; for(let i=0;i\u003c=16;i++){ const r=i/16*.24*k; pts.push(new THREE.Vector2(r,r*r*1.6/k)); }\n  const dish=new THREE.Mesh(new THREE.LatheGeometry(pts,40),new THREE.MeshStandardMaterial({color:0xf2f4f6,metalness:.25,roughness:.35,side:THREE.DoubleSide})); dish.rotation.x=-Math.PI/2; dish.position.z=.3*k; s.add(dish);\n  const feed=new THREE.Mesh(new THREE.ConeGeometry(.025*k,.05*k,12),M.dark); feed.rotation.x=-Math.PI/2; feed.position.z=.45*k; s.add(feed);\n  const whip=new THREE.Mesh(new THREE.CylinderGeometry(.004*k,.004*k,.42*k,6),M.steel); whip.position.set(.12*k,.48*k,-.1*k); s.add(whip);\n  const lamp=new THREE.Mesh(new THREE.SphereGeometry(.022*k,10,10),new THREE.MeshBasicMaterial({color:MINT})); lamp.position.set(-.18*k,.3*k,-.18*k); s.add(lamp); s.userData.lamp=lamp;\n  const glow=new THREE.Sprite(new THREE.SpriteMaterial({map:glowTex,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending})); glow.scale.setScalar(.2*k); lamp.add(glow);\n  return s; }\nconst beamMat=()=\u003enew THREE.ShaderMaterial({ transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,\n  uniforms:{uTime:{value:0},uA:{value:.3},uC:{value:new THREE.Color(MINT)},uOff:{value:Math.random()*10}},\n  vertexShader:`attribute float aT; varying float vT; void main(){ vT=aT; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.); }`,\n  fragmentShader:`uniform float uTime,uA,uOff; uniform vec3 uC; varying float vT; void main(){ float p=fract(vT*5.-(uTime+uOff)*.9); float a=smoothstep(0.,.15,p)*smoothstep(.45,.15,p);\n    gl_FragColor=vec4(uC,(a*.9+.08)*uA*smoothstep(0.,.08,vT)*smoothstep(1.,.85,vT)); }` });\nconst agentOrbit=new THREE.Group(); agentOrbit.rotation.set(.85,.3,-.35); dot.add(agentOrbit);\nconst sats=[], beams=[];\nfor(let i=0;i\u003c3;i++){ const s=spacecraft(); const a=i/3*Math.PI*2+.4; s.position.set(Math.cos(a)*5.8,0,Math.sin(a)*5.8); agentOrbit.add(s); sats.push(s);\n  const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(6),3)); g.setAttribute('aT',new THREE.BufferAttribute(new Float32Array([0,1]),1));\n  const b=new THREE.Line(g,beamMat()); b.frustumCulled=false; scene.add(b); beams.push(b); }\n\n// 5. five service families as worlds, each with three moons: fifteen services\nconst famSys=new THREE.Group(); famSys.position.set(0,0,0); famSys.rotation.set(.38,0,-.12); scene.add(famSys);\nconst FR=12.5, famHex=[MINT,PALE,WHITE,0x2bd3b4,0x9fc7bf];\n{ const pts=[]; for(let i=0;i\u003c=160;i++){ const a=i/160*Math.PI*2; pts.push(new THREE.Vector3(Math.cos(a)*FR,0,Math.sin(a)*FR)); }\n  const l=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts),new THREE.LineDashedMaterial({color:0x5f8c85,dashSize:.22,gapSize:.36,transparent:true,opacity:.5})); l.computeLineDistances(); famSys.add(l); }\nconst fams=famHex.map((hex,i)=\u003e{ const a=-Math.PI/2+i/5*Math.PI*2; const g=planet(hex,1.05,new THREE.Vector3(Math.cos(a)*FR,0,Math.sin(a)*FR),1.3,.75,famSys);\n  const mo=new THREE.Group(); mo.rotation.set(.9,i,.3); g.add(mo); g.userData.moons=mo;\n  for(let k=0;k\u003c3;k++){ const b=k/3*Math.PI*2; const m=new THREE.Mesh(new THREE.SphereGeometry(.2,24,24),planetMat(WHITE,1.2)); m.position.set(Math.cos(b)*1.9,0,Math.sin(b)*1.9); mo.add(m); planets.push(m); }\n  g.userData.a=a; return g; });\n\n// 6. the diagnosis scan: a thin ring that sweeps the dot, top to bottom\nconst scan=new THREE.Mesh(new THREE.TorusGeometry(1,.012,8,160),new THREE.MeshBasicMaterial({color:MINT,transparent:true,opacity:0,blending:THREE.AdditiveBlending,depthWrite:false}));\nscan.rotation.x=Math.PI/2; dot.add(scan);\n\n// 7. the four steps: beacons rising, the first already lit\nconst steps=[[-7,9,-5,.55],[-2.2,10.4,-6,.75],[3,12,-7,.95],[8.6,14,-8,1.25]].map(([x,y,z,r],i)=\u003eplanet(i===0?MINT:WHITE,r,new THREE.Vector3(x,y,z),1.4,.7));\nconst stepLine=new THREE.Line(new THREE.BufferGeometry().setFromPoints(steps.map(s=\u003es.position)),new THREE.LineDashedMaterial({color:0x5f8c85,dashSize:.25,gapSize:.3,transparent:true,opacity:0})); stepLine.computeLineDistances(); scene.add(stepLine);\n\n// 8. the record: data streams pouring into the dot, fast\nconst STREAMS=SMALL?10:18, PER=SMALL?60:110;\nconst streamMat=new THREE.ShaderMaterial({ transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,\n  uniforms:{uTime:{value:0},uPx:{value:renderer.getPixelRatio()},uA:{value:0}},\n  vertexShader:`attribute vec3 aA; attribute vec3 aB; attribute float aK; attribute float aS; uniform float uTime,uPx; varying float vF;\n    void main(){ float k=fract(aK+uTime*aS); vec3 c=mix(aA,vec3(0.),.5)+aB; vec3 p=mix(mix(aA,c,k),mix(c,vec3(0.),k),k);\n      p=normalize(p)*max(length(p),3.05); vF=smoothstep(0.,.15,k)*smoothstep(1.,.9,k);\n      vec4 mv=modelViewMatrix*vec4(p,1.); gl_Position=projectionMatrix*mv; gl_PointSize=uPx*(1.2+2.4*k)*(160./-mv.z); }`,\n  fragmentShader:`uniform float uA; varying float vF; void main(){ float d=length(gl_PointCoord-.5); float a=smoothstep(.5,0.,d); gl_FragColor=vec4(mix(vec3(.0,.96,.79),vec3(1.),a*.5),a*a*vF*uA); }` });\n{ const N=STREAMS*PER, A=new Float32Array(N*3), B=new Float32Array(N*3), K=new Float32Array(N), S=new Float32Array(N), P=new Float32Array(N*3);\n  for(let s=0;s\u003cSTREAMS;s++){ const th=Math.random()*Math.PI*2, ph=Math.acos(2*Math.random()-1), r=26+Math.random()*16;\n    const a=new THREE.Vector3(r*Math.sin(ph)*Math.cos(th),r*Math.cos(ph)*.6,r*Math.sin(ph)*Math.sin(th)), b=new THREE.Vector3().randomDirection().multiplyScalar(6+Math.random()*6), sp=.18+Math.random()*.22;\n    for(let j=0;j\u003cPER;j++){ const i=s*PER+j; a.toArray(A,i*3); b.toArray(B,i*3); K[i]=j/PER+Math.random()*.004; S[i]=sp; } }\n  const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.BufferAttribute(P,3)); g.setAttribute('aA',new THREE.BufferAttribute(A,3)); g.setAttribute('aB',new THREE.BufferAttribute(B,3));\n  g.setAttribute('aK',new THREE.BufferAttribute(K,1)); g.setAttribute('aS',new THREE.BufferAttribute(S,1));\n  const pts=new THREE.Points(g,streamMat); pts.frustumCulled=false; scene.add(pts); }\n\n// 9. regulated industries: small lights joined to the dot, a network\nconst net=new THREE.Group(); scene.add(net); const nodes=[];\n{ const lm=new THREE.LineBasicMaterial({color:0x2f6f66,transparent:true,opacity:0}); net.userData.lm=lm;\n  for(let i=0;i\u003c10;i++){ const y=1-(i+.5)/10*2, rr=Math.sqrt(1-y*y), a=i*2.399963; const p=new THREE.Vector3(Math.cos(a)*rr,y*.55,Math.sin(a)*rr).multiplyScalar(17);\n    const n=planet(i%3?WHITE:MINT,.32+(i%4)*.08,p,1.4,.9,net); nodes.push(n);\n    net.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(),p]),lm)); } }\n\n/* labels that ride the worlds, read from the page so they follow the language */\nconst tagsEl=document.getElementById('uvTags'), linesEl=document.getElementById('uvLines'), tags=[];\nfunction tag(obj,show,text){ const el=document.createElement('div'); el.className='uvt'; tagsEl.appendChild(el); const t={obj,show,text,el,vis:false,last:''}; tags.push(t); return t; }\nconst famTags=fams.map((f,i)=\u003etag(f,'services',()=\u003e{ const b=document.querySelectorAll('#tabs .tab')[i]; if(!b) return ''; const l=b.querySelector('.l'); return `\u003cb\u003e${l?l.textContent:''}\u003c/b\u003e${b.textContent.replace(l?l.textContent:'','').trim()}`; }));\nconst stepTags=steps.map((s,i)=\u003etag(s,'process',()=\u003e{ const h=document.querySelectorAll('.steps h3')[i]; return h?`\u003cb\u003e${i+1}\u003c/b\u003e${h.textContent.trim()}`:''; }));\nconst SVGNS='http://www.w3.org/2000/svg';\nconst chain=stepTags.slice(0,-1).map(()=\u003e{ const l=document.createElementNS(SVGNS,'line'); l.setAttribute('stroke','rgba(0,244,201,.35)'); l.setAttribute('stroke-width','1'); l.style.transition='opacity .5s'; l.style.opacity=0; linesEl.appendChild(l); return l; });\nfunction relabel(){ for(const t of tags){ const h=t.text(); if(h!==t.last){ t.last=h; t.el.innerHTML=h; } } }\nrelabel(); setInterval(relabel,800);\n\n/* the journey: one stop per section. p = camera, t = what it looks at, s = where on screen that point sits, o = scene strength */\nconst orb=document.querySelector('.orb');\nconst S=(id,sel,p,t,s,o)=\u003e({id,el:document.querySelector(sel),p,t,s,o});\nconst CH=[\n  S('top','#top',null,[0,0,0],null,1),\n  S('services','#services',[-10,26,52],[0,0,0],[.78,.5],.5),\n  S('fit','#fit',[9,3,15],[0,-.3,0],[.78,.76],.8),\n  S('process','#process',[1,14,12],[1.2,11.4,-6.5],[.64,.28],.85),\n  S('record','#record',[13,6,15],[0,0,0],[.82,.5],.7),\n  S('industries','#industries',[-22,14,40],[0,1,0],[.74,.76],.85),\n  S('contact','#contact',null,[0,0,0],null,1)\n].filter(c=\u003ec.el);\nif(SMALL) CH.forEach(c=\u003e{ if(c.id!=='top'\u0026\u0026c.id!=='contact') c.o*=.5; });\nconst meter=document.getElementById('uvMeter'); CH.forEach(()=\u003emeter.appendChild(document.createElement('i')));\nconst V=a=\u003enew THREE.Vector3(a[0],a[1],a[2]);\nconst camP=new THREE.Vector3(), camT=new THREE.Vector3(), goalP=new THREE.Vector3(), goalT=new THREE.Vector3(), scr=new THREE.Vector2(.5,.5);\nconst heroDir=new THREE.Vector3(-.28,.2,1).normalize();\nconst disc=document.querySelector('.contact-dot'), endDir=new THREE.Vector3(.42,.1,1).normalize();\nfunction glue(c,el,frac,dir){ if(!c) return; let sx=.72, sy=.5, px=innerHeight*.2;\n  if(el){ const r=el.getBoundingClientRect(); sx=(r.left+r.width/2)/innerWidth; sy=(r.top+r.height/2)/innerHeight; px=r.width*frac; }\n  const a=Math.atan(px*2*Math.tan(camera.fov*Math.PI/360)/innerHeight), d=R/Math.sin(a);\n  c.p=dir.clone().multiplyScalar(d).toArray(); c.s=[sx,sy]; }\nfunction heroStop(){ glue(CH[0],orb,.34,heroDir); glue(CH.find(c=\u003ec.id==='contact'),disc,.5,endDir); }\nlet active=CH[0].id, heroW=1, endW=0;\nconst ease=x=\u003ex\u003c.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2;\nconst top=el=\u003eel.getBoundingClientRect().top+scrollY;\nlet goalO=1;\nfunction scrollGoal(){ heroStop();\n  const mid=scrollY+innerHeight*.5; let i=0; CH.forEach((c,k)=\u003e{ if(top(c.el)\u003c=mid) i=k; });\n  const a=CH[i], b=CH[Math.min(i+1,CH.length-1)], s=top(a.el)+a.el.offsetHeight*.5, e=top(b.el)+b.el.offsetHeight*.5;\n  let f=e\u003es?(mid-s)/(e-s):0; if(i===0) f=(mid-s)/(e-s); f=Math.min(Math.max(f,0),1); const k=ease(f);\n  goalP.copy(V(a.p)).lerp(V(b.p),k); goalT.copy(V(a.t)).lerp(V(b.t),k); scr.set(a.s[0]+(b.s[0]-a.s[0])*k, a.s[1]+(b.s[1]-a.s[1])*k);\n  goalO=a.o+(b.o-a.o)*k; heroW=i===0?1-k:0; endW=a.id==='contact'?1:(b.id==='contact'?k:0);\n  const now=(f\u003e.5?b:a).id; if(now!==active){ active=now; hud(); } }\nfunction hud(){ const k=CH.findIndex(c=\u003ec.id===active), el=CH[k].el, h=el.querySelector('h1,h2');\n  let name=h?h.textContent.trim():''; if(name.length\u003e30) name=name.slice(0,29)+'\u2026';\n  document.getElementById('uvChap').innerHTML=`\u003cb\u003e0${k+1}\u003c/b\u003e / 0${CH.length}`+(name?` \u00b7 ${name}`:'');\n  [...meter.children].forEach((m,j)=\u003em.classList.toggle('on',j\u003c=k)); }\nlet mx=0,my=0; addEventListener('pointermove',e=\u003e{mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5},{passive:true});\nfunction resize(){ renderer.setSize(innerWidth,innerHeight,false); camera.aspect=innerWidth/innerHeight; camera.fov=innerWidth\u003cinnerHeight?60:46; camera.updateProjectionMatrix(); linesEl.setAttribute('viewBox',`0 0 ${innerWidth} ${innerHeight}`); }\naddEventListener('resize',()=\u003e{resize();scrollGoal()}); resize(); scrollGoal(); camP.copy(goalP); camT.copy(goalT); hud();\n\nconst clock=new THREE.Clock(), v=new THREE.Vector3(), sv=new THREE.Vector3(), dv=new THREE.Vector3(); let shown=true, op=1; const pres={fam:0,steps:0,net:0};\ndocument.addEventListener('visibilitychange',()=\u003e{shown=!document.hidden});\nconst fade=(m,goal,k=.06)=\u003em+(goal-m)*k;\n(function frame(){\n  requestAnimationFrame(frame); if(!shown) return;\n  scrollGoal();\n  const t=clock.getElapsedTime(), sp=RM?0:1, K=RM?1:.06;\n  camP.lerp(goalP,K); camT.lerp(goalT,K); op=fade(op,goalO,.08); canvas.style.opacity=op.toFixed(3);\n  const par=1-Math.max(heroW,endW)*.9; // keep the dot glued to the hero disc\n  camera.position.set(camP.x+mx*1.4*sp*par, camP.y-my*.9*sp*par, camP.z); camera.lookAt(camT);\n  const W=innerWidth,H=innerHeight; camera.setViewOffset(W,H,W/2-scr.x*W,H/2-scr.y*H,W,H);\n\n  galaxy.rotation.y=t*.012*sp; stars.rotation.y=t*.003*sp;\n  dot.userData.m.rotation.y=t*.08*sp; const du=dot.userData.m.material.uniforms; du.uFlat.value=endW*.55; dust.children[0].material.uniforms.uA.value=1-endW; dust.rotation.z=.22+t*.03*sp; agentOrbit.rotation.y=-t*.14*sp;\n  sats.forEach((s,i)=\u003e{ s.lookAt(0,0,0); s.userData.lamp.visible=RM||Math.sin(t*2.4+i*1.7)\u003e-.35;\n    s.getWorldPosition(sv); dv.copy(sv).setLength(R+.05); const pa=beams[i].geometry.attributes.position; pa.setXYZ(0,sv.x,sv.y,sv.z); pa.setXYZ(1,dv.x,dv.y,dv.z); pa.needsUpdate=true;\n    const u=beams[i].material.uniforms; u.uTime.value=RM?0:t; u.uA.value=fade(u.uA.value,active==='top'?.9:.3); });\n  famSys.rotation.y=t*.02*sp;\n  pres.fam=fade(pres.fam,active==='services'?1:(active==='fit'?.0:0),.07); pres.steps=fade(pres.steps,active==='process'?1:0,.07); pres.net=fade(pres.net,active==='industries'?1:0,.07);\n  famSys.visible=pres.fam\u003e.01; steps.forEach(s=\u003es.scale.setScalar(Math.max(pres.steps,.001))); stepLine.material.opacity=.6*pres.steps; net.visible=pres.net\u003e.01; nodes.forEach(n=\u003en.scale.setScalar(Math.max(pres.net,.001)));\n  famSys.children[0].material.opacity=.5*pres.fam;\n  const sel=[...document.querySelectorAll('#tabs .tab')].findIndex(b=\u003eb.getAttribute('aria-selected')==='true');\n  fams.forEach((f,i)=\u003e{ const hot=active==='services'\u0026\u0026i===sel?1:0, u=f.userData.m.material.uniforms; u.uHot.value=fade(u.uHot.value,hot,.08);\n    const sc=(1+u.uHot.value*.45)*Math.max(pres.fam,.001); f.scale.setScalar(sc); f.userData.moons.rotation.y=t*(.5+i*.07)*sp; f.rotation.y=t*.1*sp; famTags[i].el.classList.toggle('hot',!!hot); });\n  // the scan sweeps only while the visitor says where it hurts\n  const sy=Math.sin(t*.9*sp+1)*R*.96; scan.position.y=0; scan.position.z=0; scan.rotation.x=Math.PI/2;\n  scan.position.set(0,sy,0); const sr=Math.sqrt(Math.max(R*R-sy*sy,.01))+.04; scan.scale.setScalar(sr);\n  scan.material.opacity=fade(scan.material.opacity,active==='fit'?.95:0,.08);\n  steps.forEach((s,i)=\u003e{ s.position.y+=((([9,10.4,12,14][i])+Math.sin(t*.6+i*1.3)*.25*sp)-s.position.y)*.2; });\n  streamMat.uniforms.uTime.value=RM?0:t; streamMat.uniforms.uA.value=fade(streamMat.uniforms.uA.value,active==='record'?1:(active==='top'?.12:.05));\n  net.userData.lm.opacity=.5*pres.net; net.rotation.y=t*.015*sp;\n  planets.forEach(m=\u003em.material.uniforms.uTime.value=t); stars.material.uniforms.uTime.value=t;\n  renderer.render(scene,camera);\n\n  if(W\u003e=760){ for(const tg of tags){ tg.obj.getWorldPosition(v); v.project(camera);\n      const on=tg.show===active \u0026\u0026 tg.last \u0026\u0026 (tg.show!=='services'||tg.el.classList.contains('hot')) \u0026\u0026 v.z\u003c1 \u0026\u0026 Math.abs(v.x)\u003c1.02 \u0026\u0026 Math.abs(v.y)\u003c1.02;\n      tg.x=(v.x*.5+.5)*W; tg.y=(-v.y*.5+.5)*H; tg.el.style.transform=`translate(${(tg.x+16).toFixed(1)}px,${(tg.y-10).toFixed(1)}px)`;\n      if(on!==tg.vis){ tg.vis=on; tg.el.style.opacity=on?1:0; } }\n    chain.forEach((l,i)=\u003e{ const a=stepTags[i], b=stepTags[i+1]; l.setAttribute('x1',a.x); l.setAttribute('y1',a.y); l.setAttribute('x2',b.x); l.setAttribute('y2',b.y); l.style.opacity=(a.vis\u0026\u0026b.vis)?1:0; }); }\n})();\n\n/* sound: a low machine hum made in the browser, off until asked */\nconst sb=document.getElementById('uvSnd'), st=document.getElementById('uvSndT'); let ac=null, mg=null;\nsb.addEventListener('click',()=\u003e{\n  if(!ac){ ac=new (window.AudioContext||window.webkitAudioContext)(); mg=ac.createGain(); mg.gain.value=0; mg.connect(ac.destination);\n    const lp=ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=480; lp.Q.value=6; lp.connect(mg);\n    [55,82.4,110,164.8].forEach((f,i)=\u003e{ const o=ac.createOscillator(); o.type=i%2?'sawtooth':'sine'; o.frequency.value=f; o.detune.value=(i-1.5)*6; const g=ac.createGain(); g.gain.value=[.45,.1,.18,.05][i]; o.connect(g).connect(lp); o.start(); });\n    const lfo=ac.createOscillator(); lfo.frequency.value=.08; const lg=ac.createGain(); lg.gain.value=260; lfo.connect(lg).connect(lp.frequency); lfo.start(); }\n  const on=sb.getAttribute('aria-pressed')!=='true'; ac.resume(); mg.gain.setTargetAtTime(on?.07:0,ac.currentTime,.5);\n  sb.setAttribute('aria-pressed',on); st.textContent=on?'On':'Off'; document.body.classList.toggle('uv-on',on);\n});\n\u003c/script\u003e\n\n\u003c!-- dot. universe end --\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n"