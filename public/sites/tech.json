062c\u0644\", \"nav.contact\": \"\u062a\u0648\u0627\u0635\u0644\", \"nav.cta\": \"\u0627\u0628\u062f\u0623 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\", \"nav.menu\": \"\u0627\u0644\u0642\u0627\u0626\u0645\u0629\",\n  \"hero.h\": \"\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0627\u0644\u0623\u062a\u0645\u062a\u0629\u060c \u0644\u062d\u064a\u0646 \u064a\u062e\u0641\u0642 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0648\u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u062d\u0642\u064a\u0642\u064a\u064b\u0627.\",\n  \"hero.lead\": \"\u064a\u0648\u0638\u0651\u0641 dot. tech studio \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0641\u064a \u0627\u0644\u0639\u0645\u0644\u060c \u0648\u064a\u0628\u0646\u064a \u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0623\u0639\u0645\u0627\u0644\u060c \u0648\u064a\u0646\u0642\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u064a\u0635\u0644\u062d\u0647\u0627\u060c \u0648\u064a\u0646\u0642\u0630 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u062a\u0639\u062b\u0631\u0629\u060c \u0644\u0644\u0634\u0631\u0643\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629.\",\n  \"hero.lead2\": \"\u0648\u0645\u0642\u0631\u0651\u0646\u0627 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0646\u0635\u0645\u0645 \u0623\u0646\u0638\u0645\u0629 \u0623\u0639\u0645\u0627\u0644 \u0645\u062f\u0639\u0648\u0645\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0623\u062a\u0645\u062a\u0629 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0639 \u0641\u064a \u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u2014 \u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629 \u0639\u0645\u0644 \u0627\u0644\u0634\u0631\u0643\u0629\u060c \u0648\u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0628\u0631\u0645\u062c\u064a\u0627\u062a.\",\n  \"hero.new\": \"\u062c\u062f\u064a\u062f: \u0627\u0644\u062a\u0645\u0643\u064a\u0646 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a. \u0623\u0631\u0628\u0639 \u0633\u0627\u0639\u0627\u062a\u060c \u062c\u0644\u0633\u0629 \u0641\u0631\u062f\u064a\u0629\u060c \u0639\u0644\u0649 \u0639\u0645\u0644\u0643 \u0623\u0646\u062a\", \"hero.c1\": \"\u0627\u0639\u0631\u0641 \u0645\u0646 \u0623\u064a\u0646 \u062a\u0628\u062f\u0623\", \"hero.c2\": \"\u0627\u0637\u0651\u0644\u0639 \u0639\u0644\u0649 \u0627\u0644\u0633\u062c\u0644\",\n  strip: \"\u062c\u0647\u0627\u062a \u062a\u0646\u0638\u064a\u0645\u064a\u0629 \u0648\u0645\u0646\u0635\u0627\u062a \u0639\u0645\u0644\u0646\u0627 \u0645\u0639\u0647\u0627\",\n  \"svc.h\": \"\u062e\u0645\u0633 \u0639\u0627\u0626\u0644\u0627\u062a\u060c \u062e\u0645\u0633 \u0639\u0634\u0631\u0629 \u062e\u062f\u0645\u0629.\", \"svc.lead\": \"\u0627\u062e\u062a\u0631 \u0639\u0627\u0626\u0644\u0629 \u0644\u062a\u0631\u0649 \u0645\u0627 \u0646\u0628\u0646\u064a\u0647 \u0636\u0645\u0646\u0647\u0627.\", \"svc.tabsLabel\": \"\u0639\u0627\u0626\u0644\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0627\u062a\",\n  \"fit.h\": \"\u0623\u064a\u0646 \u062a\u0643\u0645\u0646 \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u061f\", \"fit.lead\": \"\u0627\u062e\u062a\u0631 \u0645\u0627 \u064a\u0634\u0628\u0647 \u0648\u0636\u0639 \u0634\u0631\u0643\u062a\u0643. \u0633\u0646\u064f\u0638\u0647\u0631 \u0644\u0643 \u0645\u0646 \u0623\u064a\u0646 \u0646\u0628\u062f\u0623\u060c \u0648\u064a\u0645\u0643\u0646\u0643 \u0625\u0631\u0633\u0627\u0644\u0647 \u0625\u0644\u064a\u0646\u0627 \u0643\u0631\u0633\u0627\u0644\u0629.\", \"fit.chipsLabel\": \"\u0627\u0644\u062d\u0627\u0644\u0627\u062a\",\n  \"pr.h\": \"\u062e\u0637\u0648\u0627\u062a \u0635\u063a\u064a\u0631\u0629 \u0645\u062f\u0641\u0648\u0639\u0629 \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646\u0647\u0627.\", \"pr.lead\": \"\u0646\u0641\u0635\u0651\u0644 \u0627\u0644\u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0633\u064a\u0631 \u0639\u0645\u0644\u0643 \u0648\u0628\u064a\u0627\u0646\u0627\u062a\u0643\u060c \u0648\u062d\u062f\u0629\u064b \u062a\u0644\u0648 \u0627\u0644\u0623\u062e\u0631\u0649.\",\n  \"pr.s1h\": \"\u0634\u0647\u0631 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\", \"pr.s1\": \"\u0634\u0647\u0631 \u0645\u062f\u0641\u0648\u0639 \u0646\u0642\u0631\u0623 \u0641\u064a\u0647 \u0623\u0646\u0638\u0645\u062a\u0643 \u0648\u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0648\u0645\u0648\u0631\u0651\u062f\u064a\u0643 \u0648\u0633\u064a\u0631 \u0639\u0645\u0644\u0643 \u0627\u0644\u064a\u0648\u0645\u064a. \u064a\u0646\u062a\u0647\u064a \u0628\u062e\u0637\u0629 \u0645\u0643\u062a\u0648\u0628\u0629 \u0644\u0640 90 \u064a\u0648\u0645\u064b\u0627 \u064a\u0648\u0642\u0651\u0639\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u0643.\",\n  \"pr.s2h\": \"\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\", \"pr.s2\": \"\u0646\u0628\u0646\u064a \u0623\u0648\u0644\u064b\u0627 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0623\u0643\u062b\u0631 \u0643\u0644\u0641\u0629 \u0639\u0644\u064a\u0643\u060c \u0648\u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u064a\u0643\u0648\u0646 \u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0639\u0631\u0648\u0636 \u0627\u0644\u0623\u0633\u0639\u0627\u0631. \u064a\u0639\u0645\u0644 \u062e\u0644\u0627\u0644 \u0623\u0633\u0627\u0628\u064a\u0639\u060c \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0623\u0646\u062a.\",\n  \"pr.s3h\": \"\u062a\u0633\u0644\u064a\u0645 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646\u0647\", \"pr.s3\": \"\u0644\u0643\u0644 \u0645\u064f\u062e\u0631\u064e\u062c \u0641\u062d\u0635 \u0645\u0643\u062a\u0648\u0628 \u064a\u062d\u0633\u0645 \u0625\u0646 \u0643\u0627\u0646 \u0642\u062f \u0627\u0643\u062a\u0645\u0644. \u0648\u062a\u0631\u062a\u0628\u0637 \u0627\u0644\u062f\u0641\u0639\u0627\u062a \u0628\u0627\u0644\u0645\u0631\u0627\u062d\u0644 \u0627\u0644\u0645\u0633\u0644\u0651\u0645\u0629.\",\n  \"pr.s4h\": \"\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0627\u0644\u062a\u0648\u0633\u0651\u0639\", \"pr.s4\": \"\u0648\u062d\u062f\u0627\u062a \u0634\u0647\u0631\u064a\u0629 \u0648\u0625\u0634\u0631\u0627\u0641 \u0645\u0633\u062a\u0645\u0631\u060c \u0645\u0639 \u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u0646 \u0627\u0644\u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0648\u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0648\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u062a.\",\n  \"pr.p1h\": \"\u0645\u0633\u062a\u0636\u0627\u0641 \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\", \"pr.p1\": \"\u0645\u0646\u0627\u0637\u0642 \u0633\u062d\u0627\u0628\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627\u060c \u0628\u0645\u0633\u062a\u0623\u062c\u0631 \u0645\u0633\u062a\u0642\u0644 \u0644\u0643\u0644 \u0639\u0645\u064a\u0644.\",\n  \"pr.p2h\": \"\u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u0644\u0643\u0643\", \"pr.p2\": \"\u0635\u062f\u0651\u0631\u0647\u0627 \u0625\u0644\u0649 Excel \u0641\u064a \u0623\u064a \u0648\u0642\u062a. \u0646\u0633\u062e \u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0643\u0644 \u0644\u064a\u0644\u0629.\",\n  \"pr.p3h\": \"\u0644\u0643\u0644 \u0631\u0642\u0645 \u0645\u0635\u062f\u0631\", \"pr.p3\": \"\u062a\u062d\u0645\u0644 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0633\u062c\u0644\u064b\u0627 \u0645\u0643\u062a\u0648\u0628\u064b\u0627 \u0628\u0645\u0635\u062f\u0631 \u0643\u0644 \u0631\u0642\u0645.\",\n  \"rec.h\": \"\u0627\u0644\u0633\u062c\u0644\u060c \u0628\u0627\u0644\u0623\u0631\u0642\u0627\u0645.\", \"rec.lead\": \"\u0627\u0644\u0639\u0645\u0644 \u0646\u0641\u0633\u0647\u060c \u0642\u0628\u0644 \u0648\u0628\u0639\u062f. \u0633\u0631\u0639\u0629\u060c \u0648\u0623\u0645\u0648\u0627\u0644 \u0645\u0643\u062a\u0634\u0641\u0629\u060c \u0648\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u062a\u064f\u0632\u0645 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0639 \u0648\u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629.\",\n  n1w: \"42 \u062b\u0627\u0646\u064a\u0629\", n1n: \"0.07 \u062b\", n1: \"\u0632\u0645\u0646 \u0639\u0631\u0636 \u0633\u0639\u0631 \u0627\u0644\u062a\u0623\u0645\u064a\u0646. \u0627\u0646\u062a\u0642\u0644\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 32 \u0645\u0646 34 \u0625\u0644\u0649 \u0627\u0644\u0623\u0648\u0644\u0649 \u0639\u0644\u0649 \u0645\u0646\u0635\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a.\",\n  n2w: \"18 \u0633\u0627\u0639\u0629\", n2n: \"16 \u062b\", n2: \"\u062a\u0642\u0631\u064a\u0631 \u0631\u0648\u0627\u062a\u0628 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 10,000 \u0645\u0648\u0638\u0641\u060c \u0645\u0637\u0627\u0628\u0642 \u062d\u062a\u0649 \u0627\u0644\u0647\u0644\u0644\u0629.\",\n  n3w: \"\u0633\u0627\u0639\u062a\u0627\u0646\", n3n: \"7 \u062b\", n3: \"\u062a\u0642\u0631\u064a\u0631 \u0643\u0634\u0641 \u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0644\u0627\u0621. \u0627\u0644\u0634\u064a\u0641\u0631\u0629 \u0627\u0644\u0645\u0639\u0627\u062f \u0628\u0646\u0627\u0624\u0647\u0627 \u062a\u0639\u0645\u0644 \u062f\u0648\u0646 \u062a\u0639\u062f\u064a\u0644 \u0645\u0646\u0630 2012.\",\n  n4w: \"\u0645\u0642\u062a\u0631\u062d \u0645\u0648\u0631\u0651\u062f \u0644\u0645\u062f\u0629 \u0634\u0647\u0631\", n4n: \"26 \u062b\", n4: \"\u0644\u062d\u0644\u0651 \u0641\u0631\u0642 \u0628\u0642\u064a\u0645\u0629 300 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0628\u064a\u0646 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0648\u0627\u0644\u0645\u0642\u0628\u0648\u0636\u0627\u062a.\",\n  n5w: \"\u0639\u0631\u0636 \u0628\u0642\u064a\u0645\u0629 8 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631\", n5n: \"\u0645\u0647\u0646\u062f\u0633 \u0648\u0627\u062d\u062f\", n5: \"\u062a\u0648\u062d\u064a\u062f \u062b\u0644\u0627\u062b \u0642\u0648\u0627\u0639\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0623\u0645\u064a\u0646 \u0642\u062f\u064a\u0645\u0629 \u0641\u064a \u0645\u062e\u0637\u0637 \u0648\u0627\u062d\u062f\u060c \u0628\u0633\u0644\u0627\u0645\u0629 \u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a.\",\n  n6w: \"\u0645\u0646 3 \u0625\u0644\u0649 6 \u0623\u0634\u0647\u0631 \u0644\u0643\u0644\u064d\u0651 \u0645\u0646\u0647\u0627\", n6n: \"\u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f\", n6: \"\u0644\u0643\u0644 \u062a\u0643\u0627\u0645\u0644\u060c \u0641\u064a \u0623\u0631\u0628\u0639\u0629 \u062a\u0643\u0627\u0645\u0644\u0627\u062a \u0645\u0624\u0633\u0633\u064a\u0629 \u0639\u062c\u0632 \u0639\u0646\u0647\u0627 \u0627\u0644\u0645\u0648\u0631\u0651\u062f.\",\n  \"rec.disc\": \"\u0645\u0646 \u0639\u0645\u0644 \u0642\u0627\u0626\u062f\u0646\u0627 \u0627\u0644\u062a\u0642\u0646\u064a \u062f\u0627\u062e\u0644 \u0634\u0631\u0643\u0627\u062a \u0633\u0639\u0648\u062f\u064a\u0629 \u0642\u0628\u0644 dot. tech studio. \u0644\u0627 \u0646\u0630\u0643\u0631 \u0627\u0633\u0645 \u0623\u064a \u0639\u0645\u064a\u0644 \u062f\u0648\u0646 \u0645\u0648\u0627\u0641\u0642\u0629 \u0645\u0643\u062a\u0648\u0628\u0629.\",\n  \"rec.more\": \"\u0627\u0642\u0631\u0623 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0633\u0628\u0639 \u0639\u0634\u0631\u0629\",\n  \"ind.h\": \"\u0645\u0628\u0646\u064a \u0644\u0644\u0639\u0645\u0644 \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u062a\u0646\u0638\u064a\u0645.\", \"ind.lead\": \"\u0642\u0637\u0627\u0639\u0627\u062a \u0644\u0644\u0631\u0642\u0645 \u0627\u0644\u062e\u0627\u0637\u0626 \u0641\u064a\u0647\u0627 \u062b\u0645\u0646\u060c \u0648\u0644\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0641\u0627\u0626\u062a \u0639\u0648\u0627\u0642\u0628.\",\n  \"ind.list\": \"\u003cli\u003e\u0627\u0644\u062a\u0623\u0645\u064a\u0646\u003c/li\u003e\u003cli\u003e\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u003c/li\u003e\u003cli\u003e\u0627\u0644\u062a\u0635\u0646\u064a\u0639 \u0648\u0625\u0646\u062a\u0631\u0646\u062a \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0635\u0646\u0627\u0639\u064a\u003c/li\u003e\u003cli\u003e\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u063a\u0630\u0627\u0621 \u0648\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0623\u063a\u0630\u064a\u0629\u003c/li\u003e\u003cli\u003e\u062a\u0648\u0631\u064a\u062f \u0627\u0644\u0636\u064a\u0627\u0641\u0629\u003c/li\u003e\u003cli\u003e\u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a\u003c/li\u003e\u003cli\u003e\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0644\u0648\u062c\u0633\u062a\u064a\u0629\u003c/li\u003e\u003cli\u003e\u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0639\u0627\u0645\u003c/li\u003e\u003cli\u003e\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u062a\u062c\u0632\u0626\u0629 \u0644\u0644\u0645\u0624\u0633\u0633\u0627\u062a\u003c/li\u003e\u003cli\u003e\u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u003c/li\u003e\",\n  \"ct.h\": \"\u0627\u0628\u062f\u0623 \u0628\u0634\u0647\u0631 \u0648\u0627\u062d\u062f.\", \"ct.p\": \"\u0634\u0647\u0631 \u062a\u0634\u062e\u064a\u0635 \u0645\u062f\u0641\u0648\u0639 \u064a\u0646\u062a\u0647\u064a \u0628\u062e\u0637\u0629 \u0645\u0643\u062a\u0648\u0628\u0629 \u0644\u0640 90 \u064a\u0648\u0645\u064b\u0627 \u062a\u0648\u0642\u0651\u0639\u0647\u0627. \u0623\u062e\u0628\u0631\u0646\u0627 \u0623\u064a\u0646 \u062a\u0643\u0645\u0646 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0648\u0633\u0646\u0631\u062f \u0644\u062a\u0631\u062a\u064a\u0628 \u0645\u062d\u0627\u062f\u062b\u0629 \u0623\u0648\u0644\u0649.\",\n  \"fm.h\": \"\u0623\u0631\u0633\u0644 \u0644\u0646\u0627 \u0631\u0633\u0627\u0644\u0629\", \"fm.name\": \"\u0627\u0633\u0645\u0643\", \"fm.company\": \"\u0627\u0644\u0634\u0631\u0643\u0629\", \"fm.email\": \"\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0639\u0645\u0644\", \"fm.phone\": \"\u0627\u0644\u0647\u0627\u062a\u0641 \u003cspan class=\\\"opt\\\"\u003e(\u0627\u062e\u062a\u064a\u0627\u0631\u064a)\u003c/span\u003e\",\n  \"fm.size\": \"\u062d\u062c\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u003cspan class=\\\"opt\\\"\u003e(\u0627\u062e\u062a\u064a\u0627\u0631\u064a)\u003c/span\u003e\",\n  \"fm.sizeOpts\": \"\u003coption value=\\\"\\\"\u003e\u0627\u062e\u062a\u0631 \u0648\u0627\u062d\u062f\u064b\u0627\u003c/option\u003e\u003coption value=\\\"lt10\\\"\u003e\u0623\u0642\u0644 \u0645\u0646 10 \u0645\u0648\u0638\u0641\u064a\u0646\u003c/option\u003e\u003coption value=\\\"10-50\\\"\u003e\u0645\u0646 10 \u0625\u0644\u0649 50 \u0645\u0648\u0638\u0641\u064b\u0627\u003c/option\u003e\u003coption value=\\\"51-100\\\"\u003e\u0645\u0646 51 \u0625\u0644\u0649 100 \u0645\u0648\u0638\u0641\u